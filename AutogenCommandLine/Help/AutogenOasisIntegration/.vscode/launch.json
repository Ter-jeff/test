{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PowerShell: Launch Main File (Development)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/Main.ps1",
      "args": [
        "-Environment",
        "Development"
      ]
    },
    {
      "name": "PowerShell: Launch Main File (Development-Autogen)",
