[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
# PowerShell-specific settings
[*.{ps1,psm1,psd1}]
indent_size = 4
end_of_line = lf

# =========================
# JSON-specific settings
# =========================
[*.json]
indent_size = 2
end_of_line = lf
