    <None Include="IGDataXML\SheetClassMapping\v8.10_ultraflex.xml" />
    <None Include="IGDataXML\SheetClassMapping\v8.20_ultraflex.xml" />
    <None Include="IGDataXML\SheetClassMapping\v8.30_ultraflex.xml" />
