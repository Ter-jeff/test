    </Compile>
    <Compile Update="IGDataXML\SheetClassMapping\IGXL.cs">
      <DependentUpon>IGXL.xsd</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="IGDataXML\IGXLSheetsVersion\IGXLSheets.xsd">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
  <ItemGroup>
