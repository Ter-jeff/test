'''        For i = 0 To UBound(glb_BCCallHIPinst_instinfo.str_Selsrm_DSSC_Bit)
'''            If glb_BCCallHIPinst_instinfo.str_Selsrm_DSSC_Bit(i) <> "" Then
'''                sTempRev = StrReverse(glb_BCCallHIPinst_instinfo.str_Selsrm_DSSC_Bit(i))
'''                ReDim sTemp(Len(sTempRev) - 1)
'''                For j = 0 To UBound(sTemp)
'''''                    sTemp(j) = Mid(sTempRev, j + 1, 1) & "(" & SelsramMapping(glb_BCCallHIPinst_instinfo.idxBlock_Selsrm_singlePatt).logic_Pin(UBound(sTemp) - j) & ")"
'''                    sTemp(j) = mid(sTempRev, j + 1, 1) & "(" & sDigSrcEqn_Ary(j) & ")"
'''                Next j
