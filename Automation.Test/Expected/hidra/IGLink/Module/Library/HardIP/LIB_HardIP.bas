Public Function ReDefineDigSrcForCharacterization(ByRef digsrc_assignment As String) As String
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    ' Dylan Edited by 20190726
    Dim i, j As Integer
    Dim StringTemp As String
    Dim StringDict() As String
    Dim StringSplit() As String
    
    Dim OriDigSrcSplit() As String
    Dim NewDigSrcSplit() As String
    
    OriDigSrcSplit = Split(digsrc_assignment, ";")
    
    If TheExec.DevChar.Setups(TheExec.DevChar.Setups.ActiveSetupName).Shmoo.Axes(tlDevCharShmooAxis_X).Parameter.type.value = "Global Spec" And _
    TheExec.DevChar.Setups(TheExec.DevChar.Setups.ActiveSetupName).Shmoo.Axes(tlDevCharShmooAxis_X).Parameter.name Like "*DigSrc*" Then
        StringTemp = TheExec.DevChar.Setups.item(TheExec.DevChar.Setups.ActiveSetupName).Shmoo.Axes(tlDevCharShmooAxis_X).InterposeFunctions.PrePoint.Arguments
    Else
        StringTemp = TheExec.DevChar.Setups.item(TheExec.DevChar.Setups.ActiveSetupName).Shmoo.Axes(tlDevCharShmooAxis_Y).InterposeFunctions.PrePoint.Arguments
    End If
    
    StringTemp = Replace(StringTemp, "[", ":")
    StringTemp = Replace(StringTemp, "]", vbNullString)
    StringSplit = Split(StringTemp, ":")
    NewDigSrcSplit = Split(StringSplit(3), ";")

      
    For i = 0 To UBound(NewDigSrcSplit)
         For j = 0 To UBound(OriDigSrcSplit)
             StringDict = Split(OriDigSrcSplit(j), "=")
             If StringDict(0) = NewDigSrcSplit(i) Then
                 StringDict(1) = "=" & StringSplit(2)
                 OriDigSrcSplit(j) = StringDict(0) & StringDict(1)
             End If
         Next j
     Next i
     
     For i = 0 To UBound(OriDigSrcSplit)
         If i = 0 Then
             digsrc_assignment = OriDigSrcSplit(i)
         Else
             digsrc_assignment = digsrc_assignment & ";" & OriDigSrcSplit(i)
         End If
     Next i
    
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "ReDefineDigSrcForCharacterization") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function


'20190710, Modified for BV pass/fail flag Merging into HardIP function: TMPS, ELB, Oscar
Public Function Update_BC_PassFail_Flag(Optional PaternStartOnly As Boolean = False)
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    Dim inst_name As String
    Dim Temp_Result As New SiteLong
    inst_name = glb_TestInstance
    
    If (inst_name Like "*BV") Then
        If PaternStartOnly Then
            Temp_Result = TheHdw.Digital.Patgen.PatternBurstPassedPerSite
            BV_Pass = BV_Pass.LogicalAnd(Temp_Result)
        Else
            Temp_Result = TheExec.Flow.LastIndividualTestResult
            Temp_Result = Temp_Result.Negate.Add(2)
            BV_Pass = BV_Pass.LogicalAnd(Temp_Result)
        End If
    End If
Exit Function
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "Update_BC_PassFail_Flag") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function
Public Function FindAvgDict(ByVal CUS_Str_MainProgram As String, ByVal ParseStringForDirectionary As String, AvgCount As Long, ref As Long, AvgDataPos() As Long, Gap As Long, blockNum As Long, Addvalue As Double, MinusValue As Double)
On Error GoTo errHandler 'Add ErrHandler 2023/05/29

Dim AvgInfo As Variant
Dim Minuspin As String
Dim RefName As String
Dim BlockName As Variant
Dim AvgName As Variant
Dim NextBlockPos As Long
Dim DictionaryPos() As String


Dim i As Long

'Ensure all name can be found without case-sensitivity
ParseStringForDirectionary = LCase(ParseStringForDirectionary)
CUS_Str_MainProgram = LCase(CUS_Str_MainProgram)

'CUS_Str_MainProgram = "Convert_Average(1,127,VDD12_PLL-0.01,adc_idref,adc_vref650&adc_vtop,ane)",(1,127,VDD12_PLL-0.01,ane_adc_idref,ane_adc_vref650,ane_adc_vtop)
AvgInfo = Split(Split(Split(CUS_Str_MainProgram, "(")(1), ")")(0), ",") 'remove "()"
AvgCount = AvgInfo(0)
Addvalue = AvgInfo(1)
Minuspin = AvgInfo(2)
If UBound(AvgInfo) < 5 Then ReDim Preserve AvgInfo(5) As String

BlockName = Split(AvgInfo(5), "&")

RefName = AvgInfo(3)
AvgName = Split(AvgInfo(4), "&")
ReDim AvgDataPos(UBound(AvgName)) As Long

MinusValue = CDbl(ProcessEvaluateDCSpec(Minuspin))

DictionaryPos = Split(ParseStringForDirectionary, ",")

If AvgInfo(5) = "" Then
    ref = FindingArrayPos(DictionaryPos, RefName)
    For i = 0 To UBound(AvgName)
        AvgDataPos(i) = FindingArrayPos(DictionaryPos, AvgName(i))
    Next i
Else
    ref = FindingArrayPos(DictionaryPos, BlockName(0) & "_" & RefName)
    For i = 0 To UBound(AvgName)
        AvgDataPos(i) = FindingArrayPos(DictionaryPos, BlockName(0) & "_" & AvgName(i))
    Next i
End If

If AvgInfo(5) = "" Or UBound(BlockName) = 0 Then
    Gap = 0
    blockNum = 1
Else
'--------------Contains multiple blocks, finding the next reference and assuming all others are in same sequence
    NextBlockPos = FindingArrayPos(DictionaryPos, BlockName(1) & "_" & RefName)
    Gap = NextBlockPos - ref
    blockNum = UBound(BlockName) + 1
End If

Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "FindAvgDict") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function FindingArrayPos(DictionaryPos As Variant, FindName As Variant) As Long
On Error GoTo errHandler 'Add ErrHandler 2023/05/29

    FindingArrayPos = Application.WorksheetFunction.Match(FindName, DictionaryPos, 0) - 1

    Exit Function
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "FindingArrayPos") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function ADC_CONVERT_AVERAGE_TestLimit(CUS_Str_MainProgram As String, ParseStringForDirectionary As String, AvgCount As Long, ref As Long, AvgDataPos() As Long, Gap As Long, blockNum As Long, OutWf_RefAverage As DSPWave, OutWf_CalcAverage As DSPWave)
On Error GoTo errHandler 'Add ErrHandler 2023/05/29

Dim DictionaryStrArr As Variant
Dim i As Long: Dim j As Long: Dim BlockCount As Long
Dim RefName As String
Dim TestNameInput As String
Dim Tname_String As String
DictionaryStrArr = Split(ParseStringForDirectionary, ",")

    For BlockCount = 0 To blockNum - 1
    
            RefName = DictionaryStrArr(ref + BlockCount * Gap)
            If AvgCount >= 2 Then
                If EnableDigitalTestLimitTTR = True Then
                    TestNameInput = Report_TName_From_Instance(CalcC, "X", left(RefName, Len(RefName) - 3), CInt(BlockCount))
                Else
                    TestNameInput = Report_TName_From_Instance(CalcC, left(RefName, Len(RefName) - 3), left(RefName, Len(RefName) - 3), CInt(BlockCount))
                End If
                TheExec.Flow.TestLimit resultVal:=OutWf_RefAverage.Element(j), ForceResults:=tlForceFlow, Tname:=TestNameInput
            End If
            
            For j = 0 To UBound(AvgDataPos) Step AvgCount
                Tname_String = DictionaryStrArr(AvgDataPos(j) + BlockCount * Gap)
                If AvgCount >= 2 Then
                        If EnableDigitalTestLimitTTR = True Then
                            TestNameInput = Report_TName_From_Instance(CalcC, "X", left(Tname_String, Len(Tname_String) - 3), CInt(BlockCount), j)
                        Else
                            TestNameInput = Report_TName_From_Instance(CalcC, left(Tname_String, Len(Tname_String) - 3), left(Tname_String, Len(Tname_String) - 3), CInt(BlockCount), j)
                        End If
                        TheExec.Flow.TestLimit resultVal:=OutWf_CalcAverage.Element(j + BlockCount * (UBound(AvgDataPos) + 1)), ForceResults:=tlForceFlow, Tname:=TestNameInput
                Else
                        If EnableDigitalTestLimitTTR = True Then
                            TestNameInput = Report_TName_From_Instance(CalcC, "X", "_ADC")
                        Else
                            TestNameInput = Report_TName_From_Instance(CalcC, Tname_String, "_ADC")
                        End If
                        TheExec.Flow.TestLimit resultVal:=OutWf_CalcAverage.Element(j + BlockCount * (UBound(AvgDataPos) + 1)), ForceResults:=tlForceFlow, Tname:=TestNameInput
                End If
            Next j
    
    
    Next BlockCount

Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "ADC_CONVERT_AVERAGE_TestLimit") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function
