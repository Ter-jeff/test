        ''''      Instance_Data.CUS_Str_MainProgram = sweepsrc:sweep1=00,10,01,11
        ''''      Instance_Data.DigSrc_FlowForLoopIntegerName = SrcCodeIndx;pcie0__rcal_tx_slice:7:0:1;pcie1__rcal_tx_slice:7:0:1
        
        ''gg20221109-------------------------------------------------------
        If s_CUS_Str_MainProgram Like LCase("*sweepsrc*") Or s_DigSrc_FlowForLoopIntegerName Like LCase("*SrcCodeIndx*") Then
