Public Function Select_MeasPin(src_string As String, job As String) As String
On Error GoTo errHandler 'Add ErrHandler 2023/05/29

    Dim src_str_array() As String

    If job = "" Then job = "CP"
    
    If Not (((UCase(src_string) Like "*CP*") Or (UCase(src_string) Like "*FT*"))) Then Select_MeasPin = src_string
        
    If (UCase(job) Like "*#*") Then job = mid(job, 1, Len(job) - 1)
    
    src_str_array = Split(src_string, ";")
    
    Dim var As Variant
    
    For Each var In src_str_array
        If (UCase(var) Like "*" & UCase(job) & "*") Then
            
            Select_MeasPin = Split(var, "=")(1)
            Exit For
            
        End If
    Next var

