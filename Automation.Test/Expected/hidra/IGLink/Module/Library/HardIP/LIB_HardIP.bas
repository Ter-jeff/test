'''''                DigSrc_Equation_Print = vbCrLf & Print_NewFormat(DigSrcEquation_Split(i)) & vbCrLf ''''''''''process new format for printing
                DigSrc_Assignment_Print = Print_NewFormat(digsrc_assignment)

