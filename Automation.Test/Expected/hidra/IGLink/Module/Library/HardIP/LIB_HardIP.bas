                Count = Count & "," & LCase(USsheet(i))
           End If
        End If
    Next i
'
    Dim Reg_Assign_array() As String
        Reg_Assign_array = Split(Count, ",")
        
'    ReDim Reg_Assign_array(count - 1)
'    For k = 0 To UBound(Reg_Assign_array)
'        For i = 0 To UBound(USsheet)
'            If LCase(USsheet(i)) Like "reg_assign*" Then
'               Reg_Assign_array(k) = LCase(USsheet(i))
'             End If
'        Next i
'    Next k
    
    For i = 0 To UBound(Reg_Assign_array)
        Temp_Regname = Reg_Assign_array(i)
    
        If IsRegAssignSheetExist(MaxRow, maxcol, Temp_Regname) = True Then
        
            RegAssignArr() = Worksheets(Temp_Regname).range(Cells(1, 1), Cells(MaxRow, maxcol + 1)).value  'Add Maxcol +1 for measstore name bug
           ' RegDict.RemoveAll
            
        For StartCol = 1 To maxcol
        
            Select Case LCase(RegAssignArr(1, StartCol))
        
            Case "digsrc_assignment"                            ' Done

                Call ProcessAssignment(RegAssignArr(), StartCol, MaxRow, maxcol, "=", ";", "assignment")
                
            Case "digsrc_equation"                              ' Done

                Call ProcessAssignment(RegAssignArr(), StartCol, MaxRow, maxcol, vbNullString, "+", "equation")
                
            Case "digsrc_flowforloopintegername"                              ' Done

                Call ProcessAssignmentSrccode(RegAssignArr(), StartCol, MaxRow, maxcol, ";", "|", "flowforloopinteger")
                
            Case "cus_str_digcapdata"                           ' Done

                Call ProcessAssignment(RegAssignArr(), StartCol, MaxRow, maxcol, ":", ",", "digcapdata")
                
            Case "calc_eqn"                                     ' Done

                Call ProcessAssignment(RegAssignArr(), StartCol, MaxRow, maxcol, ":", ";", "calc_eqn")
                
            Case "measv_pins"

                Call ProcessAssignment(RegAssignArr, StartCol, MaxRow, maxcol, vbNullString, "+", "measv_pins", True)
                
            Case "measi_pins"

                Call ProcessAssignment(RegAssignArr, StartCol, MaxRow, maxcol, "", "+", "measi_pins", True)
           
            Case "measf_pins_singleend"

                Call ProcessAssignment(RegAssignArr, StartCol, MaxRow, maxcol, "", "+", "measf_pins_singleend", True)
                
            Case "interpose_premeas"

                Call ProcessAssignment(RegAssignArr, StartCol, MaxRow, maxcol, "", "|", "interpose_premeas", True)
            
            Case "meas_storename"

                Call ProcessAssignment(RegAssignArr, StartCol, MaxRow, maxcol, vbNullString, "+", "meas_storename", True)
                
            Case "sweep"
                
                Call ProcessSweepAssignment(RegAssignArr(), StartCol, MaxRow, maxcol, vbNullString, ";", "sweep")
                
            Case "cus_str_mainprogram"
                
                Call ProcessAssignment(RegAssignArr(), StartCol, MaxRow, maxcol, vbNullString, ",", "cus_str_mainprogram")
                                
            Case "hip_efuse_write"

                Call ProcessAssignment_Fuse(RegAssignArr(), StartCol, MaxRow, maxcol, vbNullString, "+", "m_catename")
                
            Case "hip_efuse_read"

                Call ProcessAssignment_Fuse(RegAssignArr(), StartCol, MaxRow, maxcol, vbNullString, "+", "m_catename")
                                
            Case Else
                'Do nothing --20230531
            End Select
        Next StartCol

    Else

        TheExec.Datalog.WriteComment "There is no 'Reg_Assign' Sheet in this workbook"

    End If
    
    Next i
    
    
    Exit Function
