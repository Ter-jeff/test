                .ForceI pc_Def_PPMU_InitialValue_FI, pc_Def_PPMU_Max_InitialValue_FI_Range
                .ForceV CDbl(MeasI.Setup_ByTypeByPin.PPMU(i).ForceValue1), CDbl(MeasI.Setup_ByTypeByPin.PPMU(i).Meas_Range)
                .Connect
