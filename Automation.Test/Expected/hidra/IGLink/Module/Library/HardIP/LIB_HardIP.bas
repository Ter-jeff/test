'---------------------------------------UFP_Corr fix 20200413
Public Function HardIP_SetupAndMeasureVolt_UVS256HP(ByRef MeasureVolt As PinListData) As Long
On Error GoTo errHandler 'Add ErrHandler 2023/05/29


    Dim MeasV As Meas_Type
    Dim i As Long
    Dim VoltRangeList() As Double
    Dim CurrentRangeList() As Double
    Dim Pins() As String
    Dim Pin_Cnt As Long
    Dim Vsitevaluetmp As New SiteDouble

    MeasV = TestConditionSeqData(Instance_Data.TestSeqNum).MeasV(Instance_Data.TestSeqSweepNum)
    
    ' New Function for same measV conditon function -- Neil,20221025
    If EnableAnalogMuxOutTTR = True Then
        If TestConditionSeqData(Instance_Data.TestSeqNum).StoreCondition = True Then
            Call HardIP_DCVS_MV_StoreAndRestoreCondition(MeasV, UVS256HP, True)
        End If
    Else
        Call HardIP_DCVS_MV_StoreAndRestoreCondition(MeasV, UVS256HP, True)
    End If
   
    If EnableAnalogMuxOutTTR = True Then
        If TestConditionSeqData(Instance_Data.TestSeqNum).StoreCondition = True Then
            If MeasV.Setup_ByTypeByPin_Flag = False Then
                If CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1) > 0 Then
                    Vsitevaluetmp = 1 + 0.5
                Else
                    Vsitevaluetmp = -1 - 0.5
                End If
                
                With TheHdw.DCVS.Pins(MeasV.Pins.UVS256HP)
                    If (CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1) = 0) And .Gate <> True Then
                        .Disconnect
                        If TheExec.Flow.enableWord("CurrentProfile") = False And TheExec.Flow.enableWord("VoltageProfile") = False And Profile_byflow = False Then
                            .Reset
                        End If
                        '---------------------------------------UFP_Corr fix 20200413
                        .VoltageRange.value = VoltageRange_Select(CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1))
                        '---------------------------------------UFP_Corr fix 20200413
                        .mode = tlDCVSModeHighImpedance
                        .Meter.mode = tlDCVSMeterVoltage		'T-Est TTR approve by Si -- 230502
                        '.Alarm(tlDCVSAlarmOpenKelvinDUT) = tlAlarmOff			'Fix Open Kelvin Alarm issue @Neil,20221025
                        .Gate = True
                        .Connect
                    Else

                        '---------------------------------------UFP_Corr fix 20200413
                        .VoltageRange.value = VoltageRange_Select(CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1))
                        '---------------------------------------UFP_Corr fix 20200413
                        .Voltage.ValuePerSite = Vsitevaluetmp
                        .CurrentRange.value = Abs(CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1))
                        .CurrentLimit.Source.FoldLimit.level.value = Abs(CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1))
                        .CurrentLimit.Sink.FoldLimit.level.value = Abs(CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1))
                        '.Meter.mode = tlDCVSMeterVoltage		'T-Est TTR approve by Si -- 230502
                        .Gate = True
                        If .Connected = 0 Then
                            .Connect
                        End If
                        '---------------------------------------UFP_Corr fix 20200413
                        .mode = tlDCVSModeCurrent
                        '---------------------------------------UFP_Corr fix 20200413
                    End If
                End With
        
                If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
                    If (CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1) = 0) Then
                        TheExec.Datalog.WriteComment (glb_TestInstance & " =====> " & MeasV.Pins.UVS256HP & " = High impedance mode  ")
                    Else
                        TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas Force Current value, " & MeasV.Pins.UVS256HP & " =" & MeasV.Setup_ByType.UVS256HP.ForceValue1)
                        TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas UVS256HP WaitTime, " & MeasV.Pins.UVS256HP & " =" & MeasV.WaitTime.UVS256HP)
                    End If
					'For DCVS voltage range setup on UFP --20230901
                    If glb_TesterType = "UltraFLEXplus" Then TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas Voltage Range value, " & MeasV.Pins.UVS256HP & " =" & TheHdw.DCVS.Pins(MeasV.Pins.UVS256HP).VoltageRange.value)
                End If
            Else
                For i = 0 To UBound(MeasV.Setup_ByTypeByPin.UVS256HP)
                    If CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1) > 0 Then
                        Vsitevaluetmp = 1 + 0.5
                    Else
                        Vsitevaluetmp = -1 - 0.5
                    End If
                    
                    With TheHdw.DCVS.Pins(MeasV.Setup_ByTypeByPin.UVS256HP(i).pin)
                        '---------------------------------------UFP_Corr fix 20200413
                        .VoltageRange.value = VoltageRange_Select(CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1))
                        '---------------------------------------UFP_Corr fix 20200413
                        If (CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1) = 0) And .Gate <> True Then
                            .Disconnect
                            .mode = tlDCVSModeHighImpedance
                            '.Meter.mode = tlDCVSMeterVoltage		'T-Est TTR approve by Si -- 230502
                            .Alarm(tlDCVSAlarmOpenKelvinDUT) = tlAlarmOff		'Fix Open Kelvin Alarm issue @Neil 20221025
                            .Gate = True
                            .Connect
                        Else
                            
''                            If CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1) > 0 Then
''                                .Voltage.ValuePerSite = Vsitevaluetmp
''                            Else
''                                '---------------------------------------UFP_Corr fix 20200413
''                                .VoltageRange.value = 5.5
''                                '---------------------------------------UFP_Corr fix 20200413
''                                .Voltage.ValuePerSite = Vsitevaluetmp
''                            End If

                            .Voltage.ValuePerSite = Vsitevaluetmp
                            .CurrentRange.value = Abs(CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1))
                            .CurrentLimit.Source.FoldLimit.level.value = Abs(CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1))
                            .CurrentLimit.Sink.FoldLimit.level.value = Abs(CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1))
                            .Meter.mode = tlDCVSMeterVoltage
                            .Gate = True
                            .Connect
                            '---------------------------------------UFP_Corr fix 20200413
                            .mode = tlDCVSModeCurrent
                            '---------------------------------------UFP_Corr fix 20200413
                        End If
                    End With
        
                    If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
                        If (CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1) = 0) Then
                            TheExec.Datalog.WriteComment (glb_TestInstance & " =====> " & MeasV.Setup_ByTypeByPin.UVS256HP(i).pin & " = High impedance mode  ")
                        Else
                            TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas Force Current value, " & MeasV.Setup_ByTypeByPin.UVS256HP(i).pin & " =" & MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1)
                            TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas UVS256HP WaitTime, " & MeasV.Setup_ByTypeByPin.UVS256HP(i).pin & " =" & MeasV.WaitTime.UVS256HP)
                        End If
						'For DCVS voltage range setup on UFP --20230901
                        If glb_TesterType = "UltraFLEXplus" Then TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas Voltage Range value, " & MeasV.Setup_ByTypeByPin.UVS256HP(i).pin & " =" & TheHdw.DCVS.Pins(MeasV.Setup_ByTypeByPin.UVS256HP(i).pin).VoltageRange.value)
                    End If
                Next i
            End If
        End If
    Else
        If MeasV.Setup_ByTypeByPin_Flag = False Then
            If CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1) > 0 Then
                Vsitevaluetmp = 1 + 0.5
            Else
                Vsitevaluetmp = -1 - 0.5
            End If
            
            With TheHdw.DCVS.Pins(MeasV.Pins.UVS256HP)
                    If (CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1) = 0) And .Gate <> True Then
                    .Disconnect
                    If TheExec.Flow.enableWord("CurrentProfile") = False And TheExec.Flow.enableWord("VoltageProfile") = False And Profile_byflow = False Then
                        .Reset
                    End If
                    '---------------------------------------UFP_Corr fix 20200413
                    .VoltageRange.value = VoltageRange_Select(CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1))
                    '---------------------------------------UFP_Corr fix 20200413
                    .mode = tlDCVSModeHighImpedance
                    '.Meter.mode = tlDCVSMeterVoltage				'T-Est TTR approve by Si -- 230502
                    .Alarm(tlDCVSAlarmOpenKelvinDUT) = tlAlarmOff		'Fix Open Kelvin Alarm issue @Neil 20221025
                    .Gate = True
                    .Connect
                Else
                    '---------------------------------------UFP_Corr fix 20200413
                    .VoltageRange.value = VoltageRange_Select(CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1))
                    '---------------------------------------UFP_Corr fix 20200413
                    .Voltage.ValuePerSite = Vsitevaluetmp
                    .CurrentRange.value = Abs(CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1))
                    .CurrentLimit.Source.FoldLimit.level.value = Abs(CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1))
                    .CurrentLimit.Sink.FoldLimit.level.value = Abs(CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1))
                    '.Meter.mode = tlDCVSMeterVoltage			'T-Est TTR approve by Si -- 230502
                    .Gate = True
                    .Connect
                    '---------------------------------------UFP_Corr fix 20200413
                    .mode = tlDCVSModeCurrent
                    '---------------------------------------UFP_Corr fix 20200413
                End If
            End With
            
            If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
                If (CDbl(MeasV.Setup_ByType.UVS256HP.ForceValue1) = 0) Then
                     TheExec.Datalog.WriteComment (glb_TestInstance & " =====> " & MeasV.Pins.UVS256HP & " = High impedance mode  ")
                Else
                    TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas Force Current value, " & MeasV.Pins.UVS256HP & " =" & MeasV.Setup_ByType.UVS256HP.ForceValue1)
                    TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas UVS256HP WaitTime, " & MeasV.Pins.UVS256HP & " =" & MeasV.WaitTime.UVS256HP)
                End If
				'For DCVS voltage range setup on UFP --20230901
                If glb_TesterType = "UltraFLEXplus" Then TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas Voltage Range value, " & MeasV.Pins.UVS256HP & " =" & TheHdw.DCVS.Pins(MeasV.Pins.UVS256HP).VoltageRange.value)
            End If
        Else
            For i = 0 To UBound(MeasV.Setup_ByTypeByPin.UVS256HP)
                If CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1) > 0 Then
                    Vsitevaluetmp = 1 + 0.5
                Else
                    Vsitevaluetmp = -1 - 0.5
                End If
                With TheHdw.DCVS.Pins(MeasV.Setup_ByTypeByPin.UVS256HP(i).pin)
                    '---------------------------------------UFP_Corr fix 20200413
                    .VoltageRange.value = VoltageRange_Select(CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1))
                    '---------------------------------------UFP_Corr fix 20200413
                    If (CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1) = 0) And .Gate <> True Then
                        .Disconnect
                        .mode = tlDCVSModeHighImpedance
                        '.Meter.mode = tlDCVSMeterVoltage				'T-Est TTR approve by Si -- 230502
                        .Alarm(tlDCVSAlarmOpenKelvinDUT) = tlAlarmOff			'Fix Open Kelvin Alarm issue @Neil 20221025
                        .Gate = True
                        .Connect
                    Else
                        .Voltage.ValuePerSite = Vsitevaluetmp
                        .CurrentRange.value = Abs(CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1))
                        .CurrentLimit.Source.FoldLimit.level.value = Abs(CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1))
                        .CurrentLimit.Sink.FoldLimit.level.value = Abs(CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1))
                        '.Meter.mode = tlDCVSMeterVoltage			'T-Est TTR approve by Si -- 230502
                        .Gate = True
                        .Connect
                        '---------------------------------------UFP_Corr fix 20200413
                        .mode = tlDCVSModeCurrent
                        '---------------------------------------UFP_Corr fix 20200413
                    End If
                End With
                
                If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
                    If (CDbl(MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1) = 0) Then
                         TheExec.Datalog.WriteComment (glb_TestInstance & " =====> " & MeasV.Setup_ByTypeByPin.UVS256HP(i).pin & " = High impedance mode  ")
                    Else
                        TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas Force Current value, " & MeasV.Setup_ByTypeByPin.UVS256HP(i).pin & " =" & MeasV.Setup_ByTypeByPin.UVS256HP(i).ForceValue1)
                        TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas UVS256HP WaitTime, " & MeasV.Setup_ByTypeByPin.UVS256HP(i).pin & " =" & MeasV.WaitTime.UVS256HP)
                    End If
                    'For DCVS voltage range setup on UFP --20230901
					If glb_TesterType = "UltraFLEXplus" Then TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas Voltage Range value, " & MeasV.Setup_ByTypeByPin.UVS256HP(i).pin & " =" & TheHdw.DCVS.Pins(MeasV.Setup_ByTypeByPin.UVS256HP(i).pin).VoltageRange.value)
                End If
            Next i
        End If
    End If

    If Not gl_Disable_HIP_debug_log Then: TheExec.Datalog.WriteComment "UVS256HP_MeasV_Wait_Time" & ":" & MeasV.WaitTime.UVS256HP
	TheHdw.DCVS.Pins(MeasV.Pins.UVS256HP).Meter.mode = tlDCVSMeterVoltage   'T-Est TTR approve by Si -- 230502    
	TheHdw.Wait CDbl(MeasV.WaitTime.UVS256HP)
    If TheExec.Flow.enableWord("CurrentProfile") = False And TheExec.Flow.enableWord("VoltageProfile") = False And Profile_byflow = False Then
        MeasureVolt = TheHdw.DCVS.Pins(MeasV.Pins.UVS256HP).Meter.Read(tlStrobe, pc_Def_UVS256HP_ReadPoint)
    Else
        Dim p As Variant
        Dim Dummy_Value As New SiteDouble: Dummy_Value = 0.0001
        For Each p In Split(MeasV.Pins.UVS256HP, ",")
            TheExec.DataManager.DecomposePinList p, Pins, Pin_Cnt
            For i = 0 To Pin_Cnt - 1
                MeasureVolt.AddPin Pins(i)
                MeasureVolt.Pins(Pins(i)) = Dummy_Value
            Next i
        Next p
    End If
    If gl_Disable_HIP_debug_log = False Then Call ForceVal_Compare(MeasV, MeasV.Pins.UVS256HP, "V", "DCVS")
    
    ''' Update 256HP measV EnableAnalogMuxOutTTR for Donan @Neil 230907
    If EnableAnalogMuxOutTTR = True Then
        If TestConditionSeqData(Instance_Data.TestSeqNum).RestoreCondition = True Then      ' New Function for same measV conditon function -- Neil,20220110
            Call HardIP_DCVS_MV_StoreAndRestoreCondition(MeasV, UVS256HP, False)
        End If
    Else
        Call HardIP_DCVS_MV_StoreAndRestoreCondition(MeasV, UVS256HP, False)
    End If
    
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_SetupAndMeasureVolt_UVS256HP") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function
