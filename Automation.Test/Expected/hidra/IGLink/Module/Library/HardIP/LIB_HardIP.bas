                ElseIf Instance_Data.InstSpecialSetting = PPMU_200uA_Force_I_Range Then
                    TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Force I range setting, " & MeasV.Setup_ByTypeByPin.PPMU(i).pin & " =" & "0.0002")
                ElseIf Instance_Data.InstSpecialSetting = PPMU_20uA_Force_I_Range Then
                    TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Force I range setting, " & MeasV.Setup_ByTypeByPin.PPMU(i).pin & " =" & "0.00002")
                ElseIf Instance_Data.InstSpecialSetting = EUSB_T10T11_Split_Force_I_Range Then
                    '''Updte for Crete @William
                  If CDbl(MeasV.Setup_ByTypeByPin.PPMU(i).ForceValue1) = 0.000000001 Then TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Force I range setting, " & MeasV.Setup_ByTypeByPin.PPMU(i).pin & " =" & "0.0002")
                  If CDbl(MeasV.Setup_ByTypeByPin.PPMU(i).ForceValue1) <> 0 And CDbl(MeasV.Setup_ByTypeByPin.PPMU(i).ForceValue1) <> 0.000000001 Then TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Force I range setting, " & MeasV.Setup_ByTypeByPin.PPMU(i).pin & " =" & "0.05")
                Else
                    TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Force I range setting, " & MeasV.Setup_ByTypeByPin.PPMU(i).pin & " =" & CurrentRange)
                End If
            End If
        Next i
    End If
    
    TheHdw.Wait CDbl(MeasV.WaitTime.PPMU)
    DebugPrintFunc_PPMU CStr(MeasV.Pins.PPMU)
    MeasureVolt = TheHdw.PPMU.Pins(MeasV.Pins.PPMU).Read(tlPPMUReadMeasurements, pc_Def_PPMU_ReadPoint)

    If gl_Disable_HIP_debug_log = False Then Call ForceVal_Compare(MeasV, MeasV.Pins.PPMU, "V", "PPMU") ''Carter, 20190507
    If Instance_Data.InstSpecialSetting = DigitalConnectPPMU Then
        TheHdw.Digital.Pins(MeasV.Pins.PPMU).Disconnect
        TheHdw.PPMU.AllowPPMUFuncRelayConnection False, False
    End If
    
    With TheHdw.PPMU.Pins(MeasV.Pins.PPMU)
        .ForceV pc_Def_PPMU_InitialValue_FV, pc_Def_PPMU_Max_InitialValue_FI_Range
        .Disconnect
        .Gate = tlOff
    End With
    
    If Instance_Data.InstSpecialSetting = InstrumentSpecialSetup.HighAccuracyVoltageHiz Or Instance_Data.InstSpecialSetting = InstrumentSpecialSetup.HighAccuracyVoltage Then
        '''''UFP_Corr
        If glb_TesterType = "UltraFLEXplus" Then TheHdw.PPMU.HighAccuracyMeasureVoltage.Enabled = False
    End If
    
    'If Instance_Data.InstSpecialSetting = DigitalConnectPPMU Then
        'thehdw.Digital.Pins(MeasV.Pins.PPMU).Disconnect
    '    thehdw.PPMU.AllowPPMUFuncRelayConnection False, False
    'Else
    TheHdw.Wait (0.1 * ms)
    TheHdw.Digital.Pins(MeasV.Pins.PPMU).Connect
    'End If
    
    Dim pin As Variant
    Dim GetRakVal_PinList As New PinListData
    Dim DiffVolt_Pinlist As New PinListData
    If Instance_Data.RAK_Flag = R_TraceOnly Then
        For Each pin In MeasureVolt.Pins
            GetRakVal_PinList.AddPin (CStr(pin))
            DiffVolt_Pinlist.AddPin (CStr(pin))
            GetRakVal_PinList.Pins(pin) = CurrentJob_Card_RAK.Pins(pin)
            If MeasV.Setup_ByTypeByPin_Flag = False Then
                DiffVolt_Pinlist.Pins(pin) = GetRakVal_PinList.Pins(pin).Multiply(CDbl(MeasV.Setup_ByType.PPMU.ForceValue1))
            Else
                DiffVolt_Pinlist.Pins(pin) = GetRakVal_PinList.Pins(pin).Multiply(CDbl(MeasV.ForceValueDic_HWCom(UCase(pin))))
            End If
            
            If gl_Disable_HIP_debug_log = False Then
                For Each site In TheExec.sites
                     TheExec.Datalog.WriteComment "Site[" & site & "]," & pin & " Voltage = " & MeasureVolt.Pins(pin).value(site) & ", RAK val = " & GetRakVal_PinList.Pins(pin).value(site)
                Next site
            End If
            
        Next pin
        MeasureVolt = MeasureVolt.Math.Subtract(DiffVolt_Pinlist)
        
    ElseIf Instance_Data.RAK_Flag = R_PathWithContact Then
        For Each pin In MeasureVolt.Pins
            GetRakVal_PinList.AddPin (CStr(pin))
            DiffVolt_Pinlist.AddPin (CStr(pin))
            GetRakVal_PinList.Pins(pin) = R_Path_PLD.Pins(pin)
            If MeasV.Setup_ByTypeByPin_Flag = False Then
                DiffVolt_Pinlist.Pins(pin) = GetRakVal_PinList.Pins(pin).Multiply(CDbl(MeasV.Setup_ByType.PPMU.ForceValue1))
            Else
                DiffVolt_Pinlist.Pins(pin) = GetRakVal_PinList.Pins(pin).Multiply(CDbl(MeasV.ForceValueDic_HWCom(UCase(pin))))
            End If
            
            If gl_Disable_HIP_debug_log = False Then
                For Each site In TheExec.sites
                     TheExec.Datalog.WriteComment "Site[" & site & "]," & pin & " Voltage = " & MeasureVolt.Pins(pin).value(site) & ", R_Path val = " & GetRakVal_PinList.Pins(pin).value(site)
                Next site
            End If
        Next pin
        MeasureVolt = MeasureVolt.Math.Subtract(DiffVolt_Pinlist)
    ElseIf InStr(UCase(Instance_Data.CUS_Str_MainProgram), UCase("RREF_RAK_CALC")) <> 0 Then
        Call CUS_RREF_Rak_Calc(MeasureVolt)
    Else
        'Do nothing -- 20230531
    End If

    Dim ForceValByPin() As String
    ForceValByPin = Split(MeasV.Setup_ByType.PPMU.ForceValue1, ",")
    Select Case Instance_Data.SpecialCalcValSetting
        Case CalculateMethodSetup.VIR_DDIO:
            Call CUS_DDR_Emulate_Const_Res_Loading(MeasureVolt, ForceValByPin(), Instance_Data.CUS_Str_MainProgram, CInt(Instance_Data.TestSeqNum), Instance_Data.RAK_Flag)
        Case Else:
            'Do nothing -- 20230531
    End Select
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_SetupAndMeasureVolt_PPMU") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function HardIP_SetupAndMeasureCurrent_UVI80(sampleSize As Long, ByRef measureCurrent As PinListData)
On Error GoTo errHandler 'Add ErrHandler 2023/05/29

    Dim i As Integer
    Dim WaitTime As Double
    Dim MaxWaitTime As Double
    Dim Pins() As String
    Dim Pin_Cnt As Long
    Dim PinType As String
    Dim Factor As Long
    Dim Irange As Double
    
    Dim MeasI As Meas_Type
    MeasI = TestConditionSeqData(Instance_Data.TestSeqNum).MeasI(Instance_Data.TestSeqSweepNum)
    
    Call HardIP_DCVI_MI_StoreAndRestoreCondition(MeasI, UVI80, True)
    ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
    Dim pin As Variant
    Pins = Split(MeasI.Pins.UVI80, ",")
    For Each pin In Pins
        'Fixing get channel type don't support "PinA,PinB", Report from C-Chop,20200423, Oscar
        If TheHdw.DCVI.Pins(MeasI.Pins.UVI80).Gate = True Then
            If MeasI.ForceValueDic_HWCom.Exists(pin) Then
                MeasI.ForceValueDic_HWCom.Remove (pin)
            End If
            MeasI.ForceValueDic_HWCom.Add pin, CStr(FormatNumber(TheHdw.DCVI.Pins(pin).Voltage, 3))
        End If
    Next pin
    ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
    If MeasI.Setup_ByTypeByPin_Flag = False Then
        With TheHdw.DCVI.Pins(MeasI.Pins.UVI80)
            If sweep_power_val_per_loop_count <> "" Then
                'do not gate off
            ElseIf TheHdw.DCVI.Pins(MeasI.Pins.UVI80).Gate = False Then
                .Gate = False
                .mode = tlDCVIModeVoltage
                .Voltage = CDbl(MeasI.Setup_ByType.UVI80.ForceValue1)
            Else
                'Power Pin Flag, From Sicily,20200423, Oscar
                MeasI.Setup_ByType.UVI80.UVI80_POWER_Flag = True
            End If
            .VoltageRange.Autorange = True
            .CurrentRange.Autorange = True
            .Current = pc_Def_UVI80_Init_MeasCurrRange
            'Init Current set to 2A, From Sicily,20200423, Oscar
            .Connect tlDCVIConnectDefault
            If .Gate = False Then                   '-+
                ''' Disable for avoid measureI Mode alarm @Willam 210727
                '.Gate(tlDCVIGateHiZ) = False        ' +---Added by Kaino on 2019/09/02 for Mode alarm
                'Gate On only when Gate off, From Sicily, 20200423, Oscar
                .Gate = True
            End If                                  '-+
            
        End With
        
        TheHdw.Wait 0.001
        
        With TheHdw.DCVI.Pins(MeasI.Pins.UVI80)
            '.Meter.mode = tlDCVIMeterCurrent   'T-Est TTR approve by Si -- 230502
            .SetCurrentAndRange CDbl(MeasI.Setup_ByType.UVI80.Meas_Range), CDbl(MeasI.Setup_ByType.UVI80.Meas_Range)
            '.Meter.CurrentRange.Value = CDbl(MeasI.Setup_ByType.UVI80.Meas_Range)
            .CurrentRange.Autorange = True
        End With
        
        If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
            If sweep_power_val_per_loop_count <> "" Then
                MeasI.Setup_ByType.UVI80.ForceValue1 = sweep_power_val_per_loop_count
                'Fixing get channel type don't support "PinA,PinB", Report from C-Chop,20200423, Oscar
                If MeasI.Setup_ByType.UVI80.UVI80_POWER_Flag = False Then
                    TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Force Volt value, " & MeasI.Pins.UVI80 & " =" & MeasI.Setup_ByType.UVI80.ForceValue1)
                Else
                    'TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Force Volt value, " & MeasI.Pins.UVI80 & " =" & FormatNumber(thehdw.DCVI.Pins(MeasI.Pins.UVI80).Voltage, 3))
                End If
                'TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Force Volt value, " & MeasI.Pins.UVI80 & " =" & MeasI.Setup_ByType.UVI80.ForceValue1)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range, " & MeasI.Pins.UVI80 & " = " & MeasI.Setup_ByType.UVI80.Meas_Range)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I WaitTime, " & MeasI.Pins.UVI80 & " =" & MeasI.WaitTime.UVI80)
            Else
                'Fixing get channel type don't support "PinA,PinB", Report from C-Chop,20200423, Oscar
                If MeasI.Setup_ByType.UVI80.UVI80_POWER_Flag = False Then
                    TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Force Volt value, " & MeasI.Pins.UVI80 & " =" & MeasI.Setup_ByType.UVI80.ForceValue1)
                Else
                    'TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Force Volt value, " & MeasI.Pins.UVI80 & " =" & FormatNumber(thehdw.DCVI.Pins(MeasI.Pins.UVI80).Voltage, 3))
                End If
                'TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Force Volt value, " & MeasI.Pins.UVI80 & " =" & MeasI.Setup_ByType.UVI80.ForceValue1)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range, " & MeasI.Pins.UVI80 & " = " & MeasI.Setup_ByType.UVI80.Meas_Range)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I WaitTime, " & MeasI.Pins.UVI80 & " =" & MeasI.WaitTime.UVI80)
            End If
                
        End If
    Else
        For i = 0 To UBound(MeasI.Setup_ByTypeByPin.UVI80)
            
            With TheHdw.DCVI.Pins(MeasI.Setup_ByTypeByPin.UVI80(i).pin)
                If sweep_power_val_per_loop_count <> "" Then
                    'do not gate off
                ElseIf UCase(TheExec.DataManager.PinType(MeasI.Setup_ByTypeByPin.UVI80(i).pin)) <> UCase("Power") Then
                    .Gate = False
                    .mode = tlDCVIModeVoltage
                    .Voltage = CDbl(MeasI.Setup_ByTypeByPin.UVI80(i).ForceValue1)
                Else
                    'Do nothing --20230531
                End If
                .VoltageRange.Autorange = True
                .CurrentRange.Autorange = True
                .Current = pc_Def_UVI80_Init_MeasCurrRange
                .Connect tlDCVIConnectDefault
                .Gate = True
            End With
            
            TheHdw.Wait 0.001
            
            With TheHdw.DCVI.Pins(MeasI.Setup_ByTypeByPin.UVI80(i).pin)
                '.Meter.mode = tlDCVIMeterCurrent   'T-Est TTR approve by Si -- 230502
                .SetCurrentAndRange CDbl(MeasI.Setup_ByTypeByPin.UVI80(i).Meas_Range), CDbl(MeasI.Setup_ByTypeByPin.UVI80(i).Meas_Range)
                .CurrentRange.Autorange = True
            End With
                
            If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
                If UCase(TheExec.DataManager.PinType(MeasI.Setup_ByTypeByPin.UVI80(i).pin)) <> UCase("Power") Then ''20191217
                    TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Force Volt value, " & MeasI.Pins.UVI80 & " =" & MeasI.Setup_ByTypeByPin.UVI80(i).ForceValue1)
                Else
                    'TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Force Volt value, " & MeasI.Pins.UVI80 & " =" & FormatNumber(thehdw.DCVI.Pins(MeasI.Pins.UVI80).Voltage, 3))
                End If
                'TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Force Volt value, " & MeasI.Setup_ByTypeByPin.UVI80(i).Pin & " =" & MeasI.Setup_ByTypeByPin.UVI80(i).ForceValue1)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range, " & MeasI.Setup_ByTypeByPin.UVI80(i).pin & " = " & MeasI.Setup_ByTypeByPin.UVI80(i).Meas_Range)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I WaitTime, " & MeasI.Setup_ByTypeByPin.UVI80(i).pin & " =" & MeasI.WaitTime.UVI80)
            End If
        Next i
    End If
    If TheExec.Flow.enableWord("CurrentProfile") = False And TheExec.Flow.enableWord("VoltageProfile") = False And Profile_byflow = False Then
        TheHdw.DCVI.Pins(MeasI.Pins.UVI80).Meter.mode = tlDCVIMeterCurrent 'T-Est TTR approve by Si -- 230502
    Else
    End If
    TheHdw.Wait CDbl(MeasI.WaitTime.UVI80)
    If TheExec.Flow.enableWord("CurrentProfile") = False And TheExec.Flow.enableWord("VoltageProfile") = False And Profile_byflow = False Then
        measureCurrent = TheHdw.DCVI.Pins(MeasI.Pins.UVI80).Meter.Read(tlStrobe, sampleSize)
    Else
    End If
    
    If gl_Disable_HIP_debug_log = False Then Call ForceVal_Compare(MeasI, MeasI.Pins.UVI80, "I", "DCVI")
    
    Call HardIP_DCVI_MI_StoreAndRestoreCondition(MeasI, UVI80, False)
    
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_SetupAndMeasureCurrent_UVI80") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function


Public Function HardIP_SetupAndMeasureCurrent_HexVS(sampleSize As Long, ByRef measureCurrent As PinListData)
On Error GoTo errHandler 'Add ErrHandler 2023/05/29

    '' 20150623 - Suggest use for single pin it can mapping expected current range,
    ''                  if use for pin group it will refer the same current range to pin group by your specified.
    Dim i As Integer

    Dim Pins_MeasureI_Together As String
    Dim MeasI As Meas_Type
    MeasI = TestConditionSeqData(Instance_Data.TestSeqNum).MeasI(Instance_Data.TestSeqSweepNum)
    Call HardIP_DCVS_MI_StoreAndRestoreCondition(MeasI, HexVS, True)
    If MeasI.Setup_ByTypeByPin_Flag = False Then
        With TheHdw.DCVS.Pins(MeasI.Pins.HexVS)
            '.Meter.mode = tlDCVSMeterCurrent   'T-Est TTR approve by Si -- 230502
			If TheExec.Flow.enableWord("HardIP_Autorange") = True And InStr(UCase(Instance_Data.CUS_Str_DigSrcData), "BYP_CURR_AUTORANGE") = 0 Then
			Else
				If MeasI.Setup_ByType.HexVS.Meas_Range <> "0" Then .SetCurrentRanges CDbl(MeasI.Setup_ByType.HexVS.Meas_Range), CDbl(MeasI.Setup_ByType.HexVS.Meas_Range)
			End If
            .Gate = True
        End With

        If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
            TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range setting, " & MeasI.Pins.HexVS & " =" & TheHdw.DCVS.Pins(SplitInputCondition(MeasI.Pins.HexVS, ",", 0)).Meter.CurrentRange.value)
            TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range Program setting, " & MeasI.Pins.HexVS & " =" & MeasI.Setup_ByType.HexVS.Meas_Range)
            TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I WaitTime, " & MeasI.Pins.HexVS & " =" & MeasI.WaitTime.HexVS)
        End If
    Else
        For i = 0 To UBound(MeasI.Setup_ByTypeByPin.HexVS)
            With TheHdw.DCVS.Pins(MeasI.Setup_ByTypeByPin.HexVS(i).pin)
            '.Meter.mode = tlDCVSMeterCurrent   'T-Est TTR approve by Si -- 230502
				If TheExec.Flow.enableWord("HardIP_Autorange") = True And InStr(UCase(Instance_Data.CUS_Str_DigSrcData), "BYP_CURR_AUTORANGE") = 0 Then
				Else			
					If MeasI.Setup_ByTypeByPin.HexVS(i).Meas_Range <> "0" Then .SetCurrentRanges CDbl(MeasI.Setup_ByTypeByPin.HexVS(i).Meas_Range), CDbl(MeasI.Setup_ByTypeByPin.HexVS(i).Meas_Range)
				End If
                .Gate = True
            End With
            If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range setting, " & MeasI.Setup_ByTypeByPin.HexVS(i).pin & " =" & TheHdw.DCVS.Pins(MeasI.Setup_ByTypeByPin.HexVS(i).pin).Meter.CurrentRange.value)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range Program setting, " & MeasI.Setup_ByTypeByPin.HexVS(i).pin & " =" & MeasI.Setup_ByTypeByPin.HexVS(i).Meas_Range)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range WaitTime, " & MeasI.Setup_ByTypeByPin.HexVS(i).pin & " =" & MeasI.WaitTime.HexVS)
            End If
        Next i
    End If
	TheHdw.DCVS.Pins(MeasI.Pins.HexVS).Meter.mode = tlDCVSMeterCurrent  'T-Est TTR approve by Si -- 230502			move before auto range 20240531
    ' HardIP BySite Autorange   -- 20230221
    If TheExec.Flow.enableWord("HardIP_Autorange") = True And InStr(UCase(Instance_Data.CUS_Str_DigSrcData), "BYP_CURR_AUTORANGE") = 0 Then
        TheExec.Datalog.WriteComment "========HexVs Autorange Start========"
        Call DCVS_MeasureCurrent_AutoRange(MeasI.Pins.HexVS, True, MeasI.Pins.HexVS, 10, MeasI.Pins.HexVS)
        TheExec.Datalog.WriteComment "========HexVs Autorange Done========"
    End If
        
    TheHdw.Wait CDbl(MeasI.WaitTime.HexVS)
    
    If TheExec.Flow.enableWord("CurrentProfile") = False And TheExec.Flow.enableWord("VoltageProfile") = False And Profile_byflow = False Then
        measureCurrent = TheHdw.DCVS.Pins(MeasI.Pins.HexVS).Meter.Read(tlStrobe, sampleSize, pc_Def_HexVS_ReadPoint, tlDCVSMeterReadingFormatAverage)
    Else
        Dim p As Variant
        Dim Pin_Cnt As Long
        Dim Pins() As String
        Dim Dummy_Value As New SiteDouble: Dummy_Value = 0.0001
        For Each p In Split(MeasI.Pins.HexVS, ",")
            TheExec.DataManager.DecomposePinList p, Pins, Pin_Cnt
            For i = 0 To Pin_Cnt - 1
                measureCurrent.AddPin Pins(i)
                measureCurrent.Pins(Pins(i)) = Dummy_Value
            Next i
        Next p
    End If
    '''--------->Save the interpose PrePat and interpose PreMeas force condition---------
    Dim num_pins As Long
    Dim instr_pins() As String
    Dim DCVS_HW_Value As String
    Call TheExec.DataManager.DecomposePinList(MeasI.Pins.HexVS, instr_pins(), num_pins)
    For i = 0 To num_pins - 1
        DCVS_HW_Value = CStr(FormatNumber(TheHdw.DCVS.Pins(instr_pins(i)).Voltage.value, 3))
        If MeasI.ForceValueDic_HWCom.Exists(UCase(instr_pins(i))) Then
            MeasI.ForceValueDic_HWCom(UCase(instr_pins(i))) = DCVS_HW_Value
        Else
            MeasI.ForceValueDic_HWCom.Add UCase(instr_pins(i)), DCVS_HW_Value
        End If
    Next i
    '''--------->Save the interpose PrePat and interpose PreMeas force condition---------
    
    If gl_Disable_HIP_debug_log = False Then Call ForceVal_Compare(MeasI, MeasI.Pins.HexVS, "I", "DCVS") ''Carter, 20190624
    Call HardIP_DCVS_MI_StoreAndRestoreCondition(MeasI, HexVS, False)

Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_SetupAndMeasureCurrent_HexVS") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

