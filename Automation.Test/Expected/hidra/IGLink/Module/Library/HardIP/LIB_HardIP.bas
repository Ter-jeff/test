Public Function StoreRestoreCondition(SeqData() As MeasSeq_Type, ParaData As String, SplitSymbol As String)
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    'Judge measV seq conditon function -- Neil,20221025
    
    Dim funcName As String:: funcName = "StoreRestoreCondition"
    Dim i As Long
    Dim j As Long
    Dim SeqIdx As Long
    Dim ParaDataAry() As String
    Dim ParaDataAry_Temp() As String
    
    Dim TmpData_pre() As String  ' Use for Parsing multi pin at Same TesSeq
    Dim TmpData_cur() As String  ' Use for Parsing multi pin at Same TesSeq
    Dim TmpData_pos() As String  ' Use for Parsing multi pin at Same TesSeq
    
    Dim P_judge_flag As Boolean
    Dim N_judge_flag As Boolean
    
    Dim Init_Store As Boolean
    Dim Init_Restore As Boolean
    ''Two meansings
    ''Test Seq: V,(V)
    ''IRange  : 0.01
    
    If InStr(ParaData, SplitSymbol) <> 0 Then
        ParaDataAry = Split(ParaData, SplitSymbol)
        If SplitSymbol = "|" Then
            For SeqIdx = 0 To UBound(ParaDataAry)
                If ParaDataAry(SeqIdx) = "" Then
                    'Set "0" when ForceI_Val parameter is empty -- 20220718
                    'Ex. ForceI_Val = |0| |0|0|0|
                    ParaDataAry(SeqIdx) = 0
                End If
            Next SeqIdx
        End If
    Else
        ParaDataAry_Temp = Split(ParaData, SplitSymbol)
        If UBound(SeqData) = 0 Then Exit Function
        
        If UBound(ParaDataAry_Temp) = 0 Then
            If SplitSymbol = "+" Then
                Exit Function
            Else
                ReDim ParaDataAry(UBound(SeqData))
                For SeqIdx = 0 To UBound(SeqData)
                    ParaDataAry(SeqIdx) = ParaDataAry_Temp(0) 'Append data if argument with single parameter --20220718
                Next SeqIdx
            End If
        End If
    End If
    
    For SeqIdx = 0 To UBound(ParaDataAry)
        Init_Store = True
        Init_Restore = True
        If ParaDataAry(SeqIdx) <> "" Then
            If SeqIdx = 0 Then
                P_judge_flag = False
                TmpData_cur = Split(ParaDataAry(SeqIdx), ",")        ' Use for Parsing multi pin at Same TesSeq
                TmpData_pos = Split(ParaDataAry(SeqIdx + 1), ",")    ' Use for Parsing multi pin at Same TesSeq
                
                ' Force Restore state if next sequence meas pin count over current  sequence 's pin count
                ' Use Dobule type compare for ForceI_Val -- 20220718
                If SplitSymbol = "|" Then
                    If UBound(TmpData_cur) = UBound(TmpData_pos) Then
                        For j = 0 To UBound(TmpData_pos)
                            For i = 0 To UBound(TmpData_cur)
                                If CDbl(TmpData_pos(j)) = CDbl(TmpData_cur(i)) Then
                                    'If SeqData(SeqIdx).RestoreCondition = True Then
                                        P_judge_flag = True
                                    'End If
                                Else
                                    P_judge_flag = False
                                End If
                            Next i
                        Next j
                    End If
                Else
                    If UBound(TmpData_cur) = UBound(TmpData_pos) Then
                        For j = 0 To UBound(TmpData_pos)
                            For i = 0 To UBound(TmpData_cur)
                                If (InStr(TmpData_pos(j), TmpData_cur(i)) = 1) Then
                                    'If SeqData(SeqIdx).RestoreCondition = True Then
                                        P_judge_flag = True
                                    'End If
                                Else
                                    P_judge_flag = False
                                End If
                            Next i
                        Next j
                    End If
                End If
                
                If P_judge_flag = True Then
                    Init_Restore = False
                End If
            ElseIf SeqIdx = UBound(ParaDataAry) Then
                N_judge_flag = False
                TmpData_pre = Split(ParaDataAry(SeqIdx - 1), ",")   ' Use for Parsing multi pin at Same TesSeq
                TmpData_cur = Split(ParaDataAry(SeqIdx), ",")       ' Use for Parsing multi pin at Same TesSeq
                'Use Dobule type compare for ForceI_Val -- 20220718
                If SplitSymbol = "|" Then
                    If UBound(TmpData_cur) = UBound(TmpData_pre) Then
                       For i = 0 To UBound(TmpData_pre)
                            For j = 0 To UBound(TmpData_cur)
                                If CDbl(TmpData_pre(i)) = CDbl(TmpData_cur(j)) Then
                                    'If SeqData(SeqIdx).StoreCondition = True Then
                                        N_judge_flag = True
                                    'End If
                                End If
                            Next j
                        Next i
                    End If
                Else
                    If UBound(TmpData_cur) = UBound(TmpData_pre) Then
                       For i = 0 To UBound(TmpData_pre)
                            For j = 0 To UBound(TmpData_cur)
                                If (InStr(TmpData_pre(i), TmpData_cur(j)) = 1) Then
                                    'If SeqData(SeqIdx).StoreCondition = True Then
                                        N_judge_flag = True
                                    'End If
                                End If
                            Next j
                        Next i
                    End If
                End If

                If N_judge_flag = True Then
                    Init_Store = False
                End If
            Else
                P_judge_flag = False
                N_judge_flag = False
                TmpData_pre = Split(ParaDataAry(SeqIdx - 1), ",")    ' Use for Parsing multi pin at Same TesSeq
                TmpData_cur = Split(ParaDataAry(SeqIdx), ",")        ' Use for Parsing multi pin at Same TesSeq
                TmpData_pos = Split(ParaDataAry(SeqIdx + 1), ",")    ' Use for Parsing multi pin at Same TesSeq
                
                'Use Dobule type compare for ForceI_Val -- 20220718
                If SplitSymbol = "|" Then
                    If UBound(TmpData_cur) = UBound(TmpData_pre) Then
                       For i = 0 To UBound(TmpData_pre)
                            For j = 0 To UBound(TmpData_cur)
                                If CDbl(TmpData_pre(i)) = CDbl(TmpData_cur(j)) Then
                                    'If SeqData(SeqIdx).StoreCondition = True Then
                                        N_judge_flag = True
                                    'End If
    
                                End If
                            Next j
                        Next i
                    End If
                Else
                    If UBound(TmpData_cur) = UBound(TmpData_pre) Then
                       For i = 0 To UBound(TmpData_pre)
                            For j = 0 To UBound(TmpData_cur)
                                If TmpData_pre(i) = TmpData_cur(j) Then
                                    'If SeqData(SeqIdx).StoreCondition = True Then
                                        N_judge_flag = True
                                    'End If
    
                                End If
                            Next j
                        Next i
                    End If
                End If
                
                ' Force Restore state if next sequence meas pin count over current  sequence 's pin count
                ' Use Dobule type compare for ForceI_Val -- 20220718
                If SplitSymbol = "|" Then
                    If UBound(TmpData_cur) = UBound(TmpData_pos) Then
                        For j = 0 To UBound(TmpData_pos)
                            For i = 0 To UBound(TmpData_cur)
                                If CDbl(TmpData_pos(j)) = CDbl(TmpData_cur(i)) Then
                                    'If SeqData(SeqIdx).RestoreCondition = True Then
                                        P_judge_flag = True
                                    'End If
    
                                Else
                                    P_judge_flag = False
                                End If
                            Next i
                        Next j
                    End If
                Else
                    If UBound(TmpData_cur) = UBound(TmpData_pos) Then
                        For j = 0 To UBound(TmpData_pos)
                            For i = 0 To UBound(TmpData_cur)
                                If TmpData_pos(j) = TmpData_cur(i) Then
                                    'If SeqData(SeqIdx).RestoreCondition = True Then
                                        P_judge_flag = True
                                    'End If
    
                                Else
                                    P_judge_flag = False
                                End If
                            Next i
                        Next j
                    End If
                End If
                
                If N_judge_flag = True And P_judge_flag = True Then
                    Init_Store = False
                    Init_Restore = False
                ElseIf N_judge_flag = False And P_judge_flag = True Then
                    Init_Restore = False
                ElseIf N_judge_flag = True And P_judge_flag = False Then
                    Init_Store = False
                Else
                    'Do nothing -- 20230531
                End If
                
            End If

            If Init_Store Then
                SeqData(SeqIdx).StoreCondition = Init_Store
            Else
                SeqData(SeqIdx).StoreCondition = SeqData(SeqIdx).StoreCondition And Init_Store
            End If
            
            If Init_Restore Then
                SeqData(SeqIdx).RestoreCondition = Init_Restore
            Else
                SeqData(SeqIdx).RestoreCondition = SeqData(SeqIdx).RestoreCondition And Init_Restore
            End If
        
        End If
    Next SeqIdx

    Exit Function
    
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "StoreRestoreCondition") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function LDO_Measurement_Process_Universal(Pat As String, srcPin As PinList, code() As SiteLong, ByRef Res() As SiteDouble, TrimCodeSize As Long, _
        NumberOfMeasV As Integer, StoreName_Max As Long, ByRef Rtn_MeasVolt() As PinListData, DigSrc_Sample_Size As String, DigSrc_Equation As String, digsrc_assignment As String, _
        TrimStoreName() As String, MeasV_WaitTime As String, DigCap_Pin As PinList, DigCap_DataWidth As Long, DigCap_Sample_Size As Long, CUS_Str_DigCapData As String, CUS_Str_MainProgram As String, MSB_First_Flag As Boolean, bTrimTestSeq() As Boolean, TrimStep As Long, ByRef sl_GrayCode() As SiteLong, bLastTrim As Boolean)
    On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    Dim srcWave() As New DSPWave: ReDim srcWave(NumberOfMeasV - 1, StoreName_Max)
    Dim site As Variant
    Dim InDSPWave As New DSPWave
    Dim i As Long, j As Long
    Dim k As Long
    Dim srcwave_array() As Long: ReDim srcwave_array(TrimCodeSize - 1)
    Dim srcwave_array_graycode() As Long: ReDim srcwave_array_graycode(TrimCodeSize - 1) As Long
    Dim s_Instance As String
    s_Instance = glb_TestInstance
    
    Dim OutDspWave As New DSPWave
    ByPassTestLimit = False
    glb_Disable_CurrRangeSetting_Print = False ''' Mod for Print current range @William 211224
    Dim sTemp() As String

    If bLastTrim = True Then
        ByPassTestLimit = False
    Else
        ByPassTestLimit = True
    End If

    For i = 0 To NumberOfMeasV - 1
        If bTrimTestSeq(i) Then
            sTemp = Split(TrimStoreName(i), ",")
            For j = 0 To UBound(sTemp)
                srcWave(i, j).CreateConstant 0, TrimCodeSize, DspLong
                For Each site In TheExec.sites
                    For k = 0 To TrimCodeSize - 1
                        If k = 0 Then
                            srcwave_array(k) = code(i, j) And 1
                        Else
                            srcwave_array(k) = (code(i, j) And (2 ^ k)) \ (2 ^ k)
                        End If
                    Next k
                    ''' GrayCode
                    If UCase(CUS_Str_MainProgram) Like UCase("*BinToGray*") Then
                        sl_GrayCode(i, j) = 0
                        For k = 0 To UBound(srcwave_array) Step 1
                            If k = UBound(srcwave_array) Then
                                srcwave_array_graycode(k) = srcwave_array(k)
                            Else
                                If srcwave_array(k + 1) = srcwave_array(k) Then
                                    srcwave_array_graycode(k) = 0
                                Else
                                    srcwave_array_graycode(k) = 1
                                End If
                            End If
                            sl_GrayCode(i, j) = sl_GrayCode(i, j).Add(srcwave_array_graycode(k) * 2 ^ k)
                        Next k
                    End If
                    ''' GrayCode
                    If UCase(CUS_Str_MainProgram) Like UCase("*BinToGray*") Then
                        srcWave(i, j).data = srcwave_array_graycode
                    Else
                        srcWave(i, j).data = srcwave_array
                    End If
                Next site
                Call StoreDataAllType(sTemp(j), srcWave(i, j))
            Next j
        End If
    Next i
       
    Dim PreMeas_Ary() As String
    Dim TestSequenceArray() As String
    Dim Interpose_PreMeas_Ary() As String
    TestSequenceArray = Split(Instance_Data.TestSequence, ",")
    Interpose_PreMeas_Ary = SplitInputCondition(Instance_Data.Interpose_PreMeas, "|")
    If Instance_Data.Interpose_PreMeas <> "" Then
        PreMeas_Ary = ParseData_InterPose(Interpose_PreMeas_Ary, TestSequenceArray)
    End If
    
    If Instance_Data.Interpose_PrePat <> "" Then
        Call SetForceCondition(Instance_Data.Interpose_PrePat & ";STOREPREPAT")
    End If
    
    Call HardIP_InitialSetupForPatgen
    Call GeneralDigSrcSettingWithBurst(LCase(Pat), srcPin, InDSPWave)
    Call GeneralDigCapSetting(LCase(Pat), DigCap_Pin, DigCap_Sample_Size, OutDspWave)
    Call PrintDigCapSetting(DigCap_Pin, DigCap_Sample_Size, CUS_Str_DigCapData)
    
    'Update T-Pal print LP5_VCODE trim step with HAC format -- 20220906
    Dim Splt_str() As String
    Dim Splt_str2() As String
    Dim TestNameInput As String
	If gl_Disable_HIP_debug_log = False Then
		TestNameInput = Report_TName_From_Instance(CalcC, "X", , , , , , , tlForceNone)
	End If
    Splt_str = Split(TestNameInput, "_")
    
    TheHdw.Patterns(Pat).start
    
    Dim sTestSeq As String
    Dim sMeasType As String
    Dim sTestSeqAry() As String
    sTestSeqAry = Split(Instance_Data.TestSequence, ",")

    For i = 0 To NumberOfMeasV - 1

        TheHdw.Digital.Patgen.FlagWait cpuA, 0
        Instance_Data.TestSeqNum = i
        
        If Instance_Data.Interpose_PreMeas <> "" Then
            If PreMeas_Ary(Instance_Data.TestSeqNum, 0) <> "" Then
                Call SetForceCondition(PreMeas_Ary(Instance_Data.TestSeqNum, 0) & ";STOREPREMEAS")
            End If
        End If
                    
        sMeasType = sTestSeqAry(i)
        If InStr(UCase(sMeasType), "V") <> 0 Then
            Rtn_MeasVolt(i) = HardIP_MeasureVolt
            sMeasType = "Voltage"
        ElseIf InStr(UCase(sMeasType), "I") <> 0 Then
            Rtn_MeasVolt(i) = HardIP_MeasureCurrent
            sMeasType = "Current"
        ElseIf InStr(UCase(sMeasType), "R") <> 0 Then
            Rtn_MeasVolt(i) = HardIP_SetupAndMeasureR
            sMeasType = "Resistance"
        End If

        If bTrimTestSeq(i) Then
            Call DebugPrintFunc_PPMU("")
            sTemp = Split(TrimStoreName(i), ",")
            
            For j = 0 To UBound(sTemp)
            
                For Each site In TheExec.sites
                
                    For k = 0 To Rtn_MeasVolt(i).Pins.Count - 1
                        If j = k Then
                            '''Res(i) = Rtn_MeasVolt(i).Pins(j).value   '''Update for Leda Current measurement @William 211225
                            If TheExec.TesterMode = testModeOffline Then
                                If CStr(site) = "0" Or CStr(site) = "2" Then
                                    If s_Instance Like "AMPLP5_VCODETRIM*" Then
                                        Rtn_MeasVolt(i).Pins(k).value = TrimStep * 0.1
                                    Else
                                        Rtn_MeasVolt(i).Pins(k).value = TrimStep * 0.02
                                    End If
                                Else
                                    If s_Instance Like "AMPLP5_VCODETRIM*" Then
                                        Rtn_MeasVolt(i).Pins(k).value = TrimStep * 0.3
                                    Else
                                        Rtn_MeasVolt(i).Pins(k).value = TrimStep * 0.04
                                    End If
                                End If
                                Res(i, j) = Abs(Rtn_MeasVolt(i).Pins(k).value)
 
                            Else
                                Res(i, j) = Rtn_MeasVolt(i).Pins(k).value
                                Res(i, j) = Res(i, j).Abs   ''Mod for current
                            End If
                            If gl_Disable_HIP_debug_log = False Then
                                If UCase(CUS_Str_MainProgram) Like UCase("*BinToGray*") Then
                                    'Update T-Pal print LP5_VCODE trim step with HAC format -- 20220906
                                    Splt_str2 = Split(sTemp(j), "_")
                                    Splt_str(5) = "Code-" & sl_GrayCode(i, j)
                                    Splt_str(6) = UCase(Splt_str2(0) & "-" & Splt_str2(1) & "-" & Splt_str2(2))
                                    Splt_str(8) = Replace(Rtn_MeasVolt(i).Pins(k), "_", "-")
                                    TestNameInput = Join(Splt_str, "_")
                                    TheExec.Flow.TestLimit resultVal:=Res(i, j), PinName:="X", Tname:=TestNameInput, scaletype:=scaleNone, ForceResults:=tlForceNone
                                    'TheExec.Datalog.WriteComment "Site " & Site & ",Code " & sl_GrayCode(i, j) & ", Pin : " & Rtn_MeasVolt(i).Pins(k) & ", " & sMeasType & " = " & Res(i, j)
                                Else
                                    'Update T-Pal print LP5_VCODE trim step with HAC format -- 20220906
                                    Splt_str2 = Split(sTemp(j), "_")
                                    Splt_str(5) = "Code-" & code(i, j)
                                    Splt_str(6) = UCase(Splt_str2(0) & "-" & Splt_str2(1) & "-" & Splt_str2(2))
                                    Splt_str(8) = Replace(Rtn_MeasVolt(i).Pins(k), "_", "-")
                                    TestNameInput = Join(Splt_str, "_")
                                    TheExec.Flow.TestLimit resultVal:=Res(i, j), PinName:="X", Tname:=TestNameInput, scaletype:=scaleNone, ForceResults:=tlForceNone
                                    'TheExec.Datalog.WriteComment "Site " & Site & ",Code " & code(i, j) & ", Pin : " & Rtn_MeasVolt(i).Pins(k) & ", " & sMeasType & " = " & Res(i, j)
                                End If
                            End If
                        End If
                    Next k
                Next site
            Next j

        End If
        
        If Instance_Data.Interpose_PreMeas <> "" Then
            If PreMeas_Ary(Instance_Data.TestSeqNum, 0) <> "" Then
                Call SetForceCondition("RESTOREPREMEAS")
            End If
        End If
        
        TheHdw.Digital.Patgen.Continue 0, cpuA

    Next i
    TheHdw.Digital.Patgen.HaltWait
        
    If DigCap_Sample_Size <> 0 Then
        Dim DigCapPinAry() As String, NumberPins As Long
        Dim CUS_Str_DigCapData_temp As String
        Call TheExec.DataManager.DecomposePinList(DigCap_Pin, DigCapPinAry(), NumberPins)
        
        
        If NumberPins > 1 Then
            Call CreateSimulateDataDSPWave_Parallel(OutDspWave, DigCap_Sample_Size)
            Call Checker_StoreDigCapAllToDictionary(CUS_Str_DigCapData, OutDspWave, NumberPins)
            Call DigCapDataProcessByDSP_Parallel(CUS_Str_DigCapData, OutDspWave, DigCap_Sample_Size, NumberPins, , DigCap_Pin.value)

        ElseIf NumberPins = 1 Then
            Call CreateSimulateDataDSPWave(OutDspWave, DigCap_Sample_Size, DigCap_DataWidth)
            Call Checker_StoreDigCapAllToDictionary(CUS_Str_DigCapData, OutDspWave, NumberPins)
'                                                                                                                                                                Dim VBT_LIB_HardIP_ProfileMark_1429 As Long: VBT_LIB_HardIP_ProfileMark_1429 = ProfileMarkEnter(2, instance_name & "_" & "MeasC&Module=VBT_LIB_HardIP&ProcName=Meas_FreqVoltCurr_Universal_func&LineNumber=1427")    ' Profile Mark
            
            Call DigCapDataProcessByDSP(CUS_Str_DigCapData, OutDspWave, DigCap_Sample_Size, DigCap_DataWidth, CUS_Str_MainProgram, , DigCap_Pin.value, , MSB_First_Flag)
'                                                                                                                                                                ProfileMarkLeave VBT_LIB_HardIP_ProfileMark_1429    ' Profile Mark
        End If
    End If
    
    If Instance_Data.Interpose_PrePat <> "" Then
        Call SetForceCondition("RESTOREPREPAT")
    End If
    
    'ByPassTestLimit = True     ''' Fix issue @William 211217    glb_Disable_CurrRangeSetting_Print = False
    ByPassTestLimit = False
    Exit Function
    
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "LDO_Measurement_Process_Universal") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function
Public Function RegExCheckString(ByRef sinputStr As String, ByVal sPattern As String, Optional ByVal bIgnoreCase As Boolean = False) As Boolean
        On Error GoTo errHandler 'Add ErrHandler 2023/05/29
        Dim RegEx As Object
    Set RegEx = CreateObject("vbscript.regexp")
