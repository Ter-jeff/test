Public Function ForceVal_Compare(InputType As Meas_Type, InputPin As String, MeasCase As String, Instr_Type As String, Optional MeasZ_idx As Integer = 0) ''Carter, 20190506
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    Dim instr_pins() As String
    Dim num_pins As Long
    Dim ForceVal As Double
    Dim ForceHWVal As Double
    Dim i As Integer
    Call TheExec.DataManager.DecomposePinList(InputPin, instr_pins(), num_pins)
        'TTR 20201029
    If EnableDigitalTestLimitTTR = True Then
        Exit Function
    End If
    
    For i = 0 To num_pins - 1
                'Add N/C pin check before insturment setup -- 20220823
                If TheExec.DataManager.ChannelType(instr_pins(i)) <> "N/C" Then
                        If MeasCase = "I" Or MeasCase = "R" Or MeasCase = "Z" Then
                                'Output accuracy, From Sicily,20200423, Oscar
                                If Instr_Type = "PPMU" Then
                                        ForceHWVal = FormatNumber(TheHdw.PPMU.Pins(instr_pins(i)).Voltage.value, 3) 'accuracy 5mV
                                ElseIf Instr_Type = "DCVS" Then
                                        ForceHWVal = FormatNumber(TheHdw.DCVS.Pins(instr_pins(i)).Voltage.value, 3)
                                ElseIf Instr_Type = "DCVI" Then
                                        ForceHWVal = FormatNumber(TheHdw.DCVI.Pins(instr_pins(i)).Voltage, 3)
                Else
                    'Do Nothing  -- 20230531
                                End If
                        ElseIf MeasCase = "V" Then
                                If Instr_Type = "PPMU" Then
                                        ForceHWVal = FormatNumber(TheHdw.PPMU.Pins(instr_pins(i)).Current.value, 3)
                                ElseIf Instr_Type = "DCVI" Then
                                        ForceHWVal = FormatNumber(TheHdw.DCVI.Pins(instr_pins(i)).Current, 3)
                                '---------------------------------------Add For Plus, Oscar, 20200227
                                ElseIf Instr_Type = "DCVS" Then
                                        If TheHdw.DCVS.Pins(instr_pins(i)).mode = tlDCVSModeHighImpedance Then
                                                ForceHWVal = 0
                                        Else
                                                If TheHdw.DCVS.Pins(instr_pins(i)).Voltage.value > 0 Then
                                                        ForceHWVal = FormatNumber(TheHdw.DCVS.Pins(instr_pins(i)).CurrentLimit.Source.FoldLimit.level.value, 3)
                                                Else
                                                        ForceHWVal = FormatNumber(TheHdw.DCVS.Pins(instr_pins(i)).CurrentLimit.Sink.FoldLimit.level.value, 3)
                                                End If
                                        End If
                                '---------------------------------------Add For Plus, Oscar, 20200227
                Else
                    'Do Nothing  -- 20230531
                                End If
                        Else
                                'Do Nothing  -- 20230531
                        End If
        
                        If MeasCase = "V" Or MeasCase = "F" Then
                                ForceVal = FormatNumber(CDbl(InputType.ForceValueDic_HWCom(UCase(instr_pins(i)))), 3)
                        ElseIf MeasCase = "I" Or MeasCase = "R" Then
                                If Instr_Type = "DCVI" Then
                                        ForceVal = FormatNumber(CDbl(InputType.ForceValueDic_HWCom(UCase(instr_pins(i)))), 3)
                                Else
                                        ForceVal = FormatNumber(CDbl(InputType.ForceValueDic_HWCom(UCase(instr_pins(i)))), 3)
                                End If
                        Else
                                Dim temp_ary() As String
                                temp_ary = SplitInputCondition(InputType.ForceValueDic_HWCom(UCase(instr_pins(i))), "&")
                                If MeasZ_idx > UBound(temp_ary) Then MeasZ_idx = temp_ary(0)
                                ForceVal = FormatNumber(CDbl(temp_ary(MeasZ_idx)), 3)
                        End If
                                
                        'If Not forceVal = ForceHWVal Then'Original -> the force value and read back value different
                        If ForceVal <> 0 Then
                                If Abs(ForceVal - ForceHWVal) / ForceVal > 0.001 Then 'Force value and read back value >0.1% ,then show error
                                        If TheExec.TesterMode <> testModeOffline Then
                                                TheExec.Datalog.WriteComment "Error - PinName: " & instr_pins(i) & " - The Force Value setup is differ from HW by Pin setting, Please check"
                                        End If
                                End If
                        End If
                End If
    Next i
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "ForceVal_Compare") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function
    

Public Function Opt_Input_Parsing(DSSC_Str As String, Special_Str As String, ByRef DSP_EYE_StartBit As DSPWave, ByRef DSP_EYE_BitLength As DSPWave) As Long
