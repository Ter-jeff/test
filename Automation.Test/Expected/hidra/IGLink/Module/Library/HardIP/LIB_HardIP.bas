Public Function HardIP_FrequencyMeasure(ByRef Rtn_MeasFreq As PinListData, Optional ByRef Rtn_SweepTestName As String)
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    
    Dim MeasFreq As New PinListData
    Dim measf As MeasF_Type
    Dim CounterValue As New PinListData
    Dim pin As New PinList
    measf = TestConditionSeqData(Instance_Data.TestSeqNum).measf(Instance_Data.TestSeqSweepNum)
    
    With TheHdw.Digital.Pins(measf.Pins).FreqCtr
        .EventSource = measf.EventSource
        .EventSlope = Positive
        .Interval = CDbl(measf.Interval)
        .Enable = IntervalEnable
        .Clear
        TheHdw.Wait CDbl(measf.WaitTime)
        .start
        CounterValue = .Read()
    End With
    
    If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
        TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Freq_meas Pin setting = " & measf.Pins)
        TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Freq_meas Interval setting, " & measf.Pins & " = " & measf.Interval)
        TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Freq_meas Waittime Setting, " & measf.Pins & " = " & measf.WaitTime)
    End If
    
    Rtn_MeasFreq = CounterValue.Math.divide(CDbl(measf.Interval))
    
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_FrequencyMeasure") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

'[20231107][All][Neil] Duty Cycle Test Methodology on Digital and DCVI instrument
Public Function HardIP_FrequencyMeasure_UVI80_DCTIME(Rtn_MeasResult As PinListData)
    'Use for Measure Frequency by DCTime(DCVI)
    Dim pld1 As New PinListData
    Dim pld2 As New PinListData
    Dim vsite As Variant
    Dim measf As MeasF_Type
    On Error GoTo errHandler
    measf = TestConditionSeqData(Instance_Data.TestSeqNum).measf(Instance_Data.TestSeqSweepNum)
    'Filter "_DT" for DCVI mode control
    TheHdw.DCVI.Pins(Split(measf.Pins, "_DT")(0)).Disconnect
    
    If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
        TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Freq_meas Pin setting = " & measf.Pins)
    End If
    
    For Each vsite In TheExec.sites 'nn_test_0907
        TheHdw.DCTime.Pins(measf.Pins).Connect
        TheHdw.DCTime.Pins(measf.Pins).mode = tlDCTimeModeStamper
        TheHdw.DCTime.Pins(measf.Pins).Interleave = tlDCTimeInterleaveOff
        TheHdw.DCTime.Pins(measf.Pins).Measurement.Frequency.start.SetInput tlDCTimeStartInputOnTrigger
        With TheHdw.DCTime.Pins(measf.Pins).Measurement.Frequency
            .SetVoltageRange 7, tlDCTimeImpedanceHiZ
            .Hysteresis = tlDCTimeHysteresisOn
            .Threshold = 0.8
            .sampleSize = 511     'Sample size setup for Measure Frequency/Duty [ DCTime : 1-511 ]
            .Slope = tlSlopePositive
        End With
        
        TheHdw.DCTime.Pins(measf.Pins).TimeStamps.Trigger ("my_capture")
    
        TheHdw.DCTime.Pins(measf.Pins).TimeStamps("my_capture").GetWaves pld1, pld2
    
        Rtn_MeasResult = TheHdw.DCTime.Pins(measf.Pins).Measurement.Frequency.CalculatedAverageResults(pld1)
    
        TheHdw.DCTime.Pins(measf.Pins).Disconnect
    Next vsite
Exit Function
errHandler:
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_FrequencyMeasure_UVI80_DCTIME")
    If AbortTest Then Exit Function Else Resume Next
End Function

'[20231107][All][Neil] Duty Cycle Test Methodology on Digital and DCVI instrument
Public Function HardIP_FrequencyMeasure_UVI80_CAPMEM(Rtn_MeasResult As PinListData)
    'Use for Measure Frequency by DCVI Capture memory method From T-S5E
    
        On Error GoTo errHandler
        
        Dim DSPWF_CapRawData As New DSPWave
    Dim measf As MeasF_Type
    Dim vsite As Variant
    Dim SL_SamplePoint As New SiteLong
    Dim DSPWF_DutyCycleResult As New DSPWave                'Calculate and Store DutyCycle via fetch one cycle data of CAP memory
    Dim DSPWF_FrequencyResult As New DSPWave                'Calculate and Store Frequency via fetch one cycle data of CAP memory
    DSPWF_DutyCycleResult.CreateConstant 0, 1, DspDouble
    DSPWF_FrequencyResult.CreateConstant 0, 1, DspDouble
    Dim Fetch_FirstCycleRawData_Flag As Boolean
    Fetch_FirstCycleRawData_Flag = False                    'True : Fetch first cycle data from CAP memory,  False : Fetch the last cycle data from CAP memory
     
    'CapMem Sample rate :781.25Hz - 1MHz
    Dim Cap_SR As Double: Cap_SR = 1000000#                  '1MHz  [ Note : SampleRate must to over 8/3 times of Output_Freq ]
    Dim Cap_SS As Double: Cap_SS = 1024                      'Sample Size = 1024p
        
    measf = TestConditionSeqData(Instance_Data.TestSeqNum).measf(Instance_Data.TestSeqSweepNum)
    
    Do While TheHdw.DCVI.Pins(measf.Pins).Capture.IsCaptureDone = False         ' Wait if another capture is running
    Loop
    
    Rtn_MeasResult.AddPin (measf.Pins)   'Add Pin Name for Measure result
    With TheHdw.DCVI.Pins(measf.Pins)
        .Gate = False
        .mode = tlDCVIModeHighImpedance
        .Voltage = pc_Def_VFI_UVI80_VoltCalmp
        .BleederResistor = tlDCVIBleederResistorOff
        .Current = 0
        .Connect tlDCVIConnectHighSense
        .Gate = True
    End With

    TheHdw.DCVI.Pins(measf.Pins).Capture.Signals.Add "Capture_signal"               ' Create a SIGNAL to set up instrument
    'TheHdw.DCVI.Pins(MeasF.Pins).Capture.Signals.DefaultSignal = "Capture_signal"  ' Set this as the default signal
    With TheHdw.DCVI.Pins(measf.Pins).Capture.Signals.item("Capture_signal")        ' Define the signal used for the capture
        .mode = tlDCVIMeterVoltage
        .range = pc_Def_VFI_UVI80_VoltageRange
        .SampleRate = Cap_SR                        'CapMem Sample rate :781.25Hz - 1MHz (8/3 rate)
        .sampleSize = Cap_SS                        'SampleSize : 512K
        .LoadSettings                               'Setup the hardware by loading the signal
        .Trigger
    End With
    
    ' Get the captured samples from the instrument
    If TheExec.TesterMode = testModeOffline Then
        Dim Simulate_Voltage As Double: Simulate_Voltage = 1#                 ' 1V
        Dim Simulate_Vth As Double: Simulate_Vth = 0.5                        ' For Square_Wave
        Dim Simulate_Output_Freq As Double: Simulate_Output_Freq = 10000#     ' 10KHz
        Dim SineWaveform_Flag As Boolean: SineWaveform_Flag = True            ' True: SineWave, False : SquareWave
        Dim Simulate_WaveData() As Double
        ReDim Simulate_WaveData(Cap_SS - 1) As Double
        Dim Simulate_Data_Idx As Long
        
        If SineWaveform_Flag = True Then
            '====== Sine Wave =======
            For Simulate_Data_Idx = 0 To UBound(Simulate_WaveData)
                Simulate_WaveData(Simulate_Data_Idx) = Simulate_Voltage * Sin(2 * pi * Simulate_Output_Freq / Cap_SR * Simulate_Data_Idx)
            Next
        Else
            '====== Square  Wave =======
            For Simulate_Data_Idx = 0 To UBound(Simulate_WaveData)
                If (Simulate_Voltage * Sin(2 * pi * Simulate_Output_Freq / Cap_SR * Simulate_Data_Idx)) >= Simulate_Vth Then
                    Simulate_WaveData(Simulate_Data_Idx) = Simulate_Voltage     'VOH
                Else
                    Simulate_WaveData(Simulate_Data_Idx) = -Simulate_Voltage    'VOL
                End If
            Next
        End If
        'Generate Simulate Capture waveform
        DSPWF_CapRawData.SampleRate = Cap_SR
        DSPWF_CapRawData.data = Simulate_WaveData
    Else
        DSPWF_CapRawData = TheHdw.DCVI.Pins(measf.Pins).Capture.Signals.item("Capture_signal").DSPWave
    End If
        
    Do While TheHdw.DCVI.Pins(measf.Pins).Capture.IsCaptureDone = False         ' Wait if another capture is running
    Loop

    
    ' Calculate Frequency/DutyCycle via DSP
    Call rundsp.DSP_CALC_FREQ_DUTY_FROM_SPECTRUM(DSPWF_CapRawData, Cap_SR, Cap_SS, Fetch_FirstCycleRawData_Flag, 3, DSPWF_FrequencyResult, DSPWF_DutyCycleResult)
    
    For Each vsite In TheExec.sites
        'Meas Frequency
        Rtn_MeasResult.Pins(measf.Pins).value(vsite) = DSPWF_FrequencyResult
    Next vsite
    
    'After measurment
    TheHdw.DCVI.Pins(measf.Pins).Gate = False
    TheHdw.DCVI.Pins(measf.Pins).Disconnect
Exit Function
errHandler:
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_FrequencyMeasure_UVI80_CAPMEM")
    If AbortTest Then Exit Function Else Resume Next
End Function


Public Function HardIP_DCVS_MI_StoreAndRestoreCondition(Measure As Meas_Type, Instrument As Inst_Type, SaveCondition As Boolean) As Long
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    Dim MI_Pin As String
    Dim PinName() As String
    Dim TypeName As String
    Dim i As Long
    
    
    If Instrument = HexVS Then
        MI_Pin = Measure.Pins.HexVS
    ElseIf Instrument = UVS256 Then
        MI_Pin = Measure.Pins.UVS256
    ElseIf Instrument = VSM Then ''CArter, 20190412
        MI_Pin = Measure.Pins.VSM
    '---------------------------------------UFP_Corr fix 20200413
    ElseIf Instrument = UVS256HP Then
        MI_Pin = Measure.Pins.UVS256HP
    ElseIf Instrument = UVS64 Then
        MI_Pin = Measure.Pins.UVS64
    '---------------------------------------UFP_Corr fix 20200413
    Else
        'Do Nothing  -- 20230531
    End If
    
    PinName = Split(MI_Pin, ",")
    
    ReDim Preserve Measure.SaveCondition(UBound(PinName)) 'For restore

    For i = 0 To UBound(PinName)
        TypeName = SortPinInstrument(PinName(i))
        If SaveCondition = True Then
            Measure.SaveCondition(i).IfPowerPin = False
            Measure.SaveCondition(i).pin = PinName(i)
                                Measure.SaveCondition(i).SourceFlodLimit = FormatNumber(TheHdw.DCVS.Pins(PinName(i)).CurrentLimit.Source.FoldLimit.level.value, 3)
                                Measure.SaveCondition(i).SinkFoldLimit = FormatNumber(TheHdw.DCVS.Pins(PinName(i)).CurrentLimit.Sink.FoldLimit.level.value, 3)
            If TypeName = "VHDVS" Then Measure.SaveCondition(i).FilterValue = FormatNumber(TheHdw.DCVS.Pins(PinName(i)).Meter.Filter.value, 3)
            Measure.SaveCondition(i).SrcCurrentRange = FormatNumber(TheHdw.DCVS.Pins(PinName(i)).CurrentRange.value, 3)
            If TheHdw.DCVS.Pins(PinName(i)).Gate = True Then Measure.SaveCondition(i).IfPowerPin = True
        Else
            
            If Measure.SaveCondition(i).IfPowerPin = False Then
                With TheHdw.DCVS.Pins(PinName(i))
                    .mode = tlDCVSModeHighImpedance
                    .Voltage.value = 0
                    .Gate = False
                    .Disconnect
                End With
            Else
                TheHdw.DCVS.Pins(Measure.SaveCondition(i).pin).CurrentRange.value = CDbl(Measure.SaveCondition(i).SrcCurrentRange) ''Move here for avoid Flodlimit Alarm - Carter, 20190507
                TheHdw.DCVS.Pins(Measure.SaveCondition(i).pin).CurrentLimit.Source.FoldLimit.level.value = CDbl(Measure.SaveCondition(i).SourceFlodLimit)
                If Instrument <> VSM Then  ''Skip switch sink fold limit for VSM to avoid error - JC-Chop MQHu, 20200205
                    TheHdw.DCVS.Pins(Measure.SaveCondition(i).pin).CurrentLimit.Sink.FoldLimit.level.value = CDbl(Measure.SaveCondition(i).SinkFoldLimit)
                End If ''Skip switch sink fold limit for VSM to avoid error - JC-Chop MQHu, 20200205
                If TypeName = "VHDVS" Then TheHdw.DCVS.Pins(Measure.SaveCondition(i).pin).Meter.Filter.value = CDbl(Measure.SaveCondition(i).FilterValue)
            End If
            
        End If
    Next i
    
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_DCVS_MI_StoreAndRestoreCondition") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function HardIP_DCVS_MV_StoreAndRestoreCondition(Measure As Meas_Type, Instrument As Inst_Type, SaveCondition As Boolean) As Long
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    
    Dim MI_Pin As String
    Dim PinName() As String
    Dim TypeName As String
    Dim i As Long
    
    '---------------------------------------UFP_Corr fix 20200413
    If Instrument = UVS256HP Then
        MI_Pin = Measure.Pins.UVS256HP
    ElseIf Instrument = UVS64 Then
        MI_Pin = Measure.Pins.UVS64
    Else
        'Do Nothing  -- 20230531
    End If
    '---------------------------------------UFP_Corr fix 20200413
    PinName = Split(MI_Pin, ",")
    
    ReDim Preserve Measure.SaveCondition(UBound(PinName)) 'For restore

    For i = 0 To UBound(PinName)
        TypeName = SortPinInstrument(PinName(i))
        If SaveCondition = True Then
            Measure.SaveCondition(i).IfPowerPin = False
            Measure.SaveCondition(i).pin = PinName(i)
            Measure.SaveCondition(i).SrcCurrentRange = TheHdw.DCVS.Pins(Measure.SaveCondition(i).pin).CurrentRange.value
            Measure.SaveCondition(i).SourceFlodLimit = TheHdw.DCVS.Pins(PinName(i)).CurrentLimit.Source.FoldLimit.level.value
            Measure.SaveCondition(i).SinkFoldLimit = TheHdw.DCVS.Pins(PinName(i)).CurrentLimit.Sink.FoldLimit.level.value
            If glb_TesterType = "UltraFLEXplus" Then Measure.SaveCondition(i).VoltageRange = TheHdw.DCVS.Pins(PinName(i)).VoltageRange.value 'For UVS256HP/UVS64 setup on UFP --20230901
            Measure.SaveCondition(i).Voltage = TheHdw.DCVS.Pins(PinName(i)).Voltage.value
            If TheHdw.DCVS.Pins(PinName(i)).Gate = True Then Measure.SaveCondition(i).IfPowerPin = True
        Else

            If Measure.SaveCondition(i).IfPowerPin = False Then
                With TheHdw.DCVS.Pins(PinName(i))
                    .mode = tlDCVSModeHighImpedance
                    .Voltage.value = 0
                    .Gate = False
                    .Disconnect
                                .Alarm(tlDCVSAlarmOpenKelvinDUT) = tlAlarmDefault
                End With
            Else
                TheHdw.DCVS.Pins(Measure.SaveCondition(i).pin).CurrentRange.value = CDbl(Measure.SaveCondition(i).SrcCurrentRange) ''Move here for avoid Flodlimit Alarm - Carter, 20190507
                TheHdw.DCVS.Pins(Measure.SaveCondition(i).pin).CurrentLimit.Source.FoldLimit.level.value = CDbl(Measure.SaveCondition(i).SourceFlodLimit)
                TheHdw.DCVS.Pins(Measure.SaveCondition(i).pin).CurrentLimit.Sink.FoldLimit.level.value = CDbl(Measure.SaveCondition(i).SinkFoldLimit)
                If glb_TesterType = "UltraFLEXplus" Then TheHdw.DCVS.Pins(Measure.SaveCondition(i).pin).VoltageRange.value = CDbl(Measure.SaveCondition(i).VoltageRange) 'For UVS256HP/UVS64 setup on UFP --20230901
                TheHdw.DCVS.Pins(Measure.SaveCondition(i).pin).Voltage.value = CDbl(Measure.SaveCondition(i).Voltage)
            End If
        End If
    Next i
    
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_DCVS_MV_StoreAndRestoreCondition") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function


Public Function HardIP_BySeqCurrentProfile()
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    Dim Pin_Ary() As String
    Dim Pin_Cnt As Long
    Dim p As Variant
    Dim dspw As New DSPWave
    Dim Label As String
    Dim filename As String
    Dim IsIO As Boolean
    Dim sampleSize As Long
    Dim SampleRate As Long
    Dim MeasI As Meas_Type
    Dim Profile_Pin As String
    Dim i As Long
    Dim MeasureI_Pin_CurrentRange As String
    Dim site As Variant 'Carter, 20240304
    MeasI = TestConditionSeqData(Instance_Data.TestSeqNum).MeasI(Instance_Data.TestSeqSweepNum)
    Profile_Pin = MeasI.Pins.HexVS & "," & MeasI.Pins.UVS256 & "," & MeasI.Pins.UVS256HP & "," & MeasI.Pins.UVS64 & "," & MeasI.Pins.VSM & "," & MeasI.Pins.UVI80
    Profile_Pin = Replace(Profile_Pin, ",,,,", ",")
    Profile_Pin = Replace(Profile_Pin, ",,,", ",")
    Profile_Pin = Replace(Profile_Pin, ",,", ",")
    If right(Profile_Pin, 1) = "," Then Profile_Pin = left(Profile_Pin, Len(Profile_Pin) - 1)
    If left(Profile_Pin, 1) = "," Then Profile_Pin = right(Profile_Pin, Len(Profile_Pin) - 1)
    
    If InStr(LCase(glb_TestInstance), "lpro") <> 0 Then
        sampleSize = 16000
        SampleRate = 12500
    Else
        sampleSize = 16000
        SampleRate = 25000
    End If
    
    TheExec.Datalog.WriteComment "[Current_Profile] " & glb_TestInstance
    
    Call TheExec.DataManager.DecomposePinList(Profile_Pin, Pin_Ary(), Pin_Cnt)
    IsIO = False
    For Each p In Pin_Ary
        If gl_GetInstrumentType_Dic(p) = "N/C" Or gl_GetInstrumentType_Dic(p) = "I/O" Then IsIO = True
    Next p
    
    If IsIO = False Then
        For i = 0 To Pin_Cnt - 1
            Do While TheHdw.DCVS.Pins(Pin_Ary(i)).Capture.IsRunning = True
            Loop

            TheHdw.DCVS.Pins(Pin_Ary(i)).Capture.Signals.Add Pin_Ary(i) & "_Signal"
            TheHdw.DCVS.Pins(Pin_Ary(i)).Capture.Signals.DefaultSignal = Pin_Ary(i) & "_Signal"
            
            With TheHdw.DCVS.Pins(Pin_Ary(i)).Capture.Signals.item(Pin_Ary(i) & "_Signal")
                .Reinitialize
                .mode = tlDCVSMeterCurrent
                If MeasureI_Pin_CurrentRange = "" Then
                    .range = TheHdw.DCVS.Pins(Pin_Ary(i)).CurrentRange.max
                ElseIf i <= UBound(Split(MeasureI_Pin_CurrentRange, ",")) Then
                    .range = CDbl(Split(MeasureI_Pin_CurrentRange, ",")(i))
                    If CDbl(Split(MeasureI_Pin_CurrentRange, ",")(i)) < 0.2 Then
                        TheHdw.DCVS.Pins(Pin_Ary(i)).CurrentRange = CDbl(Split(MeasureI_Pin_CurrentRange, ",")(i)) * 10
                    Else
                        TheHdw.DCVS.Pins(Pin_Ary(i)).CurrentRange = CDbl(Split(MeasureI_Pin_CurrentRange, ",")(i))
                    End If
                Else
                    .range = CDbl(Split(MeasureI_Pin_CurrentRange, ",")(0))
                    If CDbl(Split(MeasureI_Pin_CurrentRange, ",")(i)) < 0.2 Then
                        TheHdw.DCVS.Pins(Pin_Ary(i)).CurrentRange = CDbl(Split(MeasureI_Pin_CurrentRange, ",")(0)) * 10
                    Else
                        TheHdw.DCVS.Pins(Pin_Ary(i)).CurrentRange = CDbl(Split(MeasureI_Pin_CurrentRange, ",")(0))
                    End If
                End If
                .SampleRate = SampleRate
                .sampleSize = sampleSize
            End With
            TheHdw.DCVS.Pins(Pin_Ary(i)).Capture.Signals.item(Pin_Ary(i) & "_Signal").LoadSettings
        Next i

        For Each p In Pin_Ary
            TheHdw.DCVS.Pins(p).Capture.Signals.item(p & "_Signal").Trigger
        Next p

'        Do While thehdw.DCVS.Pins(MeasureI_pin).Capture.IsRunning = True
'        Loop
    
        ' Get the captured samples from the instrument
        
        Dim sampleR As String
        Dim inst_ary() As String
        inst_ary = Split(glb_TestInstance, "_")
        
        For Each p In Pin_Ary
            If gl_GetInstrumentType_Dic(p) <> "N/C" Then
                
                dspw = TheHdw.DCVS.Pins(p).Capture.Signals(p & "_Signal").DSPWave
                
                For Each site In TheExec.sites
                    sampleR = CStr(TheHdw.DCVS.Pins(p).Capture.SampleRate)
                    'If thehdw.DCVS.Pins(p).Meter.mode = thehdw.DCVS.Pins(p).CurrentRange.Max Then

                    Label = "Current Profile for Site: " & site & " " & " " & p & "_Signal" & "Pin :" & " " & p
                    filename = "CurrentProfile" & "-Site" & site & "_" & inst_ary(0) & "_" & inst_ary(1) & "_" & p & "_" & Instance_Data.TestSeqNum & "-" & p & "-" & sampleR & "-" & glb_TestInstance & "_" & TheHdw.DCVS.Pins(p).Capture.Signals.item(p & "_Signal").range & ".txt"
                    
                    If TheExec.TesterMode = testModeOffline Then
                    
