                For i = 0 To UBound(TempAry)
                    If InStr(TempAry(i), "=") <> 0 Then
                        TNameSeg(CInt(Split(TempAry(i), "=")(0))) = TNameSeg(CInt(Split(TempAry(i), "=")(0))) & Split(TempAry(i), "=")(1)
