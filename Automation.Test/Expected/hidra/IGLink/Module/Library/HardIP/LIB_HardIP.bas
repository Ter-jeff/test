        .IgnoreCase = bIgnoreCase
        RegExCheckString = .test(sinputStr)
    End With
        
        Exit Function
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "RegExCheckString") 'Add ErrHandler 2023/05/29
