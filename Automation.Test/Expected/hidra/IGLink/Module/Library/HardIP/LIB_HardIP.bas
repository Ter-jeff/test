Public Function ProsscessTestLimit_PPMU_TTR(MeasureResult As PinListData, MeasTypeStr As String, Optional SpecifyTestName As String = vbNullString, Optional SpecScaleType As tlScaleType = scaleNone, Optional LimitForceMode As tlLimitForceResults = tlForceFlow)
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    
    Dim ForcePinGroup() As New PinListData
    Dim PinGroupCount As Long
    Dim NumberPins() As Long
    Dim FirstPinName() As String
    Dim TestNameInput As String
    Dim Pins() As String
    Dim Pin_Cnt As Long
    Dim testindex As Long
    
    'TestNameInput = Report_TName_From_Instance(MeasTypeStr, "X", , CInt(Instance_Data.TestSeqNum), 0)
    'TestNameInput = Report_TName_From_Instance(MeasTypeStr, "X", SpecifyTestName, CInt(Instance_Data.TestSeqNum))
    
    Dim i As Long
    Dim j As Long
    
    Dim p As Long

    Dim Temp_index As Long
    Dim Measure As Meas_Type
    Dim unit As UnitType
    Dim ForceUnit As UnitType
    Dim CusUnit As String
    Dim CountIndex As Long
    Dim MeasPinGroup As String 'TTR 20201015
    Dim site As Variant 'Carter, 20240304
    Select Case UCase(MeasTypeStr)
        Case "V":
            Measure = TestConditionSeqData(Instance_Data.TestSeqNum).MeasV(Instance_Data.TestSeqSweepNum)
            unit = unitVolt
            ForceUnit = unitAmp
            CusUnit = vbNullString
        Case "I":
            Measure = TestConditionSeqData(Instance_Data.TestSeqNum).MeasI(Instance_Data.TestSeqSweepNum)
            unit = unitAmp
            ForceUnit = unitVolt
            CusUnit = vbNullString
        Case "F":
            unit = unitHz
            ForceUnit = unitNone
        Case "R":
            Measure = TestConditionSeqData(Instance_Data.TestSeqNum).MeasR(Instance_Data.TestSeqSweepNum)
            unit = unitCustom
            ForceUnit = unitVolt
            CusUnit = "ohm"
        Case "Z":
            Measure = TestConditionSeqData(Instance_Data.TestSeqNum).MeasZ(Instance_Data.TestSeqSweepNum)
            unit = unitCustom
            ForceUnit = unitVolt
            CusUnit = "ohm"
        Case Else
            'Do nothing -- 20230531
    End Select
    'TTR 20201015
    MeasPinGroup = Measure.Pins.PPMU
    MeasPinGroup = Replace(MeasPinGroup, "_", vbNullString)
    MeasPinGroup = Replace(MeasPinGroup, ",", "&")
    If Len(MeasPinGroup) > 50 Then
        MeasPinGroup = "X"
    End If
    
    'Benson 20210611
    If EnableDigitalTestLimitTTR = True Then
        TestNameInput = Report_TName_From_Instance(MeasTypeStr, "X", SpecifyTestName, CInt(Instance_Data.TestSeqNum))
    Else
        'Benson 20210611
        TestNameInput = Report_TName_From_Instance(MeasTypeStr, MeasPinGroup, SpecifyTestName, CInt(Instance_Data.TestSeqNum)) ''20201015
    End If 'Benson 20210611
                
    Temp_index = TheExec.Flow.TestLimitIndex
       
    If Instance_Data.SpecialCalcValSetting = CalculateMethodSetup.VIR_DDIO Then Exit Function   '''20190509
    
    If Measure.Setup_ByTypeByPin_Flag = True And MeasTypeStr <> "F" Then
        For i = 0 To UBound(Measure.Setup_ByTypeByPin.PPMU)
            ReDim Preserve ForcePinGroup(i) As New PinListData
            ReDim Preserve FirstPinName(i) As String
            ReDim Preserve NumberPins(i) As Long
            Call TheExec.DataManager.DecomposePinList(Measure.Setup_ByTypeByPin.PPMU(i).pin, Pins, Pin_Cnt)
            
            For j = 0 To Pin_Cnt - 1
                ForcePinGroup(i).AddPin Pins(j)
            
                ForcePinGroup(i).Pins(Pins(j)) = MeasureResult.Pins(Pins(j))
            
            Next j
            
            FirstPinName(i) = Pins(0)
            NumberPins(i) = Pin_Cnt
                
        Next i
    
    Else
        If MeasTypeStr = "F" Then
            Call TheExec.DataManager.DecomposePinList(TestConditionSeqData(Instance_Data.TestSeqNum).measf(Instance_Data.TestSeqSweepNum).Pins, Pins, Pin_Cnt)
        Else
            Call TheExec.DataManager.DecomposePinList(Measure.Pins.PPMU, Pins, Pin_Cnt)
        End If
            
            ReDim ForcePinGroup(0) As New PinListData
            ReDim FirstPinName(0) As String
            ReDim NumberPins(0) As Long
            
            ForcePinGroup(0) = MeasureResult
            FirstPinName(0) = Pins(0)
            NumberPins(0) = Pin_Cnt

    End If
    
    If CheckSameLimitForMerge(NumberPins) = False Then
        Call ProsscessTestLimit(MeasureResult, MeasTypeStr, CInt(Instance_Data.TestSeqNum), SpecifyTestName)
    Else
        
        For PinGroupCount = 0 To UBound(ForcePinGroup)
            testindex = TheExec.Flow.TestLimitIndex
            If NumberPins(PinGroupCount) > 1 Then Call Print_Error_Message(Warning_Info, "LIB_HardIP", "ProsscessTestLimit_PPMU_TTR", "Single-limit = True. Please check fail flag are all same. [" & MeasPinGroup & ":Start" & testindex & "]")
            If MeasTypeStr = "V" Or MeasTypeStr = "I" Or MeasTypeStr = "R" Then
    
                If EnableHardIPDigCapsdisableTTR = True Then
                    If (Instance_Data.hiLimit(TheExec.Flow.TestLimitIndex) = "" And Instance_Data.LowLimit(TheExec.Flow.TestLimitIndex) = "") Or _
                        (Instance_Data.hiLimit(TheExec.Flow.TestLimitIndex) = "9.999" And Instance_Data.LowLimit(TheExec.Flow.TestLimitIndex) = "-9.999") Or _
                        (Instance_Data.hiLimit(TheExec.Flow.TestLimitIndex) = "9999" And Instance_Data.LowLimit(TheExec.Flow.TestLimitIndex) = "-9999") Then
                                                '[20231011][All][Neil] For fixed TName shift issue, increase TestNumber when skipTestLimit founded
                        For Each site In TheExec.sites
                                                        TheExec.Flow.TestNumber = TheExec.sites.item(site).TestNumber + 1
                                                        Exit For
                        Next site
                        TheExec.Flow.TestLimitIndex = TheExec.Flow.TestLimitIndex + 1
                        TheExec.Datalog.WriteComment "SkipTestLimit: " & glb_TestInstance & "****" & Instance_Data.TestSeqNum
                    Else
                        TheExec.Flow.TestLimit ForcePinGroup(PinGroupCount), , , , , SpecScaleType, unit, Tname:=TestNameInput, _
                                        ForceVal:=Measure.ForceValueDic_HWCom(UCase(FirstPinName(PinGroupCount))), ForceUnit:=ForceUnit, _
                                        customUnit:=CusUnit, ForceResults:=LimitForceMode
                    End If
                Else
                    TheExec.Flow.TestLimit ForcePinGroup(PinGroupCount), , , , , SpecScaleType, unit, Tname:=TestNameInput, _
                                        ForceVal:=Measure.ForceValueDic_HWCom(UCase(FirstPinName(PinGroupCount))), ForceUnit:=ForceUnit, _
                                        customUnit:=CusUnit, ForceResults:=LimitForceMode
                End If
            Else
                TheExec.Flow.TestLimit ForcePinGroup(PinGroupCount), _
                            , , , , SpecScaleType, unit, Tname:=TestNameInput, _
                                        ForceUnit:=ForceUnit, customUnit:=CusUnit, ForceResults:=LimitForceMode
            End If
            
            If Instance_Data.Flag_SingleLimit = False Then
                TheExec.Flow.TestLimitIndex = TheExec.Flow.TestLimitIndex + NumberPins(PinGroupCount) - 1
            Else
                TheExec.Flow.TestLimitIndex = TheExec.Flow.TestLimitIndex - 1
            End If
            If NumberPins(PinGroupCount) > 1 Then Call Print_Error_Message(Warning_Info, "LIB_HardIP", "ProsscessTestLimit_PPMU_TTR", "Single-limit = True. Please check fail flag are all same. [" & MeasPinGroup & ":End" & testindex & "]")
        Next PinGroupCount
     
        If Instance_Data.Flag_SingleLimit = True Then TheExec.Flow.TestLimitIndex = TheExec.Flow.TestLimitIndex + 1
    End If
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "ProsscessTestLimit_PPMU_TTR") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function CheckSameLimitForMerge(NumberPins() As Long) As Boolean
On Error GoTo errHandler 'Add ErrHandler 2023/05/29

    Dim FlowLimitObj As IFlowLimitsInfo: Call TheExec.Flow.GetTestLimits(FlowLimitObj)
    Dim FlowTestName() As String: Call FlowLimitObj.GetTNames(FlowTestName)
    Dim TestLimitIndex As Long: TestLimitIndex = TheExec.Flow.TestLimitIndex
    Dim FlowHilimit() As String: Call FlowLimitObj.GetHighLimits(FlowHilimit)
    Dim FlowLolimit() As String: Call FlowLimitObj.GetLowLimits(FlowLolimit)
    Dim i As Long
    Dim j As Long
    Dim GroupStartIndex As Long
    
    GroupStartIndex = TestLimitIndex
    For j = 0 To UBound(NumberPins)

        If NumberPins(j) > 1 And Instance_Data.Flag_SingleLimit = False Then
            If GroupStartIndex > UBound(FlowHilimit) Then
                CheckSameLimitForMerge = False
                TheExec.Datalog.WriteComment "Error : Test Limit Index More then Flow Table in TTR check function"
                Exit Function
            End If
            Dim FirstHiLimit As String:  FirstHiLimit = FlowHilimit(GroupStartIndex)
            Dim FirstLoLimit As String:  FirstLoLimit = FlowLolimit(GroupStartIndex)
            Dim FirstTestName As String: FirstTestName = FlowTestName(GroupStartIndex)
            
            
            For i = GroupStartIndex To GroupStartIndex + NumberPins(j) - 1
            
                If ((FirstHiLimit = FlowHilimit(i)) And (FirstLoLimit = FlowLolimit(i)) And (FirstTestName = FlowTestName(i))) Then
                    CheckSameLimitForMerge = True
                Else
                    CheckSameLimitForMerge = False
                    Exit Function
                End If
            
            Next i
            GroupStartIndex = GroupStartIndex + NumberPins(j)
        Else
            CheckSameLimitForMerge = True
            GroupStartIndex = GroupStartIndex + 1
        End If
        
    Next j
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "CheckSameLimitForMerge") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function Processing_MeasPins(ByRef MeasV_PinS As String, ByRef MeasI_pinS As String, MeasF_PinS_SingleEnd) As Long  ' Edited by Dylan 2020/01/17
On Error GoTo errHandler 'Add ErrHandler 2023/05/29

    Dim i, j, k As Long
    Dim MeasSymbol As String
    Dim MeasCombine As String
    Dim MeasTempPins As String
    Dim MeasPinsAry() As String
    Dim MeasPinsValue() As String
    Dim CombineStr(2) As String
    
    CombineStr(0) = MeasV_PinS
    CombineStr(1) = MeasI_pinS
    CombineStr(2) = MeasF_PinS_SingleEnd
    
    
    For i = 0 To UBound(CombineStr)
        If CombineStr(i) Like "*&*" Then
            MeasCombine = vbNullString
            MeasPinsAry = Split(CombineStr(i), "&")
            For j = 0 To UBound(MeasPinsAry)
                MeasPinsValue = Split(MeasPinsAry(j), "*")
                MeasPinsValue(0) = Replace(MeasPinsValue(0), "(", vbNullString)
                MeasPinsValue(0) = Replace(MeasPinsValue(0), ")", vbNullString)
                MeasSymbol = MeasPinsValue(2)
                
                For k = 0 To CLng(MeasPinsValue(1))
                    If k = 0 Then
                        MeasTempPins = MeasPinsValue(0)
                    Else
                        MeasTempPins = MeasTempPins & MeasSymbol & MeasPinsValue(0)
                    End If
                Next k
                MeasCombine = MeasCombine & MeasTempPins
                MeasTempPins = vbNullString
            Next j
            
            If i = 0 Then
                MeasV_PinS = MeasCombine
            ElseIf i = 1 Then
                MeasI_pinS = MeasCombine
            Else
                MeasF_PinS_SingleEnd = MeasCombine
            End If
        End If
    Next i
    
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "Processing_MeasPins") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function
Public Function Reg_Assign_Processing(Optional ByRef DigSrc_Equation As String, Optional ByRef digsrc_assignment As String, Optional ByRef CUS_Str_DigCapData As String, Optional ByRef Calc_Eqn As String, _
