    End If
    
    Factor = 1
    
    If LCase(InstType) = "ppmu" Then
        MaxWaitTime = pc_Def_VFI_MI_WaitTime_PPMU
    End If
        
    If SpecifyWaitTime_double > MaxWaitTime Then MaxWaitTime = SpecifyWaitTime_double
    
    If Measure.Setup_ByTypeByPin_Flag = False Then
        
        If (Measure.Setup_ByType.HexVS.Meas_Range <> "") Then
            TheExec.DataManager.DecomposePinList Measure.Pins.HexVS, SplitPins, PinCnt
            If InstType_Check.Pin_Parsed_Name.Exists(Measure.Pins.HexVS) = False Then           'update for single pin for range list in T-EST   Brian
                For Power_pins = 0 To UBound(PowerPin_range_ary)
                    If UCase(SplitPins(0)) = UCase(PowerPin_range_ary(Power_pins).PinName) Then
                        If CDbl(Measure.Setup_ByType.HexVS.Meas_Range) = 0 Or CDbl(Measure.Setup_ByType.HexVS.Meas_Range) = 9.999 Then
                            Measure.Setup_ByType.HexVS.Meas_Range = CDbl(PowerPin_range_ary(Power_pins).Range_List(UBound(PowerPin_range_ary(Power_pins).Range_List)))
                            WaitTime = CDbl(PowerPin_range_ary(Power_pins).WaitTime_List(UBound(PowerPin_range_ary(Power_pins).WaitTime_List)))
                        Else
                            For range_indx = 0 To UBound(PowerPin_range_ary(Power_pins).Range_List)
