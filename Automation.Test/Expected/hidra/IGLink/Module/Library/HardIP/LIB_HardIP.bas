                            If gl_GPIO_VDD_Pin <> "" Then
                                Vdiff = TheHdw.DCVS.Pins(gl_GPIO_VDD_Pin).Voltage.value - CDbl(MeasI.Setup_ByTypeByPin.PPMU(i).ForceValue1) ''vddio18_grp!!!
                            Else
                                Call Print_Error_Message(Warning_Info, "LIB_HardIP", "HardIP_SetupAndMeasureCurrent_PPMU", "Missing VDD pin information!!")
                                Vdiff = 999.9
                            End If
                        Else
                            Vdiff = CDbl(MeasI.Setup_ByTypeByPin.PPMU(i).ForceValue1)
                        End If
'                        Dim Pins() As String
'                        Dim Pin_Cnt As Long
'                        Dim var As Variant
                        TheExec.DataManager.DecomposePinList MeasI.Setup_ByTypeByPin.PPMU(i).pin, Pins, Pin_Cnt
                        For Each var In Pins
                        
                            If gl_Disable_HIP_debug_log = False Then
