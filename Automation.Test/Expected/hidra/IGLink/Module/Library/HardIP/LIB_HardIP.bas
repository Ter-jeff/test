                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I WaitTime, " & MeasI.Pins.PPMU & " =" & MeasI.WaitTime.PPMU)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Force Volt value, " & MeasI.Pins.PPMU & " =" & MeasI.Setup_ByType.PPMU.ForceValue1)
