    TestNumber = 0

    RegDict.RemoveAll
    
    USsheet() = TheExec.job.GetSheetNamesOfType(DMGR_SHEET_TYPE_USER)
    
    For i = 0 To UBound(USsheet)
        If LCase(USsheet(i)) Like "reg_assign*" Then
            If Count = "" Then
