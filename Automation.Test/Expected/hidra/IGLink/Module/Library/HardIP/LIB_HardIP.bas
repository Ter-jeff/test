                        Case "/"
                            val_dec_Temp = val_dec_Temp.divide(val_dec).divide("2")      'Roger
'                            Call rundsp.DSP_Divide(Val_TempDSP, Val_ParallelDSP)
                        Case Else
                            'Do nothing -- 20230531
                    End Select
                End If
            End If
        End If
    Next i
    

    For Each site In TheExec.sites
        If b_FirstIsConstant Then
            If b_SecondIsConstant Then
                RTN_DSPWave(site).Element(0) = Val_TempConstant
            Else
                Select Case operator

                    Case "+"
                        RTN_DSPWave(site).Element(0) = Val_TempConstant + val_dec_Temp
                        
                    Case "-"
                        RTN_DSPWave(site).Element(0) = Val_TempConstant - val_dec_Temp
                        
                    Case "*"
                        RTN_DSPWave(site).Element(0) = Val_TempConstant * val_dec_Temp
                        
                    Case "/"
                        RTN_DSPWave(site).Element(0) = Val_TempConstant / val_dec_Temp
                    Case Else
                        'Do nothing -- 20230531
                End Select
            End If
            
        Else
            If b_SecondIsConstant Then
                Select Case operator

                    Case "+"
                        RTN_DSPWave(site).Element(0) = val_dec_Temp + Val_TempConstant
                        
                    Case "-"
                        RTN_DSPWave(site).Element(0) = val_dec_Temp - Val_TempConstant
                        
                    Case "*"
                        RTN_DSPWave(site).Element(0) = val_dec_Temp * Val_TempConstant
                        
                    Case "/"
                       RTN_DSPWave(site).Element(0) = val_dec_Temp / Val_TempConstant
                    Case Else
                        'Do nothing -- 20230531
                End Select
            
            Else
                RTN_DSPWave(site).Element(0) = val_dec_Temp
            End If
        End If
    Next site
    
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "ProcessDSPCalculation_DIV2") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function GeneralDigSrcSettingWithBurst(Optional patt As String, Optional DigSrc_pin As PinList, Optional ByRef InDSPWave As DSPWave, Optional ByRef Rtn_SweepTestName As String = vbNullString, Optional MSB_First_Flag As Boolean = False)
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    
    Dim sDigSrc_DataWidth As String
    Dim sDigSrc_SampleSize As String
    If BurstYesPatDict.Exists(LCase(patt)) Then
        Dim patt_index As Long
        Dim PatCount1 As Long
        Dim PattArray1() As String
        Dim DigSrc_Equation_Ary() As String
        Dim DigSrc_DataWidth_Ary() As String
        Dim DigSrc_Assignment_Ary() As String
        Dim DigSrc_Sample_Size_Ary() As String
        Dim DigSrc_FlowForLoopIntegerName_Ary() As String

        DigSrc_Equation_Ary = Split(Instance_Data.DigSrc_Equation, "|")
        DigSrc_DataWidth_Ary = Split(Instance_Data.DigSrc_DataWidth, "|")
        DigSrc_Assignment_Ary = Split(Instance_Data.digsrc_assignment, "|")
        DigSrc_Sample_Size_Ary = Split(Instance_Data.DigSrc_Sample_Size, "|")
'        DigSrc_FlowForLoopIntegerName_Ary = Split(Instance_Data.DigSrc_FlowForLoopIntegerName, "|")
        If InStr(LCase(Instance_Data.DigSrc_FlowForLoopIntegerName), "srccodeindx") <> 0 Then
            TheExec.Datalog.WriteComment "SrcCodeIndex Value= " & TheExec.Flow.var("SrcCodeIndx").value
        End If
    
        If InStr(LCase(Instance_Data.DigSrc_FlowForLoopIntegerName), "srccodeindx1") <> 0 Then
            TheExec.Datalog.WriteComment "SrcCodeIndex1 Value= " & TheExec.Flow.var("SrcCodeIndx1").value
        End If
    
        If InStr(LCase(Instance_Data.DigSrc_FlowForLoopIntegerName), "srccodeindx2") <> 0 Then
            TheExec.Datalog.WriteComment "SrcCodeIndex2 Value= " & TheExec.Flow.var("SrcCodeIndx2").value
        End If
        Call PATT_GetPatListFromPatternSet(patt, PattArray1, PatCount1)
        If UBound(PattArray1) <> UBound(DigSrc_Equation_Ary) Then
        Else
            For patt_index = 0 To PatCount1 - 1
                If DigSrc_Equation_Ary(patt_index) <> "" Or DigSrc_Assignment_Ary(patt_index) <> "" Then   'Add DigSrc_Assignment contents check -- 20220824
                    If DigSrc_DataWidth_Ary(patt_index) = "" Then DigSrc_DataWidth_Ary(patt_index) = "0"
                    If DigSrc_Sample_Size_Ary(patt_index) = "" Then DigSrc_Sample_Size_Ary(patt_index) = "0"
'                   If InStr(Instance_Data.DigSrc_FlowForLoopIntegerName, "|") <> 0 Then
'                       Call GeneralDigSrcSetting(PattArray1(patt_index), DigSrc_pin, CLng(DigSrc_Sample_Size_Ary(patt_index)), CLng(DigSrc_DataWidth_Ary(patt_index)), DigSrc_Equation_Ary(patt_index), DigSrc_Assignment_Ary(patt_index), _
'                       DigSrc_FlowForLoopIntegerName_Ary(patt_index), Instance_Data.CUS_Str_DigSrcData, InDSPwave, Rtn_SweepTestName)
'                   Else
                        Call GeneralDigSrcSetting(PattArray1(patt_index), DigSrc_pin, CLng(DigSrc_Sample_Size_Ary(patt_index)), CLng(DigSrc_DataWidth_Ary(patt_index)), DigSrc_Equation_Ary(patt_index), DigSrc_Assignment_Ary(patt_index), _
                        Instance_Data.DigSrc_FlowForLoopIntegerName, Instance_Data.CUS_Str_DigSrcData, InDSPWave, Rtn_SweepTestName, MSB_First_Flag)    'Fix MSB_First_Flag import -- 20230203
'                   End If
                End If
            Next patt_index
        End If
        
    Else
        If Instance_Data.DigSrc_Equation <> "" And Instance_Data.DigSrc_Equation <> "|" Then
            If Instance_Data.DigSrc_DataWidth = "" Then
                sDigSrc_DataWidth = "0"
            Else
                sDigSrc_DataWidth = Instance_Data.DigSrc_DataWidth
            End If
            If Instance_Data.DigSrc_Sample_Size = "" Then
                sDigSrc_SampleSize = "0"
            Else
                sDigSrc_SampleSize = Instance_Data.DigSrc_Sample_Size
            End If
            Call GeneralDigSrcSetting(patt, DigSrc_pin, CLng(sDigSrc_SampleSize), CLng(sDigSrc_DataWidth), Instance_Data.DigSrc_Equation, Instance_Data.digsrc_assignment, _
                                                Instance_Data.DigSrc_FlowForLoopIntegerName, Instance_Data.CUS_Str_DigSrcData, InDSPWave, Rtn_SweepTestName, MSB_First_Flag) 'Fix MSB_First_Flag import -- 20230203
    '                                                                                                                                                           ProfileMarkLeave VBT_LIB_HardIP_ProfileMark_1267    ' Profile Mark
        End If
    End If
    
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "GeneralDigSrcSettingWithBurst") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function DCVS_MeasureCurrent_AutoRange(ByVal sMeasPin As String, Optional ByVal bAutoRange As Boolean = False, Optional ByVal sAutoRange_Pin As String = vbNullString, Optional ByVal lAutoRange_Step As Long = 5, Optional ByVal sDebugPrint As String = vbNullString)
On Error GoTo errHandler 'Add ErrHandler 2023/05/29

    Dim funcName As String:: funcName = "DCVS_MeasureCurrent_AutoRange"
    Dim site As Variant 'Carter, 20240304
    Dim i As Long
    Dim j As Long
    Dim k As Long
    Dim lMeasPin_Cnt As Long
    
    Dim val As Double
    Dim dWaitTime As Double
    Dim dSattleTime As Double
        
    Dim sAllMeasPin As String
    
    Dim sPinAry() As String
    Dim sMeasPin_Ary() As String
    
    Dim p_hexvs As String
    Dim A_HexVS() As String
    Dim HexVS_Power_data As New PinListData

    Dim p_uvs As String
    Dim A_UVS() As String
    Dim UVS_Power_data As New PinListData

    Dim p_vsm As String
    Dim A_VSM() As String
    Dim VSM_Power_data As New PinListData

    '''-----------------UFP-----------------
    Dim p_ufp As String
    Dim A_UFP() As String
    Dim UFP_Power_data As New PinListData
    '''-----------------UFP-----------------
    Dim sDebugPrint_Ary() As String
    Dim sDebugPrint_Temp As String
    dWaitTime = 100 * us
    If sDebugPrint <> "" Then
        TheExec.DataManager.DecomposePinList sDebugPrint, sDebugPrint_Ary, lMeasPin_Cnt
        sDebugPrint_Temp = Join(sDebugPrint_Ary, ",")
    End If
    TheExec.DataManager.DecomposePinList sMeasPin, sMeasPin_Ary, lMeasPin_Cnt
    
    For i = 0 To lMeasPin_Cnt - 1
        If TheExec.DataManager.ChannelType(sMeasPin_Ary(i)) <> "N/C" Then sAllMeasPin = sAllMeasPin & "," & sMeasPin_Ary(i)
    Next i

    If sAllMeasPin <> "" Then sAllMeasPin = right(sAllMeasPin, Len(sAllMeasPin) - 1)

    sPinAry = Split(sAllMeasPin, ",")
    ''**** Start - Get PowerPin Info ****
    Dim ids_range_ary() As AutoRange_Info
    ReDim ids_range_ary(UBound(sPinAry))
    For i = 0 To UBound(sPinAry)
        For j = 0 To UBound(PowerPin_range_ary)
            If sPinAry(i) = PowerPin_range_ary(j).PinName Then
                ids_range_ary(i) = PowerPin_range_ary(j)
            End If
        Next j
    Next i
    ''**** End - Get PowerPin Info ****

    ''**** Start - Set init IRange ****
    For i = 0 To UBound(sPinAry)
''        ids_range_ary(i).Init_CurrentRange = TheHdw.DCVS.Pins(sPinAry(i)).CurrentRange.value
        ids_range_ary(i).Init_CurrentRange = TheHdw.DCVS.Pins(sPinAry(i)).CurrentRange.max
        ids_range_ary(i).hiLimit = 0 ''Compare_ForceVal_BV(Pin_Ary(i), Val_Hi(i)) 'if pins without limit use bincut spec IDSmax as current range
        If LCase(ids_range_ary(i).ChanMapType) = "hexvs" Then
            p_hexvs = p_hexvs & "," & sPinAry(i)
        ElseIf LCase(ids_range_ary(i).ChanMapType) = "vhdvs" Then
            p_uvs = p_uvs & "," & sPinAry(i)
        ElseIf LCase(ids_range_ary(i).ChanMapType) = "vsm" Then
            p_vsm = p_vsm & "," & sPinAry(i)
        '''-----------------UFP-----------------
        ElseIf LCase(ids_range_ary(i).ChanMapType) = "vs-800ma" Then
            p_ufp = p_ufp & "," & sPinAry(i)
        ElseIf LCase(ids_range_ary(i).ChanMapType) = "vs-5a" Then
            p_ufp = p_ufp & "," & sPinAry(i)
        '''-----------------UFP-----------------
        Else
            'Do nothing -- 20230531
        End If

        If ids_range_ary(i).hiLimit = 0 Then val = ids_range_ary(i).Init_CurrentRange Else val = Abs(ids_range_ary(i).hiLimit)  'if pins without bincut spec IDSmax, use current range
'            If Val_Hi(i) = "" Then Val = range_ary(i).Init_CurrentRange Else Val = Abs(Val_Hi(i)) 'if pins without limit use current range
        For j = 0 To UBound(ids_range_ary(i).Range_List)
            If val <= ids_range_ary(i).Range_List(j) Then
                ids_range_ary(i).Init_step = j
                dSattleTime = ids_range_ary(i).WaitTime_List(j)
                TheHdw.DCVS.Pins(sPinAry(i)).SetCurrentRanges ids_range_ary(i).Range_List(j), ids_range_ary(i).Range_List(j)
                If dSattleTime > dWaitTime Then dWaitTime = dSattleTime
                Exit For
            End If
        Next j
    Next i
    ''**** End - Set init IRange ****
    
    If p_hexvs <> "" Then p_hexvs = right(p_hexvs, Len(p_hexvs) - 1)
    If p_uvs <> "" Then p_uvs = right(p_uvs, Len(p_uvs) - 1)
    If p_vsm <> "" Then p_vsm = right(p_vsm, Len(p_vsm) - 1)
    '''-----------------UFP-----------------
    If p_ufp <> "" Then p_ufp = right(p_ufp, Len(p_ufp) - 1)
    '''-----------------UFP-----------------

    A_HexVS = Split(p_hexvs, ",")
    A_UVS = Split(p_uvs, ",")
    A_VSM = Split(p_vsm, ",")
    '''-----------------UFP-----------------
    A_UFP = Split(p_ufp, ",")
    '''-----------------UFP-----------------
    TheHdw.Wait dWaitTime
    
    If p_hexvs <> "" Then 
		If TheHdw.DCVS.Pins(p_hexvs).Meter.Mode <> 1 then Call Print_Error_Message(Error_Info, "LIB_HardIP", "DCVS_MeasureCurrent_AutoRange", "Meter mode is wrong,, please check meter mode!!")
	End If
    If p_uvs <> "" Then 
		If TheHdw.DCVS.Pins(p_uvs).Meter.Mode <> 1 then Call Print_Error_Message(Error_Info, "LIB_HardIP", "DCVS_MeasureCurrent_AutoRange", "Meter mode is wrong,, please check meter mode!!")
	End If	
    If p_vsm <> "" Then 
		If TheHdw.DCVS.Pins(p_vsm).Meter.Mode <> 1 then Call Print_Error_Message(Error_Info, "LIB_HardIP", "DCVS_MeasureCurrent_AutoRange", "Meter mode is wrong,, please check meter mode!!")
	End If	
    If p_ufp <> "" Then 
		If TheHdw.DCVS.Pins(p_ufp).Meter.Mode <> 1 then Call Print_Error_Message(Error_Info, "LIB_HardIP", "DCVS_MeasureCurrent_AutoRange", "Meter mode is wrong,, please check meter mode!!")
	End If	
    If TheExec.Flow.enableWord("CurrentProfile") Or TheExec.Flow.enableWord("VoltageProfile") Or Profile_byflow = True Then


    Else
        If p_hexvs <> "" Then HexVS_Power_data = TheHdw.DCVS.Pins(p_hexvs).Meter.Read(tlStrobe, 10, , tlDCVSMeterReadingFormatAverage)
        If p_uvs <> "" Then UVS_Power_data = TheHdw.DCVS.Pins(p_uvs).Meter.Read(tlStrobe, 1, , tlDCVSMeterReadingFormatAverage)
        If p_vsm <> "" Then VSM_Power_data = TheHdw.DCVS.Pins(p_vsm).Meter.Read(tlStrobe, 10, , tlDCVSMeterReadingFormatAverage)
        If p_ufp <> "" Then UFP_Power_data = TheHdw.DCVS.Pins(p_ufp).Meter.Read(tlStrobe, 10, , tlDCVSMeterReadingFormatAverage)

        '-------------------------------------------debug print
        ''                sDebugPrint = AutoRange_Pin
        If sDebugPrint <> "" Then
            TheExec.Datalog.WriteComment "-----> 1st Init Current Range Setup"
            For i = 0 To UBound(ids_range_ary)
                If InStr(LCase(sDebugPrint_Temp), LCase(ids_range_ary(i).PinName)) > 0 Then
                    For Each site In TheExec.sites
                          If LCase(ids_range_ary(i).ChanMapType) = "hexvs" Then
                                TheExec.Datalog.WriteComment "Site(" & site & "), " & ids_range_ary(i).PinName & ", Step 0" & ", Irange: " & TheHdw.DCVS.Pins(ids_range_ary(i).PinName).Meter.CurrentRange.value & ", Current: " & HexVS_Power_data.Pins(ids_range_ary(i).PinName).value(site)
                          ElseIf LCase(ids_range_ary(i).ChanMapType) = "vhdvs" Then
                                TheExec.Datalog.WriteComment "Site(" & site & "), " & ids_range_ary(i).PinName & ", Step 0" & ", Irange: " & TheHdw.DCVS.Pins(ids_range_ary(i).PinName).CurrentRange.value & ", Current: " & UVS_Power_data.Pins(ids_range_ary(i).PinName).value(site)
                          ElseIf LCase(ids_range_ary(i).ChanMapType) = "vsm" Then
                                TheExec.Datalog.WriteComment "Site(" & site & "), " & ids_range_ary(i).PinName & ", Step 0" & ", Irange: " & TheHdw.DCVS.Pins(ids_range_ary(i).PinName).CurrentRange.value & ", Current: " & VSM_Power_data.Pins(ids_range_ary(i).PinName).value(site)
                          '''-----------------UFP-----------------
                          ElseIf LCase(ids_range_ary(i).ChanMapType) = "vs-800ma" Then
                                TheExec.Datalog.WriteComment "Site(" & site & "), " & ids_range_ary(i).PinName & ", Step 0 " & ", Irange: " & TheHdw.DCVS.Pins(ids_range_ary(i).PinName).CurrentRange.value & ", Current: " & UFP_Power_data.Pins(ids_range_ary(i).PinName).value(site)
                          ElseIf LCase(ids_range_ary(i).ChanMapType) = "vs-5a" Then
                                TheExec.Datalog.WriteComment "Site(" & site & "), " & ids_range_ary(i).PinName & ", Step 0 " & ", Irange: " & TheHdw.DCVS.Pins(ids_range_ary(i).PinName).CurrentRange.value & ", Current: " & UFP_Power_data.Pins(ids_range_ary(i).PinName).value(site)
                          '''-----------------UFP-----------------
                          Else
                            'Do nothing -- 20230531
                          End If
                    Next site
                End If
            Next i
        End If
        '-------------------------------------------
    End If
          
    Dim p_vsm_autorRange As String
    Dim A_vsm_autorRange() As String
    Dim VSM_Power_data_AutoRange As New PinListData

    Dim p_hexvs_autorRange As String
    Dim A_hexvs_autorRange() As String
    Dim HexVS_Power_data_AutoRange As New PinListData

    Dim p_uvs256_autorRange As String
    Dim A_uvs256_autorRange() As String
    Dim UVS256_Power_data_AutoRange As New PinListData

    '''-----------------UFP-----------------
    Dim p_ufp_autorRange As String
    Dim A_UFP_autorange() As String
    Dim UFP_Power_data_AutorRange As New PinListData
    '''-----------------UFP-----------------

    Dim Flag_PerPin_autorange As Boolean
    Dim Flag_AllPin_autorange As Boolean
''    Dim LargerThanAmpSite As New SiteBoolean
    
    Dim StepNo As Long
    Dim PinVal As New PinData
    Dim DropRngSite As New SiteBoolean
    Dim AutoRangePin_Ary() As String
    Dim AutoRangePin_Cnt As Long

    If TheExec.Flow.enableWord("CurrentProfile") Or TheExec.Flow.enableWord("VoltageProfile") Or Profile_byflow = True Then

    Else
        If bAutoRange Then
            ''****Start -  Set Auto IRange ****
            If sAutoRange_Pin = "" Then sAutoRange_Pin = sMeasPin
            TheExec.DataManager.DecomposePinList sAutoRange_Pin, AutoRangePin_Ary, AutoRangePin_Cnt
            For i = 0 To UBound(AutoRangePin_Ary)
                For k = 0 To UBound(ids_range_ary)
                    If LCase(AutoRangePin_Ary(i)) = LCase(ids_range_ary(k).PinName) Then
                        If LCase(ids_range_ary(k).ChanMapType) = "vsm" Then
                            p_vsm_autorRange = p_vsm_autorRange & "," & AutoRangePin_Ary(i)
                        ElseIf LCase(ids_range_ary(k).ChanMapType) = "vhdvs" Then
                            p_uvs256_autorRange = p_uvs256_autorRange & "," & AutoRangePin_Ary(i)
                        ElseIf LCase(ids_range_ary(k).ChanMapType) = "hexvs" Then
                            p_hexvs_autorRange = p_hexvs_autorRange & "," & AutoRangePin_Ary(i)
                        '''-----------------UFP-----------------
                        ElseIf LCase(ids_range_ary(k).ChanMapType) = "vs-800ma" Then
                            p_ufp_autorRange = p_ufp_autorRange & "," & AutoRangePin_Ary(i)
                        ElseIf LCase(ids_range_ary(k).ChanMapType) = "vs-5a" Then
                            p_ufp_autorRange = p_ufp_autorRange & "," & AutoRangePin_Ary(i)
                         '''-----------------UFP-----------------
                        Else
                            'Do nothing -- 20230531
                        End If
                        Exit For
                    End If
                Next k
            Next i
            
            If p_vsm_autorRange <> "" Then
                p_vsm_autorRange = right(p_vsm_autorRange, Len(p_vsm_autorRange) - 1)
                A_vsm_autorRange = Split(p_vsm_autorRange, ",")
                VSM_Power_data_AutoRange = VSM_Power_data
            End If

            If p_uvs256_autorRange <> "" Then
                p_uvs256_autorRange = right(p_uvs256_autorRange, Len(p_uvs256_autorRange) - 1)
                A_uvs256_autorRange = Split(p_uvs256_autorRange, ",")
                UVS256_Power_data_AutoRange = UVS_Power_data
            End If

            If p_hexvs_autorRange <> "" Then
                p_hexvs_autorRange = right(p_hexvs_autorRange, Len(p_hexvs_autorRange) - 1)
                A_hexvs_autorRange = Split(p_hexvs_autorRange, ",")
                HexVS_Power_data_AutoRange = HexVS_Power_data
            End If

            '''-----------------UFP-----------------
            If p_ufp_autorRange <> "" Then
                p_ufp_autorRange = right(p_ufp_autorRange, Len(p_ufp_autorRange) - 1)
                A_UFP_autorange = Split(p_ufp_autorRange, ",")
                UFP_Power_data_AutorRange = UFP_Power_data
            End If
            '''-----------------UFP-----------------
            dWaitTime = 260 * us
            For j = 1 To lAutoRange_Step
                For i = 0 To UBound(AutoRangePin_Ary)
                    Flag_PerPin_autorange = False

                    For k = 0 To UBound(ids_range_ary)
                        If LCase(AutoRangePin_Ary(i)) = LCase(ids_range_ary(k).PinName) Then
                            If LCase(ids_range_ary(k).ChanMapType) = "vsm" Then
                                PinVal = VSM_Power_data_AutoRange.Pins(AutoRangePin_Ary(i)).Abs
                            ElseIf LCase(ids_range_ary(k).ChanMapType) = "vhdvs" Then
                                PinVal = UVS256_Power_data_AutoRange.Pins(AutoRangePin_Ary(i)).Abs
                            ElseIf LCase(ids_range_ary(k).ChanMapType) = "hexvs" Then
                                PinVal = HexVS_Power_data_AutoRange.Pins(AutoRangePin_Ary(i)).Abs
                            '''-----------------UFP-----------------
                            ElseIf LCase(ids_range_ary(k).ChanMapType) = "vs-800ma" Then
                                PinVal = UFP_Power_data_AutorRange.Pins(AutoRangePin_Ary(i)).Abs
                            ElseIf LCase(ids_range_ary(k).ChanMapType) = "vs-5a" Then
                                PinVal = UFP_Power_data_AutorRange.Pins(AutoRangePin_Ary(i)).Abs
                            '''-----------------UFP-----------------
                            Else
                                'Do nothing -- 20230531
                            End If

                            StepNo = ids_range_ary(k).Init_step - j
                            If StepNo >= 0 Then
                                If ids_range_ary(k).Range_List(StepNo) >= 0.0002 Then
                                    DropRngSite = PinVal.compare(LessThan, (ids_range_ary(k).Range_List(StepNo) * 0.8) - ids_range_ary(k).Accuracy_List(StepNo + 1))
                                    If DropRngSite.Any(True) Then
                                        Flag_PerPin_autorange = True
                                        TheExec.sites.Selected = DropRngSite
                                        TheHdw.DCVS.Pins(AutoRangePin_Ary(i)).SetCurrentRanges ids_range_ary(k).Range_List(StepNo), ids_range_ary(k).Range_List(StepNo)
                                        TheExec.sites.Selected = True
                                        dSattleTime = ids_range_ary(k).WaitTime_List(StepNo)
                                        If dSattleTime > dWaitTime Then dWaitTime = dSattleTime
                                    End If
                                End If
                            End If
                            Exit For
                        End If
                    Next k
                      
                    Set PinVal = Nothing
                    Flag_AllPin_autorange = Flag_AllPin_autorange Or Flag_PerPin_autorange
                Next i
                If Flag_AllPin_autorange Then
                    TheHdw.Wait dWaitTime
                    ''Add measurement points to prevent error 20171011 (M9)
                    If p_hexvs_autorRange <> "" Then HexVS_Power_data_AutoRange = TheHdw.DCVS.Pins(p_hexvs_autorRange).Meter.Read(tlStrobe, 10, , tlDCVSMeterReadingFormatAverage)
                    If p_uvs256_autorRange <> "" Then UVS256_Power_data_AutoRange = TheHdw.DCVS.Pins(p_uvs256_autorRange).Meter.Read(tlStrobe, 1, , tlDCVSMeterReadingFormatAverage)
                    If p_vsm_autorRange <> "" Then VSM_Power_data_AutoRange = TheHdw.DCVS.Pins(p_vsm_autorRange).Meter.Read(tlStrobe, 10, , tlDCVSMeterReadingFormatAverage)
                    '''-----------------UFP-----------------
                    If p_ufp_autorRange <> "" Then UFP_Power_data_AutorRange = TheHdw.DCVS.Pins(p_ufp_autorRange).Meter.Read(tlStrobe, 10, , tlDCVSMeterReadingFormatAverage)
                    '''-----------------UFP-----------------
                    
                    '-------------------------------------------debug print
                    ''            sDebugPrint = AutoRange_Pin
                    If sDebugPrint <> "" Then
                        TheExec.Datalog.WriteComment "-----> Step " & j & " Current Range Setup"
                        For i = 0 To UBound(AutoRangePin_Ary)
                            For k = 0 To UBound(ids_range_ary)
                                If UCase(AutoRangePin_Ary(i)) = UCase(ids_range_ary(k).PinName) Then
                                    If InStr(LCase(sDebugPrint_Temp), LCase(ids_range_ary(k).PinName)) > 0 Then
                                        For Each site In TheExec.sites
                                            If LCase(ids_range_ary(k).ChanMapType) = "hexvs" Then
                                                TheExec.Datalog.WriteComment "Site(" & site & "), " & ids_range_ary(k).PinName & ", Step " & j & ", Irange: " & TheHdw.DCVS.Pins(ids_range_ary(k).PinName).Meter.CurrentRange.value & ", Current: " & HexVS_Power_data_AutoRange.Pins(ids_range_ary(k).PinName).value(site)
                                            ElseIf LCase(ids_range_ary(k).ChanMapType) = "vhdvs" Then
                                                TheExec.Datalog.WriteComment "Site(" & site & "), " & ids_range_ary(k).PinName & ", Step " & j & ", Irange: " & TheHdw.DCVS.Pins(ids_range_ary(k).PinName).CurrentRange.value & ", Current: " & UVS256_Power_data_AutoRange.Pins(ids_range_ary(k).PinName).value(site)
                                            ElseIf LCase(ids_range_ary(k).ChanMapType) = "vsm" Then
                                                TheExec.Datalog.WriteComment "Site(" & site & "), " & ids_range_ary(k).PinName & ", Step " & j & ", Irange: " & TheHdw.DCVS.Pins(ids_range_ary(k).PinName).CurrentRange.value & ", Current: " & VSM_Power_data_AutoRange.Pins(ids_range_ary(k).PinName).value(site)
                                            '''-----------------UFP-----------------
                                            ElseIf LCase(ids_range_ary(k).ChanMapType) = "vs-800ma" Then
                                                TheExec.Datalog.WriteComment "Site(" & site & "), " & ids_range_ary(k).PinName & ", Step " & j & ", Irange: " & TheHdw.DCVS.Pins(ids_range_ary(k).PinName).CurrentRange.value & ", Current: " & UFP_Power_data_AutorRange.Pins(ids_range_ary(k).PinName).value(site)
                                            ElseIf LCase(ids_range_ary(k).ChanMapType) = "vs-5a" Then
                                                TheExec.Datalog.WriteComment "Site(" & site & "), " & ids_range_ary(k).PinName & ", Step " & j & ", Irange: " & TheHdw.DCVS.Pins(ids_range_ary(k).PinName).CurrentRange.value & ", Current: " & UFP_Power_data_AutorRange.Pins(ids_range_ary(k).PinName).value(site)
                                            '''-----------------UFP-----------------
                                            Else
                                                'Do nothing -- 20230531
                                            End If
                                        Next site
                                    End If
                                End If
                            Next k
                        Next i
                    End If
                    '-------------------------------------------
                    Flag_AllPin_autorange = False
                Else
                    j = lAutoRange_Step
                End If
            Next j
        ''****End -  Set Auto IRange ****
        End If
    End If
    
    
    Exit Function

errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "DCVS_MeasureCurrent_AutoRange") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function RegAssign_PatBurstReConstruction(ByVal RegAssign_Input As String, ByVal RegAssign_Keyword) As String
On Error GoTo errHandler 'Add ErrHandler 2023/05/29

    Dim funcName As String:: funcName = "RegAssign_PatBurstReConstruction"

    Dim i As Long
    
    Dim sAry() As String
    Dim SplitInstance() As String
    
    If InStr(RegAssign_Input, "|") <> 0 Then
        sAry = Split(RegAssign_Input, "|")
        For i = 0 To UBound(sAry)
            SplitInstance = Split(sAry(i), ":")
            If i = 0 Then
                If sAry(i) <> "" Then
                    'DigSrc_FlowForLoopIntegerName = RegDict(LCase("FlowForLoopInteger_" & SplitInstance(1)))
                    If UCase(sAry(i)) Like "*REG_ASSIGN*" Then
                        RegAssign_Input = RegDict(LCase(RegAssign_Keyword & SplitInstance(1)))
                    Else
                        RegAssign_Input = sAry(i)
                    End If
                Else
                    RegAssign_Input = vbNullString
                End If
            Else
                If sAry(i) <> "" Then
                    If UCase(sAry(i)) Like "*REG_ASSIGN*" Then
                        RegAssign_Input = RegAssign_Input & "|" & RegDict(LCase(RegAssign_Keyword & SplitInstance(1)))
                    Else
                        RegAssign_Input = RegAssign_Input & "|" & sAry(i)
                    End If
                Else
                    RegAssign_Input = RegAssign_Input & "|" & vbNullString
                End If
            End If
        Next i
    Else
        SplitInstance = Split(RegAssign_Input, ":")
        RegAssign_Input = RegDict(LCase(RegAssign_Keyword & SplitInstance(1)))
    End If
    
    RegAssign_PatBurstReConstruction = RegAssign_Input
    Exit Function

errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "RegAssign_PatBurstReConstruction") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Private Function ProcessAssignmentSrccode(RegAssignArr() As Variant, StartCol As Long, MaxRow As Long, maxcol As Long, ConnectValStr As String, ConnectRegStr As String, TypeName As String, Optional SkipCheckCol As Boolean = False)
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
' Edited by Dylan 2019/12/04
    Dim funcName As String:: funcName = "ProcessAssignmentSrccode"
'DigSrc_FlowForLoopIntegerName: SrcCodeIndx;sdll_sel_dck:7:0:1|SrcCodeIndx1;sdll_sel_ck:10:800:1
If StartCol = maxcol Then Exit Function 'No Data inside

Dim i As Long
Dim j As Long
Dim k As Long

Dim TestNumber As Long
Dim RegisterNumber As Long

Dim Valid_ColNumber As Long
Dim tempStrArr As String

Dim TempCol As Long

Dim BlankRegAssignInfo As RegAssignInfo
RegAssignInfo = BlankRegAssignInfo

RegAssignInfo.TypeName = TypeName
Dim sSrcName As String
    For i = 3 To MaxRow
    
        If (RegAssignArr(i, StartCol + 1) = "") And (RegAssignArr(i, StartCol + 2) = "") Then
            Exit For
        ElseIf (RegAssignArr(i, StartCol + 1) <> "") And (RegAssignArr(i, StartCol + 2) <> "") Then
            sSrcName = RegAssignArr(i, StartCol + 1)
            tempStrArr = RegAssignArr(i, StartCol + 2)
            tempStrArr = Replace(tempStrArr, """", vbNullString) ' For Execl Bug 20200227
        ElseIf (RegAssignArr(i, StartCol + 1) = "") And (RegAssignArr(i, StartCol + 2) <> "") Then
            tempStrArr = RegAssignArr(i, StartCol + 2)
            tempStrArr = Replace(tempStrArr, """", vbNullString) ' For Execl Bug 20200227
        Else
            'Do nothing -- 20230531
        End If
''
        If sSrcName <> "" Then
            If LCase(RegAssignArr(i, StartCol + 1)) = LCase(sSrcName) Then
                RegisterNumber = 0
                ReDim Preserve RegAssignInfo.ByTest(TestNumber) As ByTest
                ReDim Preserve RegAssignInfo.ByTest(TestNumber).RegAssign(RegisterNumber) As RegAssign
                ReDim Preserve RegAssignInfo.ByTest(TestNumber).RtnByMode(0) As String

                RegAssignInfo.ByTest(TestNumber).RtnByMode(0) = RegAssignInfo.ByTest(TestNumber).RtnByMode(0) & ConnectRegStr & sSrcName & ConnectValStr & tempStrArr   ''Join(TempStrArr, ConnectValStr)
            ElseIf LCase(RegAssignArr(i, StartCol + 1)) = "" Then
                RegAssignInfo.ByTest(TestNumber).RtnByMode(0) = RegAssignInfo.ByTest(TestNumber).RtnByMode(0) & ConnectValStr & tempStrArr
            Else
                'Do nothing -- 20230531
            End If
        End If
        If (RegAssignArr(i, StartCol) <> "") Then RegAssignInfo.ByTest(TestNumber).TestName = RegAssignArr(i, StartCol)
    Next i
    
    If InStr(RegAssignInfo.ByTest(TestNumber).RtnByMode(0), "|") = 1 Then RegAssignInfo.ByTest(TestNumber).RtnByMode(0) = mid(RegAssignInfo.ByTest(TestNumber).RtnByMode(0), 2)
    
    Call StoredRegAssign
    
    Exit Function

errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "ProcessAssignmentSrccode") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function Select_forcecondition(src_string As String, ByVal job As String) As String
On Error GoTo errHandler 'Add ErrHandler 2023/05/29

    Dim src_str_array() As String

    If job = "" Then job = "CP1"
    
    If Not (((UCase(src_string) Like "*CP*=*") Or (UCase(src_string) Like "*FT*=*"))) Then Select_forcecondition = src_string
    
    If Not (((UCase(job) Like "*CP*") Or (UCase(job) Like "*FT*"))) Then job = "CP1"
    
    If (UCase(job) Like "*CP*") Then job = "CP"
    If (UCase(job) Like "*FT*") Then job = "FT"
    
    src_str_array = Split(src_string, "$$")
    
    Dim var As Variant
    
    For Each var In src_str_array
    
        If (UCase(var) Like UCase(job) & "*") Then
            
            Select_forcecondition = Split(var, "=")(1)
            Exit For
            
        End If
    Next var

Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "Select_forcecondition") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function
