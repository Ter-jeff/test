        For TempCnt_PinGroup = 0 To PinGroupCnt
        
            TempPinGroupString = vbNullString
            For TempCnt_Pin = 0 To PinNumPerMeas - 1
                TempCnt = TempCnt_PinGroup * PinNumPerMeas + TempCnt_Pin
                If TempCnt >= PinArrayCnt Then
