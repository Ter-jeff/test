Public Function HardIP_Vdiff2_PPMU() As Long
On Error GoTo errHandler
'[20240207][All][Brian] Support Vdiff2 in universal
    Dim MeasI As Meas_Type
    MeasI = TestConditionSeqData(Instance_Data.TestSeqNum).MeasI(Instance_Data.TestSeqSweepNum)

    
    glb_TestInstance = ""
    glb_TestInstance = UCase(TheExec.DataManager.instancename)
    

    Dim i As Long, k As Long, j As Long
    Dim testnum As Long
    Dim TestNumber As Long
    Dim HighLimitVal() As Double
    Dim LowLimitVal() As Double
    Dim Idiff As New SiteDouble, Vdiff As New SiteDouble, Vocm As New SiteDouble
    Dim TxVDD As New SiteDouble, TxVss As New SiteDouble
    Dim MeasIp1 As New PinListData
    Dim MeasIp2 As New PinListData
    Dim MeasIn1 As New PinListData
    Dim MeasIn2 As New PinListData
    Dim MeasVdiff As New PinListData
    Dim MeasVocm As New PinListData
    Dim ForceV1pAry As String
    Dim ForceV2pAry As String
    Dim ForceV1nAry As String
    Dim ForceV2nAry As String
    Dim Zp As New SiteDouble
    Dim Zn As New SiteDouble
    Dim TestNameInput As String
    Dim OutputTname_format() As String
    Dim TestPinArrayP As String, TestPinArrayN As String
    Dim pin As Variant
    ''Defined for TTR
    Dim DiffPins As New PinList
    Dim TName_Ary() As String
    Dim Tname As String
    '----180524----------------------------------------------------------------
    Call GetFlowTName
    Dim Pins() As String
    Dim Pins_P As String
    Dim Pins_N As String
    Dim per_pin As Variant
    Dim site As Variant 'Carter, 20240304
    DiffPins = MeasI.Pins.PPMU ' PpmuMeasureP_Pin & "," & PpmuMeasureN_Pin
                                                                                                                                                                                                                                             
    Pins() = Split(MeasI.Pins.PPMU, ",")
    Pins_P = Pins(0)
    Pins_N = Pins(1)
    
    TestPinArrayP = ""
    TestPinArrayN = ""
        
    TestPinArrayP = Pins(0)
    TestPinArrayN = Pins(1)
    If InStr(TestPinArrayP, "_P") = 0 Then
        TheExec.Datalog.WriteComment "Warning : Please check wheather Pin < " & TestPinArrayP & " > is P Pin !!"
    End If
    If InStr(TestPinArrayN, "_N") = 0 Then
        TheExec.Datalog.WriteComment "Warning : Please check wheather Pin < " & TestPinArrayN & " > is N Pin !!"
    End If
    
        ForceV1pAry = CDbl(MeasI.Setup_ByTypeByPin.PPMU(0).ForceValue1)
        ForceV2pAry = CDbl(MeasI.Setup_ByTypeByPin.PPMU(0).ForceValue2)
        ForceV1nAry = CDbl(MeasI.Setup_ByTypeByPin.PPMU(1).ForceValue3)
        ForceV2nAry = CDbl(MeasI.Setup_ByTypeByPin.PPMU(1).ForceValue4)
    
    Call GetFlowSingleUseLimit(HighLimitVal, LowLimitVal)  ''20141219
    Instance_Data.Is_PreCheck_Func = False
    
    For Each site In TheExec.sites.Active: testnum = TheExec.sites.item(site).TestNumber: Exit For: Next site
    TheHdw.Digital.Pins(Replace(DiffPins, "+", ",")).Disconnect
     
    With TheHdw.PPMU.Pins(TestPinArrayP)
         .ForceV ForceV1pAry
    ''   .ClampVHi = 2
         .ClampVHi = pc_Def_PPMU_ClampVHi
         .Connect
         .Gate = tlOn
    End With
     'Update PinName datalogging, From C-Chop, 20200423, Oscar
    If TheExec.TesterMode = testModeOffline Then
        TheExec.Datalog.WriteComment "PinName : " & CStr(TestPinArrayP) & " , ForceV1p : " & CStr(Format(ForceV1pAry, "0.000"))
    Else
        TheExec.Datalog.WriteComment "PinName : " & CStr(TestPinArrayP) & " , ForceV1p : " & CStr(Format(TheHdw.PPMU.Pins(TestPinArrayP).Voltage.value, "0.000"))
    End If
    
     With TheHdw.PPMU.Pins(TestPinArrayN)
         .ForceV ForceV1nAry
    ''   .ClampVHi = 2
         .ClampVHi = pc_Def_PPMU_ClampVHi
         .Connect
         .Gate = tlOn
     End With
     'Update PinName datalogging, From C-Chop, 20200423, Oscar
    If TheExec.TesterMode = testModeOffline Then
        TheExec.Datalog.WriteComment "PinName : " & CStr(TestPinArrayN) & " , ForceV1n : " & CStr(Format(ForceV1nAry, "0.000"))
    Else
        TheExec.Datalog.WriteComment "PinName : " & CStr(TestPinArrayN) & " , ForceV1n : " & CStr(Format(TheHdw.PPMU.Pins(TestPinArrayN).Voltage.value, "0.000"))
    End If
      
     TheHdw.Wait 0.001
     DebugPrintFunc_PPMU CStr(TestPinArrayP)
     MeasIp1 = TheHdw.PPMU.Pins(TestPinArrayP).Read(tlPPMUReadMeasurements, pc_Def_PPMU_ReadPoint)
     DebugPrintFunc_PPMU CStr(TestPinArrayN)
     MeasIn1 = TheHdw.PPMU.Pins(TestPinArrayN).Read(tlPPMUReadMeasurements, pc_Def_PPMU_ReadPoint)
      
     TheHdw.PPMU.Pins(TestPinArrayP).ForceV ForceV2pAry
     TheHdw.PPMU.Pins(TestPinArrayN).ForceV ForceV2nAry
     TheHdw.Wait 0.001
     'Update PinName datalogging, From C-Chop, 20200423, Oscar
    If TheExec.TesterMode = testModeOffline Then
        TheExec.Datalog.WriteComment "PinName : " & CStr(TestPinArrayP) & " , ForceV2p : " & CStr(Format(ForceV2pAry, "0.000"))
    Else
        TheExec.Datalog.WriteComment "PinName : " & CStr(TestPinArrayP) & " , ForceV2p : " & CStr(Format(TheHdw.PPMU.Pins(TestPinArrayP).Voltage.value, "0.000"))
    End If
    If TheExec.TesterMode = testModeOffline Then
        TheExec.Datalog.WriteComment "PinName : " & CStr(TestPinArrayN) & " , ForceV2n : " & CStr(Format(ForceV2nAry, "0.000"))
    Else
        TheExec.Datalog.WriteComment "PinName : " & CStr(TestPinArrayN) & " , ForceV2n : " & CStr(Format(TheHdw.PPMU.Pins(TestPinArrayN).Voltage.value, "0.000"))
    End If
      
     DebugPrintFunc_PPMU CStr(TestPinArrayP)
     MeasIp2 = TheHdw.PPMU.Pins(TestPinArrayP).Read(tlPPMUReadMeasurements, pc_Def_PPMU_ReadPoint)
     DebugPrintFunc_PPMU CStr(TestPinArrayN)
     MeasIn2 = TheHdw.PPMU.Pins(TestPinArrayN).Read(tlPPMUReadMeasurements, pc_Def_PPMU_ReadPoint)
    
    ''''---------Offline---------
    If TheExec.TesterMode = testModeOffline Then
        For Each site In TheExec.sites
            MeasIp1 = (0.29) + 0.01 * Rnd(0.1)
            MeasIn1 = (0.29) + 0.01 * Rnd(0.1)
            MeasIp2 = (0.29) + 0.01 * Rnd(0.1)
            MeasIn2 = (0.29) + 0.01 * Rnd(0.1)
        Next site
    End If
    ''''---------Offline---------
     
     MeasVdiff = MeasIp1
     MeasVocm = MeasIp1
     
     Dim RAKVal_p As Double
     Dim RAKVal_n As Double
      
     For Each site In TheExec.sites
         For i = 0 To MeasIp1.Pins.Count - 1
             
             If (MeasIp1.Pins(i).value(site) - MeasIp2.Pins(i).value(site)) = 0 Then MeasIp1.Pins(i).value(site) = MeasIp1.Pins(i).value(site) + 0.000000001
             If (MeasIn1.Pins(i).value(site) - MeasIn2.Pins(i).value(site)) = 0 Then MeasIn1.Pins(i).value(site) = MeasIn1.Pins(i).value(site) + 0.000000001
            
             Zp(site) = (CDbl(ForceV1pAry) - CDbl(ForceV2pAry)) / (MeasIp1.Pins(i).value(site) - MeasIp2.Pins(i).value(site))
             Zn(site) = (CDbl(ForceV1nAry) - CDbl(ForceV2nAry)) / (MeasIn1.Pins(i).value(site) - MeasIn2.Pins(i).value(site))
             TxVDD(site) = CDbl(ForceV2pAry) + Zp(site) * MeasIp2.Pins(i).value(site) * (-1)
             TxVss(site) = ForceV2nAry - Zn(site) * MeasIn2.Pins(i).value(site)
             
             RAKVal_p = (CurrentJob_Card_RAK.Pins(MeasIp1.Pins(i)).value(site))
             RAKVal_n = (CurrentJob_Card_RAK.Pins(MeasIn1.Pins(i)).value(site))
             
             Idiff(site) = (TxVDD(site) - TxVss(site)) / (Zp(site) - (RAKVal_p) + 100 + Zn(site) - (RAKVal_n))
             Vdiff(site) = Abs((TxVDD(site) - (Zp(site) - RAKVal_p) * Idiff(site)) - (TxVss(site) + (Zn(site) - RAKVal_n) * Idiff(site)))
             Vocm(site) = 0.5 * ((TxVDD(site) - (Zp(site) - RAKVal_p) * Idiff(site)) + (TxVss(site) + (Zn(site) - RAKVal_n) * Idiff(site)))
             
             MeasVdiff.Pins(i).value = Vdiff(site)
             MeasVocm.Pins(i).value = Vocm(site)
    
         Next i
     Next site
        
     For Each site In TheExec.sites.Active: testnum = TheExec.sites.item(site).TestNumber: Exit For: Next site
     
     '' Added TestLimitPerPin 20170814
     Dim p As Long
    
     For p = 0 To MeasVdiff.Pins.Count - 1
         TestNameInput = Report_TName_From_Instance("Vdiff", MeasVdiff.Pins(p), , , p)
         theexec.Flow.TestLimit MeasVdiff.Pins(p), , , scaletype:=scaleNone, unit:=unitVolt, formatStr:="%.3f", Tname:=TestNameInput, ForceUnit:=unitAmp, ForceResults:=tlForceFlow                 
     Next p
     If UCase(Instance_Data.CUS_Str_MainProgram) = "VOCM" Then
         For p = 0 To MeasVocm.Pins.Count - 1
             TestNameInput = Report_TName_From_Instance("Vocm", MeasVocm.Pins(p), , , p)
             TheExec.Flow.TestLimit MeasVocm.Pins(p), , , scaletype:=scaleNone, unit:=unitVolt, formatStr:="%.3f", Tname:=TestNameInput, ForceUnit:=unitAmp, ForceResults:=tlForceFlow
         Next p
     End If
     If TheExec.sites.Active.Count = 0 Then Exit Function

    ''Comment by Martin for TTR
    TheHdw.PPMU.Pins(Replace(DiffPins, "+", ",")).ForceV pc_Def_PPMU_InitialValue_FI
    TheHdw.PPMU.Pins(Replace(DiffPins, "+", ",")).Gate = tlOff
    TheHdw.PPMU.Pins(Replace(DiffPins, "+", ",")).Disconnect
    TheHdw.Digital.Pins(Replace(DiffPins, "+", ",")).Connect
      
    If Instance_Data.Meas_StoreName_Flag Then
        Dim DicStoreName As String
        DicStoreName = TestConditionSeqData(Instance_Data.TestSeqNum).Meas_StoreDicName(Instance_Data.TestSeqSweepNum)
        Call StoreDataAllType(DicStoreName, MeasVdiff)
    End If      
    
    TheHdw.Alarms.Check

    Exit Function
                                                                                                                                                                                                                                                               
errHandler:
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_Vdiff2_PPMU")
    If AbortTest Then Exit Function Else Resume Next
End Function


Public Function MTR_Coefficient_Parsing() As Long
    'Use for MTR_TSNS and MTR_BTS Coefficient calculate function -- 20230103
    'Parsing "MTR_Coefficient_Table" to get all of parameter for post calculate function use
    'Use function as below:
    '-- Calc_MetrologyTMPS_Coefficients
    '-- Calc_MetrologyTMPS_Coefficients_N3
    '-- Calc_MetrologyBTS_Coefficient
    '-- Calc_MetrologyBTS_Coefficient_10b_N3
    '-- Calc_MetrologyBTS_Coefficient_10b_N3
    '-- Calc_MetrologyDCTS_C0_Coefficients  (New)
    
    On Error GoTo errHandler:
    If glb_MTR_COEFF_PARSING_Flag = True Then Exit Function                     'Update parsing one times ------20230525
    
    Dim sheetName As String
    Dim ws_def As Worksheet
    Dim wb As Workbook
    Dim MaxRow As Long
    Dim maxcol As Long
    Dim isSheetFound As Boolean
    Dim iRow As Long
    Dim iCol As Long
    Dim i As Long
    Dim BKM_DataAry As Variant
    Dim vsite As Variant
    Dim BKM_CODE As String
    Dim MTR_TYPE As String
    
    Dim Parsing_Indx As Long: Parsing_Indx = 0
    
    '''*****************************************************************'''
    sheetName = "MTR_Coefficient_Table"
    Set wb = Application.ActiveWorkbook
    Call check_Sheet_Range(sheetName, wb, ws_def, MaxRow, maxcol, isSheetFound, False)           'Max row reference Column:G (Ratio_of_RAK)
    '''*****************************************************************'''
    If isSheetFound Then
        Application.ScreenUpdating = False
        
        BKM_DataAry = ws_def.range(Cells(1, 1), Cells(MaxRow, maxcol))

        MTR_COEFF_INFO_DICT.RemoveAll       'Reset Dictionary information
        For iCol = 1 To maxcol
            For iRow = 1 To MaxRow
                If BKM_DataAry(iRow, iCol) = "" Then
                    Exit For
                Else
                    If iRow = 1 Then
                        MTR_TYPE = BKM_DataAry(iRow, iCol)
                    ElseIf iRow = 2 Then
                        BKM_CODE = BKM_DataAry(iRow, iCol + 1)
                        Call MTR_COEFF_INFO_DICT.Add(MTR_TYPE & "_" & BKM_CODE, "Dummy")
                    Else
                        Call MTR_COEFF_INFO_DICT.Add(UCase(MTR_TYPE & "_" & BKM_CODE & "_" & UCase(BKM_DataAry(iRow, iCol))), BKM_DataAry(iRow, iCol + 1))      'Store BKM to Dictionary
                    End If
                End If
            Next iRow
        Next iCol
        Application.ScreenUpdating = True
        glb_MTR_COEFF_PARSING_Flag = True   'Update parsing one times -- 20230214
    End If
   
    Exit Function
errHandler:
    TheExec.Datalog.WriteComment "<Error> " + "MTR_Coefficient_Parsing" + ":: please check it out."
    If AbortTest Then Exit Function Else Resume Next
End Function

