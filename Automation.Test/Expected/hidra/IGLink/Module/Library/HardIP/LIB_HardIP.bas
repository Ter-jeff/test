Public Function HardIP_Special_Binout() As Boolean
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    
    
    Dim tableparsing As Variant
    Dim Row As Integer
    Dim cnt As Integer
    Dim tempKey As String
    Dim temppatset As String
    Dim TempPat() As String
    Dim PatCnt As Long
    gl_patflag_Dic.RemoveAll
    gl_Instpatcount_Dic.RemoveAll
    
    ' check sheet exit or not
    If Not Evaluate("ISREF('" & "HardIP_PatternBurst_Binout" & "'!A1)") Then Exit Function
    
    Application.ScreenUpdating = False  'Update for table parsing -- 20230531
    
    ' 1. parsing table
    With ThisWorkbook.Sheets("HardIP_PatternBurst_Binout")
        ' 1.1 pasing sheet
        tableparsing = .range("A1:" + Split(.Cells(1, .UsedRange.Columns.Count).Address, "$")(1) + CStr(.UsedRange.Rows.Count))
        ' 1.2 add dictionary
        For Row = 2 To UBound(tableparsing)
            ' 1.2.1 set default key and patset
            If Row = 2 Then
                tempKey = tableparsing(Row, 1)
                temppatset = tableparsing(Row, 2)
                cnt = -1 ' avoid first row count
            End If
            ' 1.2.2 Store Inst and pattern count if instance name exits
            If tableparsing(Row, 1) <> "" And Row <> 2 Then
                 gl_Instpatcount_Dic.Add LCase(tempKey), cnt + 1
                 Call checkpatcnt(cnt + 1, temppatset) ' Check if pattern count in table same as in patset sheet
                 tempKey = tableparsing(Row, 1)
                 temppatset = tableparsing(Row, 2)
                 cnt = 0
            Else
                cnt = cnt + 1  ' counting pattern
            End If
            ' 1.2.3 store pattern and relative flag
            TempPat = TheExec.DataManager.Raw.GetPatternsInSet(tableparsing(Row, 3), PatCnt)
            TempPat(0) = LCase(TempPat(0) + Split(tempKey, "_")(UBound(Split(tempKey, "_"))))
            If tableparsing(Row, 4) <> "" And Not (gl_patflag_Dic.Exists(TempPat(0))) Then gl_patflag_Dic.Add TempPat(0), tableparsing(Row, 4)
        Next Row
        
        Application.ScreenUpdating = True   'Update for table parsing -- 20230531
        
        ' 1.2.4 add the last instance
        gl_Instpatcount_Dic.Add LCase(tempKey), cnt + 1
        Call checkpatcnt(cnt + 1, temppatset) ' Check if pattern count in table same as in patset sheet
    End With
 
    Exit Function

errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_Special_Binout") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

