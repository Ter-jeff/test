            Call Print_Error_Message(Warning_Info, "LIB_HardIP", "Reg_Assign_Processing", "REG table not found!!! Please check CUS_Str_MainProgram REG table and argument!!!")
        End If
    End If
        
    If UCase(DigSrc_FlowForLoopIntegerName) Like "*REG_ASSIGN*" Then
        DigSrc_FlowForLoopIntegerName = RegAssign_PatBurstReConstruction(DigSrc_FlowForLoopIntegerName, "FlowForLoopInteger_")

    End If
        'For String Exceeds 8000, From Tonga, 20200423, Oscar
    If mid(CUS_Str_DigSrcData, 1, 1) = "+" Then
        DigSrc_Equation = DigSrc_Equation + CUS_Str_DigSrcData
        CUS_Str_DigSrcData = vbNullString
    ElseIf mid(CUS_Str_DigSrcData, 1, 1) = "-" Then
        Calc_Eqn = Calc_Eqn + mid(CUS_Str_DigSrcData, 2)
        CUS_Str_DigSrcData = vbNullString
    ElseIf mid(CUS_Str_DigSrcData, 1, 1) = "," Then
        CUS_Str_DigCapData = CUS_Str_DigCapData + CUS_Str_DigSrcData
        CUS_Str_DigSrcData = vbNullString
    Else
        'Do nothing -- 20230531
    End If

Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "Reg_Assign_Processing") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function
Public Function Process_DSSC_Dictionary()   ' Edited by Dylan 2019/12/04
