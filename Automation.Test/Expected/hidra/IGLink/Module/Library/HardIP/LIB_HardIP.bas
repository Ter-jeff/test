Public Function HardIP_RAK_Init(Optional checkRakError As Boolean = False) As Long
    '' 20151029 - Compensate DIB impedence for RAK
On Error GoTo ErrorHandler
    Dim i As Long
    Dim j As Long
    Dim wbAry() As Variant
    Dim siteIndex As Integer
    Dim Start_SiteNum As Long
    Dim Stop_SiteNum As Long
    Dim typeCol As Long
    Dim maxcol As Long
    Dim MaxRow As Long
    Dim RAKSheet As String
    Dim PinsNum As Long
    Dim StartRows As Long
    Dim RakV() As Double
    Dim Factor_Idx As Double
    Dim ErrorMsg As String
    
    'Filter "CHANNELMAP_" key word with short sheet name -- 20220913
    RAKSheet = "RAK_" & Replace(UCase(CurrentChannelMap), "CHANNELMAP_", "")
    
    If checkRakError Then
        If glsRAKerrMsg <> "" Then
            TheExec.Datalog.WriteComment vbCrLf + RepeatChr("*", 22) + "HardIP_RAK_Init" + RepeatChr("*", 23)
            TheExec.Datalog.WriteComment glsRAKerrMsg
            TheExec.Datalog.WriteComment RepeatChr("*", 60)
            If glbRAKBinout Then
                TheExec.Flow.TestLimit resultVal:=1, lowVal:=-1, hiVal:=-1, unit:=unitNone, Tname:=TheExec.DataManager.instancename
            End If
        End If
    Else
        ' when format correct and load sucessed, table doesn't load again
        If Not glbRAKisLoad Or glbRAKBinout Then
            If GetSheetInfo(RAKSheet, MaxRow, maxcol, wbAry) Then
                glbRAKBinout = False
                Set CurrentJob_Card_RAK = Nothing
                typeCol = TheExec.sites.Existing.Count + 2
                If Not LCase(wbAry(1, typeCol)) = "type" Then
                    glsRAKerrMsg = "Error: " & RAKSheet & " is old version, please check it."
                    glbRAKBinout = True
                    Exit Function
                End If
                
                Start_SiteNum = 0
                Stop_SiteNum = TheExec.sites.Existing.Count - 1
                PinsNum = MaxRow - 1
                
                If wbAry(2, 2) > 100 Then
                   Factor_Idx = 0.001
                Else
                   Factor_Idx = 1
                End If
            
                If CurrentJob_Card_RAK.Pins.Count <> PinsNum Then
                    StartRows = 2
                    glsRAKerrMsg = ""
                    For i = StartRows To MaxRow
                        CurrentJob_Card_RAK.AddPin wbAry(i, 1)
                        siteIndex = 0
                        
                        ' Print Alarm message in datalog when type is simulation
                        If (LCase(wbAry(i, typeCol)) = "simulation") Then
                            glsRAKerrMsg = CombineStringList("Alarm: pin " & wbAry(i, 1) & " is simulation", glsRAKerrMsg, vbCrLf)
                        ElseIf (LCase(wbAry(i, typeCol)) = "") Then
                            glsRAKerrMsg = CombineStringList("Error: pin " & wbAry(i, 1) & " is empty type", glsRAKerrMsg, vbCrLf)
                            glbRAKBinout = True
                        End If
                        
                        If InStr(wbAry(i, 1), "_SENSE") = 0 And TheExec.DataManager.ChannelType(wbAry(i, 1)) <> "N/C" Then
                           If TheExec.DataManager.PinType(wbAry(i, 1)) = "I/O" Then
                               RakV = TheHdw.PPMU.ReadRakValuesByPinnames(wbAry(i, 1), -1)
                           Else
                               ReDim RakV(Stop_SiteNum - Start_SiteNum)
                           End If
                        End If
            
                        For j = Start_SiteNum To Stop_SiteNum
                            If UBound(RakV) > 0 Then
                                CurrentJob_Card_RAK.Pins(wbAry(i, 1)).value(siteIndex) = RakV(siteIndex)
                            Else
                                CurrentJob_Card_RAK.Pins(wbAry(i, 1)).value(siteIndex) = RakV(0)
                            End If
                        siteIndex = siteIndex + 1
                        Next j
                    Next i
                    siteIndex = 0
                    
                    For j = Start_SiteNum To Stop_SiteNum
                        For i = StartRows To MaxRow
                            CurrentJob_Card_RAK.Pins(wbAry(i, 1)).value(siteIndex) = _
                                wbAry(i, 2 + j) * Factor_Idx + CurrentJob_Card_RAK.Pins(wbAry(i, 1)).value(siteIndex)
                        Next i
                        siteIndex = siteIndex + 1
                    Next j

                    glbRAKisLoad = True
                End If
            End If
        End If
    End If
    
    Exit Function
ErrorHandler:
    TheExec.Datalog.WriteComment "error in Processing RAK sheet, Please check if RAK sheet maps the current channel map name."
    If AbortTest Then Exit Function Else Resume Next
End Function


