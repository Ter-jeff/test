Private Function ProcessSweepAssignment(RegAssignArr() As Variant, StartCol As Long, MaxRow As Long, maxcol As Long, ConnectValStr As String, ConnectRegStr As String, TypeName As String)
On Error GoTo errHandler 'Add ErrHandler 2023/05/29


'Reg_Assignment: A=1000;B=0010;C=1111 ("=" is connectValStr, ";" is connectRegStr)
'Reg_Equation: A+B+C+A ("" is connectValStr,"+" is connectRegStr)
'Cus_DigCap: DSSC_out;4:A;4:B ("" is connectValStr,";" is connectRegStr)
'Cus_DigSrc:

If StartCol = maxcol Then Exit Function 'No Data inside

Dim i As Long
Dim j As Long
Dim k As Long

Dim TestNumber As Long
Dim RegisterNumber As Long
Dim ModeNum As Long
Dim CurrentSubBlockName As String: CurrentSubBlockName = "Dummy"

Dim Valid_ColNumber As Long
Dim tempStrArr() As String

Dim BlankRegAssignInfo As RegAssignInfo
RegAssignInfo = BlankRegAssignInfo

RegAssignInfo.TypeName = TypeName

For i = 2 To MaxRow
    
    If (RegAssignArr(i, StartCol) <> "") Then
            
        If InStr(RegAssignArr(i, StartCol), CurrentSubBlockName) = 0 Then
            RegisterNumber = 0
            ModeNum = 0
            CurrentSubBlockName = RegAssignArr(i, StartCol)
                
            ReDim Preserve RegAssignInfo.ByTest(TestNumber) As ByTest
            ReDim Preserve RegAssignInfo.ByTest(TestNumber).RegAssign(RegisterNumber) As RegAssign
                
            RegAssignInfo.ByTest(TestNumber).TestName = RegAssignArr(i, StartCol)
                
            ReDim Preserve RegAssignInfo.ByTest(TestNumber).RtnByMode(ModeNum) As String
 
            For k = StartCol + 1 To maxcol
                If RegAssignArr(i, k) = "" Then Exit For
                
                ReDim Preserve RegAssignInfo.ByTest(TestNumber).RegAssign(RegisterNumber) As RegAssign
                RegAssignInfo.ByTest(TestNumber).RegAssign(RegisterNumber).RegName = RegAssignArr(i, k)
                RegisterNumber = RegisterNumber + 1
            Next k
                
            TestNumber = TestNumber + 1
        Else
            If RegAssignArr(i, StartCol + 1) = "" Then Exit For
            RegisterNumber = 0
            
            For k = StartCol + 1 To UBound(RegAssignInfo.ByTest(TestNumber - 1).RegAssign) + StartCol + 1
            
                If RegAssignArr(i, k) = "" Then TheExec.ErrorLogMessage "RegisterNumber mismatch, Please check the Reg_Assign Sheet"
                
                ReDim Preserve RegAssignInfo.ByTest(TestNumber - 1).RegAssign(RegisterNumber).RegAssignByMode(ModeNum)
                ReDim Preserve RegAssignInfo.ByTest(TestNumber - 1).RtnByMode(ModeNum) As String
                RegAssignInfo.ByTest(TestNumber - 1).RegAssign(RegisterNumber).RegAssignByMode(ModeNum) = RegAssignArr(i, k)
                
                RegAssignInfo.ByTest(TestNumber - 1).RegAssign(RegisterNumber).RegAssignByMode(ModeNum) = Replace(RegAssignInfo.ByTest(TestNumber - 1).RegAssign(RegisterNumber).RegAssignByMode(ModeNum), "[b]", vbNullString)
                RegAssignInfo.ByTest(TestNumber - 1).RegAssign(RegisterNumber).RegAssignByMode(ModeNum) = StrReverse(RegAssignInfo.ByTest(TestNumber - 1).RegAssign(RegisterNumber).RegAssignByMode(ModeNum)) 'Reverse Str 20200312
                
                If RegisterNumber = 0 Then
                    RegAssignInfo.ByTest(TestNumber - 1).RtnByMode(ModeNum) = _
                    RegAssignInfo.ByTest(TestNumber - 1).RegAssign(RegisterNumber).RegName & "=" & RegAssignInfo.ByTest(TestNumber - 1).RegAssign(RegisterNumber).RegAssignByMode(ModeNum) & ";"
                Else
                    RegAssignInfo.ByTest(TestNumber - 1).RtnByMode(ModeNum) = _
                    RegAssignInfo.ByTest(TestNumber - 1).RtnByMode(ModeNum) & RegAssignInfo.ByTest(TestNumber - 1).RegAssign(RegisterNumber).RegName & "=" & RegAssignInfo.ByTest(TestNumber - 1).RegAssign(RegisterNumber).RegAssignByMode(ModeNum) & ";"
                End If

                RegisterNumber = RegisterNumber + 1
            Next k
            ModeNum = ModeNum + 1
        End If
    End If
Next i
    
Call StoredRegAssign

Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "ProcessSweepAssignment") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function HardIP_DCVI_MV_StoreAndRestoreCondition(Measure As Meas_Type, Instrument As Inst_Type, SaveCondition As Boolean) As Long
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    
    Dim MI_Pin As String
    Dim PinName() As String
    Dim TypeName As String
    Dim i As Long

    MI_Pin = Measure.Pins.UVI80

    PinName = Split(MI_Pin, ",")
    
    ReDim Preserve Measure.SaveCondition(UBound(PinName)) 'For restore
    With TheHdw.DCVI.Pins(Measure.Pins.UVI80)
        For i = 0 To UBound(PinName)
            TypeName = SortPinInstrument(PinName(i))
            If SaveCondition = True Then
                If TheHdw.DCVI.Pins(PinName(i)).Gate = True Then
                    Measure.SaveCondition(i).IfPowerPin = True
                    Measure.SaveCondition(i).pin = PinName(i)
                    Measure.SaveCondition(i).Current = FormatNumber(.Current, 3)
                    Measure.SaveCondition(i).SrcCurrentRange = FormatNumber(.CurrentRange.value, 3)
                End If
            Else
                If Measure.SaveCondition(i).IfPowerPin = True Then
                    .SetCurrentAndRange Measure.SaveCondition(i).Current, CDbl(Measure.SaveCondition(i).SrcCurrentRange)
                    '.CurrentRange.value = CDbl(Measure.SaveCondition(i).SrcCurrentRange)
                    '.Current = Measure.SaveCondition(i).Current                
                Else
                    '/*** added by Kaino on 2019/06/25 for Turks : fixed Mode alarm ***/
                    If CDbl(.Voltage) <> 0 Then
                        TheExec.Datalog.WriteComment " *** UVI80 Force Conditon Rollback ***  " & "Gate: ON -> HiZOFF -> OFF"
                        .Gate(tlDCVIGateHiZ) = False
                        .Gate = False
                    End If
                    .Current = 0
                    .Voltage = 0
                    .Gate(tlDCVIGateHiZ) = False
                    .BleederResistor = tlDCVIBleederResistorAuto
                    .Disconnect
                    .mode = tlDCVIModeCurrent

                End If
            End If
        Next i
    End With
