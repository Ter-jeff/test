'---------------------------------------UFP_Corr fix 20200413
Public Function HardIP_SetupAndMeasureVolt_UVS64(ByRef MeasureVolt As PinListData) As Long
On Error GoTo errHandler 'Add ErrHandler 2023/05/29

    Dim MeasV As Meas_Type
    Dim i As Long
    Dim VoltRangeList() As Double
    Dim CurrentRangeList() As Double
    Dim Pins() As String
    Dim Pin_Cnt As Long

    MeasV = TestConditionSeqData(Instance_Data.TestSeqNum).MeasV(Instance_Data.TestSeqSweepNum)
    Call HardIP_DCVS_MV_StoreAndRestoreCondition(MeasV, UVS64, True)
    If MeasV.Setup_ByTypeByPin_Flag = False Then
        With TheHdw.DCVS.Pins(MeasV.Pins.UVS64)
            '--Setup VoltageRange for DCVS MeasV on UFP --20230901
            .VoltageRange.value = VoltageRange_Select(CDbl(MeasV.Setup_ByType.UVS64.ForceValue1))
                        
            If (CDbl(MeasV.Setup_ByType.UVS64.ForceValue1) = 0) And .Gate <> True Then
                .Disconnect
                .mode = tlDCVIModeHighImpedance
                '.Meter.mode = tlDCVSMeterVoltage   'T-Est TTR approve by Si -- 230502
                .Gate = True
                .Connect
            Else
            
                If CDbl(MeasV.Setup_ByType.UVS64.ForceValue1) > 0 Then
                    .Voltage.value = 1 + 0.5
                Else
                    .Voltage.value = -1 - 0.5
                End If
                .CurrentRange.value = Abs(CDbl(MeasV.Setup_ByType.UVS64.ForceValue1))
                .CurrentLimit.Source.FoldLimit.level.value = Abs(CDbl(MeasV.Setup_ByType.UVS64.ForceValue1))
                .CurrentLimit.Sink.FoldLimit.level.value = Abs(CDbl(MeasV.Setup_ByType.UVS64.ForceValue1))
                '.Meter.mode = tlDCVSMeterVoltage   'T-Est TTR approve by Si -- 230502
                .Gate = True
                .Connect
                '---------------------------------------UFP_Corr fix 20200413
                .mode = tlDCVSModeCurrent
                '---------------------------------------UFP_Corr fix 20200413
            End If
        End With
        
        If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
            If (CDbl(MeasV.Setup_ByType.UVS64.ForceValue1) = 0) Then
                 TheExec.Datalog.WriteComment (glb_TestInstance & " =====> " & MeasV.Pins.UVS64 & " = High impedance mode  ")
            Else
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas Force Current value, " & MeasV.Pins.UVS64 & " =" & MeasV.Setup_ByType.UVS64.ForceValue1)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas UVS64 WaitTime, " & MeasV.Pins.UVS64 & " =" & MeasV.WaitTime.UVS64)
            End If
            'For DCVS voltage range setup on UFP --20230901
            If glb_TesterType = "UltraFLEXplus" Then TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas Voltage Range value, " & MeasV.Pins.UVS64 & " =" & TheHdw.DCVS.Pins(MeasV.Pins.UVS64).VoltageRange.value)
        End If
    Else
        For i = 0 To UBound(MeasV.Setup_ByTypeByPin.UVS64)
            With TheHdw.DCVS.Pins(MeasV.Setup_ByTypeByPin.UVS64(i).pin)
                '--Setup VoltageRange for DCVS MeasV on UFP --20230901
                .VoltageRange.value = VoltageRange_Select(CDbl(MeasV.Setup_ByTypeByPin.UVS64(i).ForceValue1))
                                
                If (CDbl(MeasV.Setup_ByTypeByPin.UVS64(i).ForceValue1) = 0) And .Gate <> True Then
                    .Disconnect
                    .mode = tlDCVIModeHighImpedance
                    '.Meter.mode = tlDCVSMeterVoltage   'T-Est TTR approve by Si -- 230502
                    .Gate = True
                    .Connect
                Else
                
                    If CDbl(MeasV.Setup_ByTypeByPin.UVS64(i).ForceValue1) > 0 Then
                        .Voltage.value = 1 + 0.5
                    Else
                        .Voltage.value = -1 - 0.5
                    End If
                    
                    .CurrentRange.value = Abs(CDbl(MeasV.Setup_ByTypeByPin.UVS64(i).ForceValue1))
                    .CurrentLimit.Source.FoldLimit.level.value = Abs(CDbl(MeasV.Setup_ByTypeByPin.UVS64(i).ForceValue1))
                    .CurrentLimit.Sink.FoldLimit.level.value = Abs(CDbl(MeasV.Setup_ByTypeByPin.UVS64(i).ForceValue1))
                    
                    
                    '.Meter.mode = tlDCVSMeterVoltage   'T-Est TTR approve by Si -- 230502
                    .Gate = True
                    .Connect
                    '---------------------------------------UFP_Corr fix 20200413
                    .mode = tlDCVSModeCurrent
                    '---------------------------------------UFP_Corr fix 20200413
                End If
            End With
        
            If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
                If (CDbl(MeasV.Setup_ByTypeByPin.UVS64(i).ForceValue1) = 0) Then
                     TheExec.Datalog.WriteComment (glb_TestInstance & " =====> " & MeasV.Setup_ByTypeByPin.UVS64(i).pin & " = High impedance mode  ")
                Else
                    TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas Force Current value, " & MeasV.Setup_ByTypeByPin.UVS64(i).pin & " =" & MeasV.Setup_ByTypeByPin.UVS64(i).ForceValue1)
                    TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas UVS64 WaitTime, " & MeasV.Setup_ByTypeByPin.UVS64(i).pin & " =" & MeasV.WaitTime.UVS64)
                End If
                'For DCVS voltage range setup on UFP --20230901
                If glb_TesterType = "UltraFLEXplus" Then TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas Voltage Range value, " & MeasV.Setup_ByTypeByPin.UVS64(i).pin & " =" & TheHdw.DCVS.Pins(MeasV.Setup_ByTypeByPin.UVS64(i).pin).VoltageRange.value)
            End If
        Next i
    End If

    If Not gl_Disable_HIP_debug_log Then: TheExec.Datalog.WriteComment "UVS64_MeasV_Wait_Time" & ":" & MeasV.WaitTime.UVS64
    TheHdw.DCVS.Pins(MeasV.Pins.UVS64).Meter.mode = tlDCVSMeterVoltage 'T-Est TTR approve by Si -- 230502
    TheHdw.Wait CDbl(MeasV.WaitTime.UVS64)
    'MeasureVolt = TheHdw.DCVS.Pins(MeasV.Pins.UVS64).Meter.Read(tlStrobe, pc_Def_UVS64_ReadPoint)
    If TheExec.Flow.enableWord("CurrentProfile") = False And TheExec.Flow.enableWord("VoltageProfile") = False And Profile_byflow = False Then
        MeasureVolt = TheHdw.DCVS.Pins(MeasV.Pins.UVS64).Meter.Read(tlStrobe, pc_Def_UVS64_ReadPoint)
    Else
        Dim p As Variant
        Dim Dummy_Value As New SiteDouble: Dummy_Value = 0.0001
        For Each p In Split(MeasV.Pins.UVS64, ",")
            TheExec.DataManager.DecomposePinList p, Pins, Pin_Cnt
            For i = 0 To Pin_Cnt - 1
                MeasureVolt.AddPin Pins(i)
                MeasureVolt.Pins(Pins(i)) = Dummy_Value
            Next i
        Next p
    End If
    If gl_Disable_HIP_debug_log = False Then Call ForceVal_Compare(MeasV, MeasV.Pins.UVS64, "V", "DCVS")
    
    Call HardIP_DCVS_MV_StoreAndRestoreCondition(MeasV, UVS64, False)

Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_SetupAndMeasureVolt_UVS64") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function
