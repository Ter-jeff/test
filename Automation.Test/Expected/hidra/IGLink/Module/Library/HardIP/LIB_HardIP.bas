Public Function HardIP_RAK_PowerSense()
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
        
        Dim funcName As String:: funcName = "HardIP_RAK_PowerSense"
    
    Dim i As Long
    Dim j As Long
    Dim siteIndex As Integer
    Dim SheetCnt As Integer
    Dim sheetName As String
    Dim ws_def_2path1 As Worksheet
    Dim wb As Workbook
    Dim RAK_PinsNum As Long
    Dim StartRows As Long
    Dim EndRows As Long
    Dim RakV() As Double
    Dim cnt As Long
    Dim RakV_PinList As New PinListData
    'Dim Path_2RAK1 As New PinListData
    Dim Start_SiteNum As Long
    Dim Stop_SiteNum As Long
    
    Start_SiteNum = 0
    Stop_SiteNum = TheExec.sites.Existing.Count - 1
    
    '20211013 Select sheet for specific stage
    'If currentJobName Like "*cp*" Then
    '    sheetName = "RAK_2Path1_CP"
    'ElseIf currentJobName Like "*wlft*" Then
    '    sheetName = "RAK_2Path1_WLFT"
    'ElseIf currentJobName Like "*ft*" Then
    '    sheetName = "RAK_2Path1_FT"
    'End If
    
    'Check sheet GetRAK2Path1 is exist
    'SheetName = "RAK_2Path1"
        
    '20220819 Align RAK table naming rule   Ex. RAK_2Path1 + "Current_Channel_MAP"
    sheetName = "RAK_2Path1_" & Replace(UCase(TheExec.CurrentChanMap), "CHANNELMAP_", "")   'Filter "CHANNELMAP_" key word with short sheet name -- 20220913
        
    SheetExist = False
    SheetCnt = ActiveWorkbook.Sheets.Count
    For cnt = 1 To SheetCnt
        If LCase(Sheets(cnt).name) Like LCase(sheetName) Then
            SheetExist = True
            Exit For
        End If
    Next cnt
     
    If SheetExist = True Then
    
        Application.ScreenUpdating = False  'Update for parsing table -- 20230531
        
        ' Initial worksheet
        Set ws_def_2path1 = Nothing
        Set Path_2RAK1 = Nothing
        Set wb = Application.ActiveWorkbook
        'Set ws_def_2path1 = wb.Sheets("RAK_2Path1")
        Set ws_def_2path1 = wb.Sheets(sheetName)
        
        RAK_PinsNum = ws_def_2path1.Cells(Rows.Count, 1).End(xlUp).Row - 1
        StartRows = 2
        EndRows = RAK_PinsNum + 1
        ReDim RakV(Stop_SiteNum - Start_SiteNum)
        ReDim Path_2RAK1_PinList(EndRows - StartRows)
        'Read Pin Name
        For i = StartRows To EndRows
            Path_2RAK1.AddPin (ws_def_2path1.Cells(i, 1).value)
            Path_2RAK1_PinList(i - 2) = LCase(ws_def_2path1.Cells(i, 1).value)
            siteIndex = 0
             For j = Start_SiteNum To Stop_SiteNum
                Path_2RAK1.Pins(ws_def_2path1.Cells(i, 1).value).value(siteIndex) = RakV(siteIndex)
                siteIndex = siteIndex + 1
            Next j
        Next i
        'Reset Index
        siteIndex = 0
        'Read RAK value for each pins
        For j = Start_SiteNum To Stop_SiteNum
            For i = StartRows To EndRows
                Path_2RAK1.Pins(ws_def_2path1.Cells(i, 1).value).value(siteIndex) = ws_def_2path1.Cells(i, 2 + j).value
            Next i
            siteIndex = siteIndex + 1
        Next j
        
        Application.ScreenUpdating = True  'Update for parsing table -- 20230531
    End If

Exit Function
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_RAK_PowerSense") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function IO_HardIP_DS_VOH_VOL_INIT() As Long
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    'New Method for IO_DS_VOHVOL_with_RAK -- 20220421
    'Parsing "GPIO_DS_table" to calculate per pin complment value
    If glb_IO_DS_PARSING_Flag = True Then Exit Function         'Update parsing one times -- 20230214
    
    Dim sheetName As String
    Dim ws_def As Worksheet
    Dim wb As Workbook
    Dim MaxRow As Long
    Dim maxcol As Long
    Dim isSheetFound As Boolean
    Dim iRow As Long
    Dim iCol As Long
    Dim IO_DS_DataAry As Variant
    'Flag Area
    Dim Same_DicName_Flag As Boolean: Same_DicName_Flag = False
    
    'Condition String
    Dim Level_Condition_Str As String: Level_Condition_Str = vbNullString
    Dim Level_Condition_pre_Str As String: Level_Condition_pre_Str = vbNullString
    Dim PatName_Str As String
    Dim PatName_pre_Str As String
    Dim pinname_str As String
    Dim DC_Spec_Symbol_Str As String
    Dim DC_SPEC_Symbol_Val As Double
    Dim Ratio_Voh_Val As Double
    Dim Ratio_Vol_Val As Double
    'Dim Current_Val As Double
    Dim Ioh_Val As Double
    Dim Iol_Val As Double
    Dim Fixed_RAK As Double                   'For Fixed_RAK value use -- 20220627
    Dim Dict_Name_Str As String
    
    Dim VOH_Cal_PinListVal As New PinListData
    Dim VOL_Cal_PinListVal As New PinListData
    Dim IOH_Cal_PinListVal As New PinListData ' Add Store IOH and IOL current value -- 20220512
    Dim IOL_Cal_PinListVal As New PinListData ' Add Store IOH and IOL current value -- 20220512
    Dim RAK_Cal_PinListVal As New PinListData ' For Fixed_RAK value use -- 20220627
    Dim i As Long
    Dim vsite As Variant
    Dim Profile_AllPin() As String
    Dim pin As Variant
    Dim PinCnt As Long
    Dim Temp_Dic As New Dictionary
    
    ' Add for Check RAK table status
    Dim strAry_sheetnames() As String
    Dim idxSheet As Long
    Dim RAKSheet As String
    Dim CHK_RAK_Sheet_Exist_Flag As Boolean: CHK_RAK_Sheet_Exist_Flag = False  ' Check RAK Sheet Exist or not
    Dim RAK_PinCHK_Dic As New Dictionary
    
    '''*****************************************************************'''
    sheetName = "IO_DS_Table"
    Set wb = Application.ActiveWorkbook
    Call check_Sheet_Range(sheetName, wb, ws_def, MaxRow, maxcol, isSheetFound, False)          'Max row reference Column:G (Ratio_of_RAK)
    '''*****************************************************************'''
        
    If isSheetFound Then
            Application.ScreenUpdating = False 'Update for parsing table -- 20230531
            
            '===== Check RAK Table [ Check sheet Exist ]======
            ' If There is no pin exist in RAK sheet, show warinning message and set pin RAK value = 0
            ' If There is no RAK sheet, set pin RAK = 0 directly
            
            RAKSheet = "RAK_" & Replace(UCase(TheExec.CurrentChanMap), "CHANNELMAP_", "")   'Filter "CHANNELMAP_" key word with short sheet name -- 20220913
            'RAKSheet = "RAK_" & UCase(TheExec.CurrentChanMap)   'Filter "CHANNELMAP_" key word with short sheet name -- 20220913
            
            strAry_sheetnames = TheExec.job.GetSheetNamesOfType(DMGR_SHEET_TYPE_USER)
            For idxSheet = 0 To UBound(strAry_sheetnames)
                    If LCase(strAry_sheetnames(idxSheet)) Like LCase(RAKSheet) Then
                            CHK_RAK_Sheet_Exist_Flag = True
                            Exit For
                    End If
            Next idxSheet
            
            '===== Store All of RAK pin data to Dictionary for Check ======
            If CHK_RAK_Sheet_Exist_Flag = True Then
                    IO_DS_Value.RemoveAll        'initial/clear previous parse result
                    RAK_PinCHK_Dic.RemoveAll     'Clear temp Dictionary for Stroe pin list
                    For i = 0 To CurrentJob_Card_RAK.Pins.Count - 1
                            pin = CurrentJob_Card_RAK.Pins.item(i)
                            RAK_PinCHK_Dic.Add pin, True   'Add pin for CHK RAK pinlist data
                    Next i
            End If

            IO_DS_DataAry = ws_def.range(Cells(1, 1), Cells(MaxRow, maxcol))
            For iRow = 2 To MaxRow
                    '==== Judge Level Condition =====
                    
                    If IO_DS_DataAry(iRow, 1) <> "" And Level_Condition_Str = "" Then   'Level condition check : 1st Level condition
                            Level_Condition_Str = IO_DS_DataAry(iRow, 1)
                            Level_Condition_pre_Str = Level_Condition_Str
                    ElseIf IO_DS_DataAry(iRow, 1) <> "" And IO_DS_DataAry(iRow, 1) <> Level_Condition_Str Then '''nnn
                            Level_Condition_pre_Str = Level_Condition_Str
                            Level_Condition_Str = IO_DS_DataAry(iRow, 1)
                            'Level_Condition_pre_Str = Level_Condition_Str
                    ElseIf IO_DS_DataAry(iRow, 1) = "" Then
                            Level_Condition_pre_Str = Level_Condition_Str
                    Else
                            Level_Condition_pre_Str = Level_Condition_Str
                            Level_Condition_Str = IO_DS_DataAry(iRow, 1)
                    End If
                    
                    '==== Judge Same PatName with Multi PinGrp  =====
                    If IO_DS_DataAry(iRow, 2) = "" Then
                            PatName_pre_Str = PatName_Str                   'Record PatName compare with Next Seg.
                    Else
                            PatName_pre_Str = PatName_Str                   'Record PatName compare with Next Seg.  'nn_modify
                            PatName_Str = IO_DS_DataAry(iRow, 2)
                    End If
                            
                    If PatName_pre_Str <> PatName_Str Or Level_Condition_pre_Str <> Level_Condition_Str Then
                        Same_DicName_Flag = False                    ' Multi pin grp need to merge in one pinlistdata
                    Else
                        Same_DicName_Flag = True                     ' Multi pin grp need to merge in one pinlistdata
                    End If

                    pinname_str = IO_DS_DataAry(iRow, 3)                'Store PinName
                    
                    DC_Spec_Symbol_Str = IO_DS_DataAry(iRow, 4)         'Store DC Spec Symbol Name
                    If DC_Spec_Symbol_Str <> "" Then                    'Get DC Spec Symbol Value
                            If InStr(UCase(DC_Spec_Symbol_Str), UCase("_VAR")) = 0 Then DC_Spec_Symbol_Str = DC_Spec_Symbol_Str & "_VAR"   ' Check DC_SPEC hav "_VAR" or not -- 20220511
                            
                            If Level_Condition_Str = "LV" Then DC_SPEC_Symbol_Val = TheExec.Specs.DC.item(DC_Spec_Symbol_Str).Categories.item("HardIP_X_X_X").min
                            If Level_Condition_Str = "NV" Then DC_SPEC_Symbol_Val = TheExec.Specs.DC.item(DC_Spec_Symbol_Str).Categories.item("HardIP_X_X_X").Typ
                            If Level_Condition_Str = "HV" Then DC_SPEC_Symbol_Val = TheExec.Specs.DC.item(DC_Spec_Symbol_Str).Categories.item("HardIP_X_X_X").max
                            
                            Ratio_Voh_Val = CDbl(IO_DS_DataAry(iRow, 5))  'Store Ratio of Voh
                            Ratio_Vol_Val = CDbl(IO_DS_DataAry(iRow, 6))  'Store Ratio of Vol
                            Ratio_Voh_Val = DC_SPEC_Symbol_Val * Ratio_Voh_Val
                            Ratio_Vol_Val = DC_SPEC_Symbol_Val * Ratio_Vol_Val
                    Else
                            Ratio_Voh_Val = CDbl(IO_DS_DataAry(iRow, 5))  'Store Ratio of Voh
                            Ratio_Vol_Val = CDbl(IO_DS_DataAry(iRow, 6))  'Store Ratio of Vol
                    End If
                    
                    'Current_Val = CDbl(IO_DS_DataAry(iRow, 7))     'Store Current Value
                    Ioh_Val = CDbl(IO_DS_DataAry(iRow, 7))          'Store Ioh Value
                    Iol_Val = CDbl(IO_DS_DataAry(iRow, 8))          'Store Iol Value
                    
                    'Add Fixed RAK value for STC project -- 20220627
                    Fixed_RAK = CDbl(IO_DS_DataAry(iRow, 9))
                    If Fixed_RAK <> 0 Then
                                        
                                                Set VOH_Cal_PinListVal = Nothing        ' Reset Parameter
                                                Set VOL_Cal_PinListVal = Nothing        ' Reset Parameter
                                                Set IOH_Cal_PinListVal = Nothing        ' Reset Parameter
                                                Set IOL_Cal_PinListVal = Nothing        ' Reset Parameter
                                                Set RAK_Cal_PinListVal = Nothing        ' Reset Parameter
                                        
                                                VOH_Cal_PinListVal.AddPin (pinname_str)
                                                VOL_Cal_PinListVal.AddPin (pinname_str)
                                                IOH_Cal_PinListVal.AddPin (pinname_str)
                                                IOL_Cal_PinListVal.AddPin (pinname_str)
                                                RAK_Cal_PinListVal.AddPin (pinname_str) 'For Fixed_RAK value use -- 20220627
                                                
                                                VOH_Cal_PinListVal.Pins(pinname_str).value = Ratio_Voh_Val + Ioh_Val * Fixed_RAK    ' No RAK Value set value = 0
                                                VOL_Cal_PinListVal.Pins(pinname_str).value = Ratio_Vol_Val + Iol_Val * Fixed_RAK    ' No RAK Value set value = 0
                                                IOH_Cal_PinListVal.Pins(pinname_str).value = Ioh_Val                                ' Add Store IOH and IOL current value -- 20220512
                                                IOL_Cal_PinListVal.Pins(pinname_str).value = Iol_Val                                ' Add Store IOH and IOL current value -- 20220512
                                                RAK_Cal_PinListVal.Pins(pinname_str).value = Fixed_RAK                              ' For Fixed_RAK value use -- 20220627
                                                                
                                                '==== Store PLD to Dictionary ====
                                                Dict_Name_Str = LCase(PatName_Str & "_" & Level_Condition_Str)
                                                If IO_DS_Value.Exists(LCase(Dict_Name_Str & "_voh")) Then
                                                        IO_DS_Value.Remove (LCase(Dict_Name_Str & "_voh"))
                                                        IO_DS_Value.Remove (LCase(Dict_Name_Str & "_vol"))
                                                        IO_DS_Value.Remove (LCase(Dict_Name_Str & "_ioh"))
                                                        IO_DS_Value.Remove (LCase(Dict_Name_Str & "_iol"))
                                                        IO_DS_Value.Remove (LCase(Dict_Name_Str & "_rak"))
                                                End If
                                                Call IO_DS_Value.Add(LCase(Dict_Name_Str & "_voh"), VOH_Cal_PinListVal)    ' Store VOH Calibration value to Dictionary as Pinlistdata
                                                Call IO_DS_Value.Add(LCase(Dict_Name_Str & "_vol"), VOL_Cal_PinListVal)   ' Store VOL Calibration value to Dictionary as Pinlistdata
                                                Call IO_DS_Value.Add(LCase(Dict_Name_Str & "_ioh"), IOH_Cal_PinListVal)   ' Store IOH Calibration value to Dictionary as Pinlistdata
                                                Call IO_DS_Value.Add(LCase(Dict_Name_Str & "_iol"), IOL_Cal_PinListVal)   ' Store IOL Calibration value to Dictionary as Pinlistdata
                                                Call IO_DS_Value.Add(LCase(Dict_Name_Str & "_rak"), RAK_Cal_PinListVal)   ' Store RAK For Fixed_RAK value use -- 20220627
                                
                    Else
                            '===== Judge Add pin in the PinListData ======
                            If Same_DicName_Flag = True Then
                                    'Dictionary Format : PatName_Levelcondition_[voh/vol]
                                    'Ex. CMOS_DS4S0_NV_voh and CMOS_DS4S0_NV_vol
                                    VOH_Cal_PinListVal = IO_DS_Value.item(LCase(PatName_Str & "_" & Level_Condition_Str & "_voh"))
                                    VOL_Cal_PinListVal = IO_DS_Value.item(LCase(PatName_Str & "_" & Level_Condition_Str & "_vol"))
                                    IOH_Cal_PinListVal = IO_DS_Value.item(LCase(PatName_Str & "_" & Level_Condition_Str & "_ioh"))
                                    IOL_Cal_PinListVal = IO_DS_Value.item(LCase(PatName_Str & "_" & Level_Condition_Str & "_iol"))
                                    
                                    Temp_Dic.RemoveAll     'Clear temp Dictionary for Stroe pin list
                                    For i = 0 To VOH_Cal_PinListVal.Pins.Count - 1
                                        pin = VOH_Cal_PinListVal.Pins.item(i)
                                        Temp_Dic.Add pin, True
                                    Next i
                                    
                                    TheExec.DataManager.DecomposePinList pinname_str, Profile_AllPin, PinCnt
                                    For i = 0 To PinCnt - 1
                                        pin = Profile_AllPin(i)
                                        If Temp_Dic.Exists(pin) = False Then
                                            ' Pin not exist in PLD, add pin
                                            VOH_Cal_PinListVal.AddPin (pin)
                                            VOL_Cal_PinListVal.AddPin (pin)
                                            IOH_Cal_PinListVal.AddPin (pin)
                                            IOL_Cal_PinListVal.AddPin (pin)
                                        End If
                                    Next i
                                Else
                                    Set VOH_Cal_PinListVal = Nothing        ' Reset Parameter
                                    Set VOL_Cal_PinListVal = Nothing        ' Reset Parameter
                                    Set IOH_Cal_PinListVal = Nothing        ' Reset Parameter
                                    Set IOL_Cal_PinListVal = Nothing        ' Reset Parameter
                                    
                                    TheExec.DataManager.DecomposePinList pinname_str, Profile_AllPin, PinCnt
                                    For i = 0 To PinCnt - 1
                                        pin = Profile_AllPin(i)
                                        VOH_Cal_PinListVal.AddPin (pin)
                                        VOL_Cal_PinListVal.AddPin (pin)
                                        IOH_Cal_PinListVal.AddPin (pin)
                                        IOL_Cal_PinListVal.AddPin (pin)
                                    Next i
                                End If
                            
                            '====== Per Pin Calculate Calibration value by RAK =====
                            TheExec.DataManager.DecomposePinList pinname_str, Profile_AllPin, PinCnt
                            For i = 0 To PinCnt - 1
                                    pin = Profile_AllPin(i)
                                    ' ===== Check RAK Table exist or not =====
                                    If CHK_RAK_Sheet_Exist_Flag = True Then
                                             For Each vsite In TheExec.sites.Existing
                                                    '===== Calculate Formula ======
                                                    'VOH :  DC_Sepc * Ratio_voh - Ioh * RAK_Value
                                                    'VOL :  DC_Sepc * Ratio_vol + Iol * RAK_Value
                                                    
                                                    ' ===== Check IO pins define in RAK table or not =====
                                                    If RAK_PinCHK_Dic.Exists(pin) = True Then
                                                            'VOH_Cal_PinListVal.Pins(pin).value(vSite) = Ratio_Voh_Val - Ioh_Val * CurrentJob_Card_RAK.Pins(pin).value(vSite)
                                                            VOH_Cal_PinListVal.Pins(pin).value(vsite) = Ratio_Voh_Val + Ioh_Val * CurrentJob_Card_RAK.Pins(pin).value(vsite)
                                                            VOL_Cal_PinListVal.Pins(pin).value(vsite) = Ratio_Vol_Val + Iol_Val * CurrentJob_Card_RAK.Pins(pin).value(vsite)
                                                    Else
                                                            TheExec.Datalog.WriteComment "*** [Warning] [" & pin & "] not found in RAK table !!! Set RAK Value=0 *****"
                                                            'VOH_Cal_PinListVal.Pins(pin).value(vSite) = Ratio_Voh_Val - Ioh_Val * 0#    ' No RAK Value set value = 0
                                                            VOH_Cal_PinListVal.Pins(pin).value(vsite) = Ratio_Voh_Val + Ioh_Val * 0#    ' No RAK Value set value = 0
                                                            VOL_Cal_PinListVal.Pins(pin).value(vsite) = Ratio_Vol_Val + Iol_Val * 0#    ' No RAK Value set value = 0
                                                    End If
                                                    IOH_Cal_PinListVal.Pins(pin).value(vsite) = Ioh_Val                             ' Add Store IOH and IOL current value -- 20220512
                                                    IOL_Cal_PinListVal.Pins(pin).value(vsite) = Iol_Val                             ' Add Store IOH and IOL current value -- 20220512
                                            Next vsite
                                    Else
                                            TheExec.Datalog.WriteComment "*** [Warning] RAK Sheet[" & RAKSheet & "] not Exist!!! Set [" & pin & "]RAK Value=0 *****"
                                            For Each vsite In TheExec.sites.Existing
                                                    '===== Calculate Formula ======
                                                    'VOH_Cal_PinListVal.Pins(pin).value(vSite) = Ratio_Voh_Val - Ioh_Val * 0#    ' No RAK Value set value = 0
                                                    VOH_Cal_PinListVal.Pins(pin).value(vsite) = Ratio_Voh_Val + Ioh_Val * 0#    ' No RAK Value set value = 0
                                                    VOL_Cal_PinListVal.Pins(pin).value(vsite) = Ratio_Vol_Val + Iol_Val * 0#    ' No RAK Value set value = 0
                                                    IOH_Cal_PinListVal.Pins(pin).value(vsite) = Ioh_Val                         ' Add Store IOH and IOL current value -- 20220512
                                                    IOL_Cal_PinListVal.Pins(pin).value(vsite) = Iol_Val                         ' Add Store IOH and IOL current value -- 20220512
                                            Next vsite
                                    End If
                                    '==== Store PLD to Dictionary ====
                                    Dict_Name_Str = LCase(PatName_Str & "_" & Level_Condition_Str)
                                    If IO_DS_Value.Exists(LCase(Dict_Name_Str & "_voh")) Then
                                        IO_DS_Value.Remove (LCase(Dict_Name_Str & "_voh"))
                                        IO_DS_Value.Remove (LCase(Dict_Name_Str & "_vol"))
                                        IO_DS_Value.Remove (LCase(Dict_Name_Str & "_ioh"))
                                        IO_DS_Value.Remove (LCase(Dict_Name_Str & "_iol"))
                                    End If
                                    Call IO_DS_Value.Add(LCase(Dict_Name_Str & "_voh"), VOH_Cal_PinListVal)    ' Store VOH Calibration value to Dictionary as Pinlistdata
                                    Call IO_DS_Value.Add(LCase(Dict_Name_Str & "_vol"), VOL_Cal_PinListVal)   ' Store VOL Calibration value to Dictionary as Pinlistdata
                                    Call IO_DS_Value.Add(LCase(Dict_Name_Str & "_ioh"), IOH_Cal_PinListVal)   ' Store IOH Calibration value to Dictionary as Pinlistdata
                                    Call IO_DS_Value.Add(LCase(Dict_Name_Str & "_iol"), IOL_Cal_PinListVal)   ' Store IOL Calibration value to Dictionary as Pinlistdata
                            Next i
                    End If
                    '==== ENG Debug log ====
                    If gl_Disable_HIP_debug_log = False Then
                            TheExec.Datalog.WriteComment "****** IO_HardIP_DS_VOH_VOL_INIT ******"
                            If Fixed_RAK <> 0 Then
                                    TheExec.Datalog.WriteComment "Site#" & "[All]" & "," & pinname_str & "," & _
                                                                                            Format(CStr(Fixed_RAK), "0.000") & "," & _
                                                                                            Format(CStr(VOH_Cal_PinListVal.Pins(pinname_str).value), "0.000") & "," & _
                                                                                            Format(CStr(VOL_Cal_PinListVal.Pins(pinname_str).value), "0.000") & "," & _
                                                                                            IOH_Cal_PinListVal.Pins(pinname_str).value & "," & _
                                                                                            IOL_Cal_PinListVal.Pins(pinname_str).value & "," & _
                                                                                            Replace(UCase(Dict_Name_Str), " ", "_")
                            Else
                                    For i = 0 To VOH_Cal_PinListVal.Pins.Count - 1
                                            pin = VOH_Cal_PinListVal.Pins.item(i)
                                            If TheExec.DataManager.ChannelType(pin) <> "N/C" Then
                                                For Each vsite In TheExec.sites.Existing
                                                        TheExec.Datalog.WriteComment "Site#" & vsite & "," & pin & "," & _
                                                                                                                Format(CStr(CurrentJob_Card_RAK.Pins(pin).value(vsite)), "0.000") & "," & _
                                                                                                                Format(CStr(VOH_Cal_PinListVal.Pins(pin).value(vsite)), "0.000") & "," & _
                                                                                                                Format(CStr(VOL_Cal_PinListVal.Pins(pin).value(vsite)), "0.000") & "," & _
                                                                                                                IOH_Cal_PinListVal.Pins(pin).value(vsite) & "," & _
                                                                                                                IOL_Cal_PinListVal.Pins(pin).value(vsite) & "," & _
                                                                                                                Replace(UCase(Dict_Name_Str), " ", "_")
                                                Next vsite
                                            End If
                                    Next i
                            End If
                    End If
            Next iRow
            Application.ScreenUpdating = True 'Update for parsing table -- 20230531
            glb_IO_DS_PARSING_Flag = True               'Update parsing one times -- 20230214
    End If
    
    Exit Function
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "IO_HardIP_DS_VOH_VOL_INIT") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function IO_HardIP_DS_VOH_VOL_SETUP(instance_name As String) As Long
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    'New Method for IO_DS_VOHVOL_with_RAK -- 20220421
    'Parsing "GPIO_DS_table" to calculate per pin complment value
    
    Dim vsite As Variant
    Dim i As Long
    Dim Profile_AllPin() As String
    Dim pin As Variant
    Dim PinCnt As Long
    Dim IODS_PINS_VOH_PLD As New PinListData
    Dim IODS_PINS_VOL_PLD As New PinListData
    Dim IODS_PINS_IOH_PLD As New PinListData ' Add Store IOH and IOL current value -- 20220512
    Dim IODS_PINS_IOL_PLD As New PinListData ' Add Store IOH and IOL current value -- 20220512
    Dim IODS_PINS_RAK_PLD As New PinListData ' For Fixed_RAK value use -- 20220627
    Dim InstName_Str_Ary() As String
    Dim Dict_KeyName As String
    
    
    'TheExec.Datalog.WriteComment "==== Change VOH/VOL add RAK Compensation for IO DS function ===="
    
    InstName_Str_Ary = Split(LCase(instance_name), "_si_")
    Dict_KeyName = InstName_Str_Ary(1)
    'TheExec.Datalog.WriteComment "==== Dictionary Name =" & Dict_KeyName
    
    IODS_PINS_VOH_PLD = IO_DS_Value.item(LCase(Dict_KeyName) & "_voh")
    IODS_PINS_VOL_PLD = IO_DS_Value.item(LCase(Dict_KeyName) & "_vol")
    IODS_PINS_IOH_PLD = IO_DS_Value.item(LCase(Dict_KeyName) & "_ioh") ' Add Store IOH and IOL current value -- 20220512
    IODS_PINS_IOL_PLD = IO_DS_Value.item(LCase(Dict_KeyName) & "_iol") ' Add Store IOH and IOL current value -- 20220512
    
    TheExec.Datalog.WriteComment "****** IO_HardIP_DS_VOH_VOL_INIT ******"
    TheExec.Datalog.WriteComment "==== Change VOH/VOL add RAK Compensation for IO DS function ===="
    
    If IODS_PINS_VOH_PLD.Pins.Count > 1 Then
        For i = 0 To IODS_PINS_VOH_PLD.Pins.Count - 1
            pin = IODS_PINS_VOH_PLD.Pins.item(i)
            
            If glb_TesterType = "Jaguar" Then
                For Each vsite In TheExec.sites.Active
                    '[UF] Use BySiteLoop setting VOH/VOL Value
                    TheHdw.Digital.Pins(pin).Levels.value(chVoh) = IODS_PINS_VOH_PLD.Pins(pin).value(vsite)
                    TheHdw.Digital.Pins(pin).Levels.value(chVol) = IODS_PINS_VOL_PLD.Pins(pin).value(vsite)
                    TheHdw.Digital.Pins(pin).Levels.value(chIoh) = IODS_PINS_IOH_PLD.Pins(pin).value(vsite) ' Add Store IOH and IOL current value -- 20220512
                    TheHdw.Digital.Pins(pin).Levels.value(chIol) = IODS_PINS_IOL_PLD.Pins(pin).value(vsite) ' Add Store IOH and IOL current value -- 20220512
                Next vsite
            Else
                '[UFP] Use ValuePerSite setting VOH/VOL Value
                TheHdw.Digital.Pins(pin).Levels.ValuePerSite(chVoh) = IODS_PINS_VOH_PLD.Pins(pin)
                TheHdw.Digital.Pins(pin).Levels.ValuePerSite(chVol) = IODS_PINS_VOL_PLD.Pins(pin)
                TheHdw.Digital.Pins(pin).Levels.ValuePerSite(chIoh) = IODS_PINS_IOH_PLD.Pins(pin) ' Add Store IOH and IOL current value -- 20220512
                TheHdw.Digital.Pins(pin).Levels.ValuePerSite(chIol) = IODS_PINS_IOL_PLD.Pins(pin) ' Add Store IOH and IOL current value -- 20220512
            End If
            '==== ENG Debug log ====
            If gl_Disable_HIP_debug_log = False Then
                For Each vsite In TheExec.sites.Active
                    TheExec.Datalog.WriteComment "Site#" & vsite & "," & pin & "," & _
                                                Format(CStr(CurrentJob_Card_RAK.Pins(pin).value(vsite)), "0.000") & "," & _
                                                Format(CStr(IODS_PINS_VOH_PLD.Pins(pin).value(vsite)), "0.000") & "," & _
                                                Format(CStr(IODS_PINS_VOL_PLD.Pins(pin).value(vsite)), "0.000") & "," & _
                                                IODS_PINS_IOH_PLD.Pins(pin).value(vsite) & "," & _
                                                IODS_PINS_IOL_PLD.Pins(pin).value(vsite) & "," & _
                                                Replace(UCase(Dict_KeyName), " ", "_")
                Next vsite
            End If
        Next i
    Else
        TheHdw.Digital.Pins(IODS_PINS_VOH_PLD.Pins(0)).Levels.value(chVoh) = IODS_PINS_VOH_PLD.Pins(0).value
        TheHdw.Digital.Pins(IODS_PINS_VOL_PLD.Pins(0)).Levels.value(chVol) = IODS_PINS_VOL_PLD.Pins(0).value
        TheHdw.Digital.Pins(IODS_PINS_IOH_PLD.Pins(0)).Levels.value(chIoh) = IODS_PINS_IOH_PLD.Pins(0).value ' Add Store IOH and IOL current value -- 20220512
        TheHdw.Digital.Pins(IODS_PINS_IOL_PLD.Pins(0)).Levels.value(chIol) = IODS_PINS_IOL_PLD.Pins(0).value ' Add Store IOH and IOL current value -- 20220512
        
        '==== ENG Debug log ====
        If gl_Disable_HIP_debug_log = False Then
            'IODS_PINS_RAK_PLD = GetStoreDataAllType(LCase(Dict_KeyName) & "_rak") ' Add Store IOH and IOL current value -- 20220512
            IODS_PINS_RAK_PLD = IO_DS_Value.item(LCase(Dict_KeyName) & "_rak") ' Add Store IOH and IOL current value -- 20220512
            TheExec.Datalog.WriteComment "Site#" & "[ALL]" & "," & IODS_PINS_VOH_PLD.Pins(0) & "," & _
                                                Format(CStr(IODS_PINS_RAK_PLD.Pins(0).value), "0.000") & "," & _
                                                Format(CStr(IODS_PINS_VOH_PLD.Pins(pin).value), "0.000") & "," & _
                                                Format(CStr(IODS_PINS_VOL_PLD.Pins(pin).value), "0.000") & "," & _
                                                IODS_PINS_IOH_PLD.Pins(pin).value & "," & _
                                                IODS_PINS_IOL_PLD.Pins(pin).value & "," & _
                                                Replace(UCase(Dict_KeyName), " ", "_")
        End If
    End If
    
    Exit Function
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "IO_HardIP_DS_VOH_VOL_SETUP") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function
Public Function TrimCodeFreq_GeneralDigSrcSetting(Pat As String, DigSrc_pin As PinList, DigSrc_Sample_Size As Long, DigSrc_DataWidth As Long, _
DigSrc_Equation As String, digsrc_assignment As String, ByRef InDSPWave As DSPWave, Optional ByVal TrimStart As String, Optional ByVal TrimFormat As String, Optional MSB_First_Flag As Boolean = False) As Long
