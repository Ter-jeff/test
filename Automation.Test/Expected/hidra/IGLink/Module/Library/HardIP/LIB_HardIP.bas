Public Function ProcessCalcEquation(Calc_Eqn As String) As Long
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    
    Dim SplitBySemi() As String, SplitByColon() As String, SplitByLeftPara() As String
    Dim i As Long, j As Long, p As Long
    Dim KeyWord_Calc As String
    Dim ALG_InterPoseFuncName As String
    Dim ALG_InterPoseArgcName As String
    Dim TestName As String
    Dim operator As String
    Dim SplitByKeyWord() As String
    Dim ReturnDSPWave As New DSPWave
    Dim TestNameInput As String

    '' 20160914 - Equation pins for V,F,I
''    Dim EquationPins As String
    Dim CalcEquation_PLD As CALC_EQUATION_PLD
    Dim ReturnPLD As New PinListData
    Dim OutputTname_format() As String
    'TTR,20200423, Oscar
    'TheHdw.DSP.EnableHostThreadMode = True
    'ReturnDSPWave.CreateConstant 0, 1, DspDouble
    Dim site As Variant 'Carter, 20240304
    SplitBySemi = Split(Calc_Eqn, ";")
    
    Dim KeyWord_Description As String
    
    For i = 0 To UBound(SplitBySemi)
        
        Set ReturnPLD = Nothing
        Set ReturnDSPWave = Nothing
        ReturnDSPWave.CreateConstant 0, 1, DspDouble
        
        If (UCase(SplitBySemi(i)) Like "*CP*=*" Or UCase(SplitBySemi(i)) Like "*FT*=*") Then SplitBySemi(i) = Select_MeasPin(SplitBySemi(i), CurrentJobName_U)
        If SplitBySemi(i) = "" Then SplitBySemi(i) = "X:X"

        SplitByColon = Split(SplitBySemi(i), ":")
        
        If UCase(SplitByColon(0)) = "CDIV2" Then
            KeyWord_Calc = "CDIV2"
        Else
            KeyWord_Calc = left(UCase(SplitByColon(0)), 1)
        End If
        
        KeyWord_Description = SplitByColon(0)
        
        If UCase(KeyWord_Description) = UCase("ALG") Then
            KeyWord_Calc = UCase(KeyWord_Description)
        End If
        
        TestName = SplitByColon(1)
        
        ''20160607 - Store return value in the Dictionary
        Dim DictKeyName As String
        If UBound(SplitByColon) = 3 Then
            DictKeyName = SplitByColon(3)
        End If
        Dim tempIndex As Long: tempIndex = TheExec.Flow.TestLimitIndex
        '==== Support Measrument result Complexity Calc ==== 20230628
        Dim tempStr_Equation As String
        Dim finalResult As New SiteDouble
        Dim bStringCheck As Boolean
        
                tempStr_Equation = SplitByColon(2)
                bStringCheck = RegExCheckString(tempStr_Equation, "\int\w+\s?[\/]\s?[0]|\([0]\+[0]\)", False)
                
        Select Case KeyWord_Calc
            Case "V"
                If bStringCheck Then
                    TheExec.Datalog.WriteComment "The Equation: " & tempStr_Equation & ", format is wrong. It cannot be divided the value zero."
                Else
                    Call ProcessPLDCalculation_Complexity(tempStr_Equation, ReturnPLD, CalcEquation_PLD)
                End If
                              
                If UBound(SplitByColon) = 3 Then
                    Call StoreDataAllType(DictKeyName, ReturnPLD)
                End If
                
                If Not ByPassTestLimit Then
	                For p = 0 To ReturnPLD.Pins.Count - 1
	                    TheExec.Flow.TestLimitIndex = tempIndex
	                    If EnableDigitalTestLimitTTR = True Then
	                        TestNameInput = Report_TName_From_Instance("CalcV", "X", , 0)
	                    Else
	                        TestNameInput = Report_TName_From_Instance("CalcV", ReturnPLD.Pins(p), , 0)
	                    End If
	                    TheExec.Flow.TestLimit resultVal:=ReturnPLD.Pins(p), Tname:=TestNameInput, scaletype:=scaleNoScaling, ForceResults:=tlForceFlow
	                Next p
                End If
                
            Case "F"
                If bStringCheck Then
                    TheExec.Datalog.WriteComment "The Equation: " & tempStr_Equation & ", format is wrong. It cannot be divided the value zero."
                Else
                    Call ProcessPLDCalculation_Complexity(tempStr_Equation, ReturnPLD, CalcEquation_PLD)
                End If
                                
                If UBound(SplitByColon) = 3 Then
                    Call StoreDataAllType(DictKeyName, ReturnPLD)
                End If
                
                If Not ByPassTestLimit Then
                    For p = 0 To ReturnPLD.Pins.Count - 1
                        TheExec.Flow.TestLimitIndex = tempIndex
'                        TestNameInput = Report_TName_From_Instance("CalcF", ReturnPLD.Pins(p), SplitByColon(1), 0)
                        If EnableDigitalTestLimitTTR = True Then
                            TestNameInput = Report_TName_From_Instance("CalcF", "X", , 0)
                        Else
                        TestNameInput = Report_TName_From_Instance("CalcF", ReturnPLD.Pins(p), , 0)
                        End If
                        TheExec.Flow.TestLimit resultVal:=ReturnPLD.Pins(p), Tname:=TestNameInput, scaletype:=scaleNoScaling, ForceResults:=tlForceFlow
                    Next p
                End If
                
            Case "I"
                If bStringCheck Then
                    TheExec.Datalog.WriteComment "The Equation: " & tempStr_Equation & ", format is wrong. It cannot be divided the value zero."
                Else
                    Call ProcessPLDCalculation_Complexity(tempStr_Equation, ReturnPLD, CalcEquation_PLD)
                End If
                
                If UBound(SplitByColon) = 3 Then
                    Call StoreDataAllType(DictKeyName, ReturnPLD)
                End If
                
                If Not ByPassTestLimit Then
                    For p = 0 To ReturnPLD.Pins.Count - 1
                        TheExec.Flow.TestLimitIndex = tempIndex
'                        TestNameInput = Report_TName_From_Instance("CalcI", ReturnPLD.Pins(p), SplitByColon(1), 0)
                        If EnableDigitalTestLimitTTR = True Then
                            TestNameInput = Report_TName_From_Instance("CalcI", "X", , 0)
                        Else
                        TestNameInput = Report_TName_From_Instance("CalcI", ReturnPLD.Pins(p), , 0)
                        End If
                        TheExec.Flow.TestLimit resultVal:=ReturnPLD.Pins(p), Tname:=TestNameInput, scaletype:=scaleNoScaling, ForceResults:=tlForceFlow
                    Next p
                End If

             Case "R" '20230714 sync RF feature
                If bStringCheck Then
                    TheExec.Datalog.WriteComment "The Equation: " & tempStr_Equation & ", format is wrong. It cannot be divided the value zero."
                Else
                    Call ProcessPLDCalculation_Complexity(tempStr_Equation, ReturnPLD, CalcEquation_PLD)
                End If
                
                If UBound(SplitByColon) = 3 Then
                    Call StoreDataAllType(DictKeyName, ReturnPLD)
                End If
                
                For p = 0 To ReturnPLD.Pins.Count - 1
                    TheExec.Flow.TestLimitIndex = tempIndex
                    If EnableDigitalTestLimitTTR = True Then
                        TestNameInput = Report_TName_From_Instance("CalcR", "X", , 0)
                    Else
                        TestNameInput = Report_TName_From_Instance("CalcR", ReturnPLD.Pins(p), , 0)
                    End If
                    TheExec.Flow.TestLimit resultVal:=ReturnPLD.Pins(p), Tname:=TestNameInput, scaletype:=scaleNoScaling, ForceResults:=tlForceFlow
                Next p          
            Case "C"
                If bStringCheck Then
                    TheExec.Datalog.WriteComment "The Equation: " & tempStr_Equation & ", format is wrong. It cannot be divided the value zero."
                Else
                    Call ProcessDSPCalculation_Complexity(tempStr_Equation, ReturnDSPWave)
                End If

                Dim SiteDbl_ReturnDSPWave As New SiteDouble
                If UBound(SplitByColon) = 3 Then
                    For Each site In TheExec.sites
                        SiteDbl_ReturnDSPWave(site) = ReturnDSPWave(site).Element(0)
                    Next site
                    Call StoreDataAllType(DictKeyName & "_para", SiteDbl_ReturnDSPWave)
                    Call StoreDataAllType(DictKeyName, ReturnDSPWave)
                End If
                
                If Not ByPassTestLimit Then
                    TestNameInput = Report_TName_From_Instance("CalcC", vbNullString, , 0)
                    TheExec.Flow.TestLimit resultVal:=ReturnDSPWave.Element(0), Tname:=TestNameInput, ForceResults:=tlForceFlow
                End If
                
            Case "ALG"
                SplitByLeftPara = Split(SplitByColon(2), "(")
                
                ALG_InterPoseFuncName = SplitByLeftPara(0)
                ALG_InterPoseArgcName = Replace(SplitByLeftPara(1), ")", vbNullString)
                
''                TheExec.Flow.SetInterpose 1, ALG_InterPoseFuncName, ALG_InterPoseArgcName    ' key, func name, arguments
''                TheExec.Flow.ExecuteInterpose 1

                Call Interpose(ALG_InterPoseFuncName, ALG_InterPoseArgcName)
                
             Case "CDIV2"
                operator = GetSplitKeyWord(SplitByColon(1))
                SplitByKeyWord = Split(SplitByColon(1), operator)
                Call ProcessDSPCalculation_DIV2(SplitByKeyWord, operator, ReturnDSPWave)
                Dim Convet_toDouble As New SiteDouble
                For Each site In TheExec.sites
                     Convet_toDouble = ReturnDSPWave.Element(0)
                Next site
                If UBound(SplitByColon) = 2 Then
                    Call StoreDataAllType(SplitByColon(2) & "_para", Convet_toDouble)
                End If
                
                If Not ByPassTestLimit Then
                    
                    TestNameInput = Report_TName_From_Instance("CalcC", vbNullString, , 0)
                    TheExec.Flow.TestLimit resultVal:=ReturnDSPWave.Element(0), Tname:=TestNameInput, ForceResults:=tlForceFlow
                End If
            Case Else
            
        End Select
    Next i
    'TTR,20200423, Oscar
    'TheHdw.DSP.EnableHostThreadMode = False
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "ProcessCalcEquation") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function


