            TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I WaitTime, " & MeasI.Pins.VSM & " =" & MeasI.WaitTime.VSM)
        End If
    Else
        For i = 0 To UBound(MeasI.Setup_ByTypeByPin.VSM)
            With TheHdw.DCVS.Pins(MeasI.Setup_ByTypeByPin.VSM(i).pin)
                '.Meter.mode = tlDCVSMeterCurrent   'T-Est TTR approve by Si -- 230502
				If TheExec.Flow.enableWord("HardIP_Autorange") = True And InStr(UCase(Instance_Data.CUS_Str_DigSrcData), "BYP_CURR_AUTORANGE") = 0 Then
				Else	
                    If MeasI.Setup_ByTypeByPin.VSM(i).Meas_Range <> "0" Then .SetCurrentRanges CDbl(MeasI.Setup_ByTypeByPin.VSM(i).Meas_Range), CDbl(MeasI.Setup_ByTypeByPin.VSM(i).Meas_Range)
                End If
                .Gate = True
            End With
            If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range setting, " & MeasI.Setup_ByTypeByPin.VSM(i).pin & " =" & TheHdw.DCVS.Pins(MeasI.Setup_ByTypeByPin.VSM(i).pin).Meter.CurrentRange.value)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range Program setting, " & MeasI.Setup_ByTypeByPin.VSM(i).pin & " =" & MeasI.Setup_ByTypeByPin.VSM(i).Meas_Range)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range WaitTime, " & MeasI.Setup_ByTypeByPin.VSM(i).pin & " =" & MeasI.WaitTime.VSM)
            End If
        Next i
    End If
    TheHdw.DCVS.Pins(MeasI.Pins.VSM).Meter.mode = tlDCVSMeterCurrent    'T-Est TTR approve by Si -- 230502
    TheHdw.Wait CDbl(MeasI.WaitTime.VSM)
    
    If TheExec.Flow.enableWord("CurrentProfile") = False And TheExec.Flow.enableWord("VoltageProfile") = False And Profile_byflow = False Then
        measureCurrent = TheHdw.DCVS.Pins(MeasI.Pins.VSM).Meter.Read(tlStrobe, sampleSize, pc_Def_HexVS_ReadPoint, tlDCVSMeterReadingFormatAverage)
    Else
        Dim p As Variant
        Dim Pin_Cnt As Long
        Dim Pins() As String
        Dim Dummy_Value As New SiteDouble: Dummy_Value = 0.0001
        For Each p In Split(MeasI.Pins.VSM, ",")
            TheExec.DataManager.DecomposePinList p, Pins, Pin_Cnt
            For i = 0 To Pin_Cnt - 1
                measureCurrent.AddPin Pins(i)
                measureCurrent.Pins(Pins(i)) = Dummy_Value
            Next i
        Next p
    End If
    
    Call HardIP_DCVS_MI_StoreAndRestoreCondition(MeasI, VSM, False)

Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_SetupAndMeasureCurrent_VSM") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

