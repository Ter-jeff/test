End Function

Public Function ProcessDSPCalculation_Complexity(ByVal CalcEquationPLD As String, ByRef RTN_DSPWave As DSPWave) As Long
    On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    Dim i As Long
    
    Dim bStringCheck As Boolean
    
    Dim temp As String
    Dim tempStr_Equation As String
    Dim tempStr_CalcElementArr() As String
    Dim tempSiteStr_Equation As New SiteVariant
    
    Dim DicVal As New SiteDouble
    Dim finalResult As New SiteDouble
    Dim site As Variant 'Carter, 20240304
    tempStr_Equation = CalcEquationPLD
    
    tempStr_Equation = RegExReplaceString(tempStr_Equation, "[\+\-\*\/\^]", "@", False)
    tempStr_Equation = RegExReplaceString(tempStr_Equation, "\(?\)?", "", False)
    tempStr_CalcElementArr = Split(tempStr_Equation, "@")
    
    For i = 0 To UBound(tempStr_CalcElementArr)
        If InStr(UCase(tempStr_CalcElementArr(i)), DC_Spec_Var) <> 0 Then
            temp = EvaluateForDCSpec(tempStr_CalcElementArr(i))
            CalcEquationPLD = Replace(CalcEquationPLD, tempStr_CalcElementArr(i), temp)
            tempStr_CalcElementArr(i) = temp
        End If
    Next i
    
    tempSiteStr_Equation = CalcEquationPLD
    
    For i = 0 To UBound(tempStr_CalcElementArr)
        If IsNumeric(tempStr_CalcElementArr(i)) = False Then
            DicVal = GetStoreDataAllType(tempStr_CalcElementArr(i) & "_para")
            For Each site In TheExec.sites.Selected
                tempSiteStr_Equation = Replace(tempSiteStr_Equation, tempStr_CalcElementArr(i), CStr(DicVal))
            Next site
        End If
    Next i
    For Each site In TheExec.sites.Selected
        temp = CStr(tempSiteStr_Equation)
        bStringCheck = RegExCheckString(temp, "\w+\s?[\/]\s?[0]", False)
        If bStringCheck Then
            TheExec.Datalog.WriteComment "The Equation: " & temp & ", format is wrong. It cannot be divided the value zero."
        Else
            finalResult = Evaluate(CStr(tempSiteStr_Equation))
            RTN_DSPWave.Element(0) = finalResult
        End If
                
    Next site
        
        Exit Function
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "ProcessDSPCalculation_Complexity") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function


Public Function RegExReplaceString(ByRef sinputStr As String, ByVal sPattern As String, Optional sReplace As String = "", Optional ByVal bIgnoreCase As Boolean = False) As String
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    Dim sTemp As String
    Dim RegEx As Object
    Set RegEx = CreateObject("vbscript.regexp")
    With RegEx
        .Global = True
        .Pattern = sPattern        'none number
        .IgnoreCase = bIgnoreCase
        If .test(sinputStr) Then
            RegExReplaceString = .Replace(sinputStr, sReplace)
        End If
    End With
        Exit Function
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "Public Function RegExReplaceString") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function Split_Dspwave_LSBtoMSB_ByTname(CUS_Str_MainProgram As String, DecomposeParseDigCapBit() As String, DecomposeTestName() As String, SourceBitStrmWf As DSPWave, width_Wf As DSPWave, OutWf As DSPWave) As Long
                        On Error GoTo errHandler 'Add ErrHandler 2023/05/29
            Dim i As Long
            Dim Index_LSB2MSB As Long
            Dim DSSC_SplitBySemiColon() As String: DSSC_SplitBySemiColon = Split(CUS_Str_MainProgram, ";")
            Dim DSSC_LSB2MSB() As String
            Dim DSSC_LSB2MSB_StartBit As New DSPWave
            Dim DSSC_LSB2MSB_StartBit_Array() As Long
            Dim AccumulateParseDigCapBit() As Long: ReDim AccumulateParseDigCapBit(UBound(DecomposeParseDigCapBit)) As Long
            Dim s_ErrorStatement As String
            Dim MSB_Wf As New DSPWave
            Dim MSB_Wf_arr() As Long
            Dim NumberofDict As Long
            If InStr(DSSC_SplitBySemiColon(0), ":") = 0 Then
                NumberofDict = UBound(DecomposeTestName)
                ReDim MSB_Wf_arr(NumberofDict) As Long
                For i = 0 To UBound(DecomposeTestName)
                        MSB_Wf_arr(i) = 1
                        MSB_Wf.data = MSB_Wf_arr
                Next i
                rundsp.Split_Dspwave_MSB SourceBitStrmWf, width_Wf, OutWf, MSB_Wf
            Else
                DSSC_LSB2MSB = Split("dummy", ":")
                For i = 0 To UBound(DSSC_SplitBySemiColon)
                    If UCase(DSSC_SplitBySemiColon(i)) Like UCase("DigCap_LSBtoMSB*") Then
                        DSSC_LSB2MSB = Split(Split(DSSC_SplitBySemiColon(i), ":")(1), ",")
                    End If
                Next i
                NumberofDict = UBound(DSSC_LSB2MSB)
                ReDim DSSC_LSB2MSB_StartBit_Array(UBound(DSSC_LSB2MSB)) As Long
                ReDim MSB_Wf_arr(UBound(DecomposeTestName)) As Long
                
                For i = 0 To UBound(DecomposeTestName)
                    If i = 0 Then
                        AccumulateParseDigCapBit(i) = DecomposeParseDigCapBit(i)
                    Else
                        AccumulateParseDigCapBit(i) = AccumulateParseDigCapBit(i - 1) + DecomposeParseDigCapBit(i)
                    End If
                    'Add UCase judge for fixed segment name misalignment issue between Test_Plan and Pat_Info -- 20230410
                    If UCase(DecomposeTestName(i)) = UCase(DSSC_LSB2MSB(Index_LSB2MSB)) Then
                        DSSC_LSB2MSB_StartBit_Array(Index_LSB2MSB) = AccumulateParseDigCapBit(i) - DecomposeParseDigCapBit(i)
                        If Index_LSB2MSB <> UBound(DSSC_LSB2MSB) Then: Index_LSB2MSB = Index_LSB2MSB + 1
                        MSB_Wf_arr(i) = 1
                    Else
                        MSB_Wf_arr(i) = 0
                    End If
                Next i
                
                MSB_Wf.data = MSB_Wf_arr
                
                If UBound(DSSC_LSB2MSB) = 0 And (LCase(DSSC_LSB2MSB(0)) = "nouse" Or LCase(DSSC_LSB2MSB(0)) = "dummy") Then DSSC_LSB2MSB_StartBit_Array(0) = Instance_Data.DigCap_Sample_Size + 1
                DSSC_LSB2MSB_StartBit.data = DSSC_LSB2MSB_StartBit_Array
                rundsp.Split_Dspwave_MSB SourceBitStrmWf, width_Wf, OutWf, MSB_Wf
            End If
        Exit Function
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "Public Function Split_Dspwave_LSBtoMSB_ByTname") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function


Public Function HardIP_SetupAndMeasureVolt_UltraCapture(ByRef MeasureVolt As PinListData) As Long
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    Dim MeasV As Meas_Type
    Dim i As Long
    Dim Pins() As String
    Dim Pin_Cnt As Long
    MeasV = TestConditionSeqData(Instance_Data.TestSeqNum).MeasV(Instance_Data.TestSeqSweepNum)
    
    Dim lclStr_Signal As String
    Dim lclStrAry_Temp() As String
    Dim lclStr_MainProgram As String
    Dim lclStrAry_MainProgram() As String
    Dim lclStrAry_MainProgram_Para() As String
    Dim lclStr_MeasSetup As String
    Dim lclStr_Instrument As String
    Dim lclLng_Termination As Long
    Dim lclDbl_BW As Double
    Dim lclDbl_Offset As Double
    Dim lclDbl_InputDelay As Double
    Dim lclDbl_VoltageRange As Double
    Dim lclPld_cap As New PinListData
    
    
    If InStr(UCase(Instance_Data.CUS_Str_MainProgram), ";") <> 0 Then
        lclStrAry_Temp = Split(Instance_Data.CUS_Str_MainProgram, ";")
        For i = 0 To UBound(lclStrAry_Temp)
            If InStr(UCase(lclStrAry_Temp(i)), UCase("UltraCapture")) Then
                lclStr_MainProgram = Instance_Data.CUS_Str_MainProgram
                lclStrAry_MainProgram = Split(Instance_Data.CUS_Str_MainProgram, ":")
                lclStrAry_MainProgram_Para = Split(lclStrAry_MainProgram(1), ",")
                lclStr_Instrument = lclStrAry_MainProgram(0)
                
                lclStr_MeasSetup = UCase(lclStrAry_MainProgram_Para(0))
                lclDbl_VoltageRange = CDbl(lclStrAry_MainProgram_Para(1))
                lclDbl_Offset = CDbl(lclStrAry_MainProgram_Para(3))
                lclDbl_InputDelay = CDbl(lclStrAry_MainProgram_Para(4))
                
                If lclStrAry_MainProgram_Para(2) = 50000 Then
                    lclDbl_BW = 0
                ElseIf lclStrAry_MainProgram_Para(2) = 30000000 Then
                    lclDbl_BW = 1
                ElseIf lclStrAry_MainProgram_Para(2) = 75000000 Then
                    lclDbl_BW = 2
                Else
                    lclDbl_BW = 1
                End If
                
                If UCase(lclStrAry_MainProgram_Para(5)) = UCase("tlUltraCaptureTermination_HiZ") Then
                    lclLng_Termination = 0
                ElseIf lclStrAry_MainProgram_Para(5) = UCase("tlUltraCaptureTermination_Term50") Then
                    lclLng_Termination = 1
                End If
                Exit For
            Else
''                theexec.Datalog.WriteComment "-----> Here is default setting for UltraPac80 Capture"
                lclStr_MeasSetup = "V"
                lclDbl_VoltageRange = 3
                lclDbl_BW = 50000
                lclDbl_Offset = 0
                lclDbl_InputDelay = 0
                lclLng_Termination = tlUltraCaptureTermination_Term50
            End If
        Next i
    End If
   
   If lclStr_Signal = "" Then lclStr_Signal = TheExec.DataManager.instancename & "_CapSingal_" & Instance_Data.TestSeqNum
    
''CUS_Str_MainProgram = "Instrument:MeasType,VoltageRange,BW,Offset,InputDelay,Termination"
''CUS_Str_MainProgram = "UltraCapture:VDM,0.25,50000,0,0,tlUltraCaptureTermination_HiZ"
''CUS_Str_MainProgram = "UltraCapture:V,0.25,30000000,0.1,0,tlUltraCaptureTermination_Term50"
    
''    TheHdw.UltraCapture.Pins(MeasV.Pins.UltraCapture).Connect tlUltraCaptureFrom_Default, tlUltraCaptureTo_DUT
    ''MeasV.Pins.UltraCapture = "ARF_PADIO_TEST_OUTN_WLRXBB_5G_0_CAP,ARF_PADIO_TEST_OUTN_WLRXBB_5G_1_CAP"
    ''MeasV.Pins.UltraCapture = "ARF_PADIO_TEST_OUTN_WLRXBB_5G_0_CAP,ARF_PADIO_INOUT_TESTN_RXBB_2G_0_CAP"
    
    ''___ make sure ppmu is disconnected from UPAC cap _____
    TheHdw.PPMU(MeasV.Pins.UltraCapture).Disconnect
        
    If MeasV.Setup_ByTypeByPin_Flag = False Then
    With TheHdw.UltraCapture.Pins(MeasV.Pins.UltraCapture)
        'set signal and default signal
        .Signals.Add lclStr_Signal
        .Signals.DefaultSignal = lclStr_Signal
        'set connection, differential/single-ended
            
            If MeasV.DiffMeter_Flag = False Then
            .Connect tlUltraCaptureFrom_Pos
                If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
                    TheExec.Datalog.WriteComment (glb_TestInstance & " =====> " & MeasV.Pins.UltraCapture & " = Single-End Mode  ")
                End If
            ElseIf MeasV.DiffMeter_Flag = True Then
            '.Connect tlUltraSourceFrom_Default
            .Connect tlUltraCaptureFrom_Neg
            .Connect tlUltraCaptureFrom_Pos
                If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
                    TheExec.Datalog.WriteComment (glb_TestInstance & " =====> " & MeasV.Pins.UltraCapture & " = Differential Mode  ")
                End If
            End If
        With .Signals(lclStr_Signal)
            'set bandwidth
            .Bandwidth = lclDbl_BW
            'set voltage range
            '.VoltageRange = lclDbl_VoltageRange
            'set sample rate
            .SampleRate = 10000
            .sampleSize = 25
            'set offset removal
            If lclDbl_Offset <> 0 Then
''                If CntPins = 1 Then
''                    .offset.Enable = tlUltraCaptureOffsetEnable_PosEnable
''                ElseIf CntPins = 2 Then
''                    .offset.Enable = tlUltraCaptureOffsetEnable_PosAndNegEnable
''                End If
                .offset.value = lclDbl_Offset
            End If
            'set input delay
            .InputDelay = lclDbl_InputDelay
            'set termination
            .Termination = lclLng_Termination
            .VoltageRange = 1.25
            'iq cal
''            If IQMode = True Then
''                .Calibration.IQEnabled = True
''                If UpacCap.Reserved1 = vbNullString Then
''                    .Calibration.FrequencyOfInterest = 5000000#
''                ElseIf InStr(1, UCase(UpacCap.Reserved1), "RBW") = 0 Then
''                    .Calibration.FrequencyOfInterest = UpacCap.Reserved1
''                End If
''            End If
            'Retrieve Result
            lclPld_cap = .DSPWave
            'load
            .LoadSettings
            .Trigger
        End With
    End With
    Else
        
    End If
    
    Dim avg As New SiteDouble
    Dim stdDev As New SiteDouble
    Dim maxmin As New SiteDouble
    Dim PinTEMP() As String
    Dim measResultPLD As New PinListData
    TheExec.DataManager.DecomposePinList MeasV.Pins.UltraCapture, Pins, Pin_Cnt
    'Post Calc
    '' for differential capture, no data existing in pin2 that lead to dsp wave specified timeout
    For i = 0 To 0 'Pin_Cnt - 1
        Dim capWave As New DSPWave
        PinTEMP = Split(Pins(i), ",")
        capWave = lclPld_cap.Pins(0)
        rundsp.post_process_capwave_variance capWave, avg, stdDev, maxmin
        measResultPLD.AddPin (PinTEMP(0))
        measResultPLD.Pins(PinTEMP(0)).value = avg
    Next i
    MeasureVolt = measResultPLD

    If MeasV.DiffMeter_Flag = False Then
        TheHdw.UltraCapture.Pins(MeasV.Pins.UltraCapture).Disconnect tlUltraCaptureFrom_Pos
    ElseIf MeasV.DiffMeter_Flag = True Then
        '.Connect tlUltraSourceFrom_Default
        TheHdw.UltraCapture.Pins(MeasV.Pins.UltraCapture).Disconnect tlUltraCaptureFrom_Neg
        TheHdw.UltraCapture.Pins(MeasV.Pins.UltraCapture).Disconnect tlUltraCaptureFrom_Pos
    End If
    
Exit Function
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_SetupAndMeasureVolt_UltraCapture") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

'[20230901][All][Carter] For UVS256HP/UVS64 setup voltage range on UFP
Public Function VoltageRange_Select(Pin_value As Double) As Double
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    Dim d_temp As Double

    If Pin_value >= 0 And Pin_value <= 3 Then
        d_temp = pc_Def_UFP_DCVS_VoltageRange
    ElseIf Pin_value < 0 Or Pin_value > 3 Then
        d_temp = pc_Def_UFP_DCVS_Relax_VoltageRange
    Else
    End If
    VoltageRange_Select = d_temp
Exit Function
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "VoltageRange_Select") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function



