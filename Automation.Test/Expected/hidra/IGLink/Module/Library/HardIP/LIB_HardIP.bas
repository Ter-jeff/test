Public Function ProcessSweepVoltageString(customerstring As String, ByRef sweepVoltage_ary() As String, sweepVoltage_Loop_Max As Long) As Long
    'Format : sweepsrc:sweepvoltage=StartV@StopV@StepV
    'EX:CUS_Str_MainProgram => sweepsrc:sweepvoltage=0.1@0.4@0.1 [Linear]
    'EX:CUS_Str_MainProgram => sweepsrc:sweepvoltage=0.1,0.4,0.8 [List]
    On Error GoTo errHandler:
    Dim nSplitByEqual() As String
    Dim nSplitByAt() As String      'Use for Linear mode [@]
    Dim sweepVoltage_Pins As String
    Dim sweepVoltage_Start As Double
    Dim sweepVoltage_Stop As Double
    Dim sweepVoltage_Step As Double
    Dim sweepVoltage_temp As Double
    Dim sweepEvaluateDC(0) As String 'Add Compatible input level from DC spec -- 20220923
    Dim loop_i As Long
    
    'T-Dip SweepVoltage function for VTHSENSOR -- 20220915
    Dim temp_vol_str As String
    Dim temp_vol_ary() As String
    nSplitByEqual = Split(customerstring, "=")
    'New update support Sweep Voltage use Linear mode and List mode -- 20221018
    If InStr(nSplitByEqual(1), "@") <> 0 Then
        '=== Linear sweep voltage mode ===
        'EX:CUS_Str_MainProgram => sweepsrc:sweepvoltage=0.1@0.4@0.1 [Linear]
        nSplitByAt = Split(nSplitByEqual(1), "@")
        'Add Compatible input level from DC spec -- 20220923
        sweepEvaluateDC(0) = nSplitByAt(0)
        Call HIP_Evaluate_ForceVal(sweepEvaluateDC)
        sweepVoltage_Start = CDbl(sweepEvaluateDC(0))
        sweepEvaluateDC(0) = nSplitByAt(1)
        Call HIP_Evaluate_ForceVal(sweepEvaluateDC)
        sweepVoltage_Stop = CDbl(sweepEvaluateDC(0))
        sweepVoltage_Step = CDbl(nSplitByAt(2))
        sweepVoltage_Loop_Max = CLng(FormatNumber((sweepVoltage_Stop - sweepVoltage_Start) / sweepVoltage_Step))
        
        ReDim sweepVoltage_ary(sweepVoltage_Loop_Max)
        For loop_i = 0 To CLng(FormatNumber((sweepVoltage_Stop - sweepVoltage_Start) / sweepVoltage_Step))
            If loop_i = 0 Then
                sweepVoltage_temp = 9999
                sweepVoltage_temp = sweepVoltage_Start
            Else
                sweepVoltage_temp = sweepVoltage_temp + sweepVoltage_Step
            End If
            'Store Force Value Array
            sweepVoltage_ary(loop_i) = sweepVoltage_temp
        Next loop_i
    ElseIf InStr(nSplitByEqual(1), ",") <> 0 Then
        '=== List sweep voltage mode ===
        'EX:CUS_Str_MainProgram => sweepsrc:sweepvoltage=0.1,0.4,0.8 [List]
        sweepVoltage_ary = Split(nSplitByEqual(1), ",")
        sweepVoltage_Loop_Max = CLng(UBound(sweepVoltage_ary))
    End If
    
    Exit Function
errHandler:
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "ProcessSweepVoltageString")
    If AbortTest Then Exit Function Else Resume Next
End Function

