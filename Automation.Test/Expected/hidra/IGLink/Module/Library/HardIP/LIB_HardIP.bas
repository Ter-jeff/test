                         SuggestMeterCurrentRange = 0.01
                    
                    End If
                    
                Case Else
                    
            End Select
        
        Case "HSD-U"    'Fixed wrong keyword setting -- 20230531
                
            If HighUseLimitVal > 0.05 Then
                TheExec.Datalog.WriteComment ("Wrong setting - High use-limit over spec 0.05A of HSD-U")
            
            ElseIf HighUseLimitVal > 0.002 Then
                 SuggestMeterCurrentRange = 0.05
                 
            ElseIf HighUseLimitVal > 0.0002 Then
                 SuggestMeterCurrentRange = 0.002
                 
            ElseIf HighUseLimitVal > 0.00002 Then
                 SuggestMeterCurrentRange = 0.0002
            
            ElseIf HighUseLimitVal > 0.000002 Then
                  SuggestMeterCurrentRange = 0.00002
              
            Else
                 SuggestMeterCurrentRange = 0.000002
            
            End If
            
        Case "HSDP"
        
            If HighUseLimitVal > 0.05 Then
                TheExec.Datalog.WriteComment ("Wrong setting - High use-limit over spec 0.05A of HSDP")
            
            ElseIf HighUseLimitVal > 0.002 Then
                 SuggestMeterCurrentRange = 0.05
                 
            ElseIf HighUseLimitVal > 0.0002 Then
                 SuggestMeterCurrentRange = 0.002
                 
            ElseIf HighUseLimitVal > 0.00002 Then
                 SuggestMeterCurrentRange = 0.0002
            
            ElseIf HighUseLimitVal > 0.000002 Then
                  SuggestMeterCurrentRange = 0.00002
              
            Else
                 SuggestMeterCurrentRange = 0.000002
            
            End If
            
        
        Case Else
        
    End Select

Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "GetAppropriateMeterCurrentRange") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

