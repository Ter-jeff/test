Public Function PatternModuleDataLogging(PatternAry() As String)
    On Error GoTo errHandler
    
    Dim i As Long
    For i = 0 To UBound(PatternAry)
        If InStr(PatternAry(i), ":") Then
            TheExec.Datalog.WriteComment ">>>>>>> Pattern Module " + CStr(i) + ": " + Split(PatternAry(i), ":")(1) + " <<<<<<<"
        Else
            TheExec.Datalog.WriteComment ">>>>>>> Pattern Module " + CStr(i) + ": " + PatternAry(i) + " <<<<<<<"
        End If
        
    Next i
    
    Exit Function
                                                                                                                                                                                                                                                               
errHandler:
    TheExec.Datalog.WriteComment "error in SelSRAM_Voltage_To_PLD"
    If AbortTest Then Exit Function Else Resume Next

End Function