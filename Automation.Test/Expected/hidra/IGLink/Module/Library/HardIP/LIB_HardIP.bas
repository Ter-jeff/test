                    'Register1 = ABC_CA, repeat = 1001, Dict
                    DigSrc_Assignment_Print = vbCrLf & Original_Assignment & "(" & DigSrc_Assignment_Print & ")" & vbCrLf 'test1_ModeA then use the original assignment & (replaced assignment)
                Else
                    DigSrc_Assignment_Print = vbCrLf & Original_Assignment & vbCrLf 'repeat=1000, register=1000, Dict(A=ABC_A) keeps the original
                End If
                '=========================================180410 added by Oscar
                If b_DigSrcFromDict Then
                    InDSPWave = GetStoreDataAllType(digsrc_assignment)
    
                    '*******************************New Feature for trimcode table*******************************
                    'Added by  20190509
                    For Each site In TheExec.sites
                        If InDSPWave.DataSize <> DigSrc_Sample_Size Then
                            TheExec.AddOutput "Error : DigSrc Samplesize is mismatch"
                            GoTo errHandler:
                        End If
                    Next site
                    '********************************************************************************************
    
                    If gl_Disable_HIP_debug_log = False Then
                        If UBound(DigSrcEquation_Split) <> -1 Then
                            TheExec.Datalog.WriteComment "DataSequence:" & DigSrcEquation_Split(i)
                        End If
                        TheExec.Datalog.WriteComment "Assignment:" & digsrc_assignment
        ''                TheExec.Datalog.WriteComment "Output String [ LSB(L) ==> MSB(R) ]:"
                        If MSB_First_Flag Then
                            TheExec.Datalog.WriteComment "Output String [ MSB(L) ==> LSB(R) ]:"
                        Else
                            TheExec.Datalog.WriteComment "Output String [ LSB(L) ==> MSB(R) ]:"
                        End If
                    End If
            
                    For Each site In TheExec.sites
                        DigSrc_Ary = InDSPWave(site).data
                       ' TheExec.Datalog.WriteComment ("[Site " & site & "]")
                        Call Printout_DigSrc(DigSrc_Ary, DigSrc_Sample_Size, DigSrc_DataWidth, , site)
                    Next site

                    Call SetupDigSrcDspWave(Pat, DigSrc_pin_PinList, sSrcSigName, DigSrc_Sample_Size, InDSPWave) ''Setup DSPWave, 20190508

                    Dim Table_Decvalue As String

    '''            If InStr(DigSrc_Assignment, "digsrctable") <> 0 Then
    '''                  Table_Decvalue = ""
    '''                  gl_SweepNum = ""
    '''                   For k = 0 To DigSrc_Sample_Size - 1 Step 1
    '''                      Table_Decvalue = Table_Decvalue & InDSPWave.Element(i)
    '''                   Next k
    '''                   gl_SweepNum = BinStr2HexStr(Table_Decvalue, (DigSrc_Sample_Size \ 4) + 1)
    '''            End If
                Else
                    ''20160826 - Check DigSrc_Assignment's content to decide whether to store InDSPWave to the Dictionary
                    b_StoreWholeDigSrc = Checker_StoreWholeDigSrcInDict(digsrc_assignment, DigSrcWholeDictName)
            
                    '----------------Added by Oscar 0424------------
                    If InStr(Original_Assignment, "(") <> 0 Then b_StoreWholeDigSrc = True 'Test1_ModeA has already split but the flag was turn false on the last func.
                    '----------------Added by Oscar 0424------------

                    ''20160805 - Analyze DigSrc_Equation and DigSrc_Assignment inout format whether violate design rule
                    Call AnalyzeDigSrcEquationAssignmentContent(AssemblyEquation, digsrc_assignment)

                    ' CS Edited by 20191755
                    ' For Multi DigSrc Function
                    If gl_Disable_HIP_debug_log = False And Len(AssemblyEquation) < 8000 Then
                        TheExec.Datalog.WriteComment "DataSequence:" & AssemblyEquation
                        TheExec.Datalog.WriteComment "Assignment:" & digsrc_assignment
                        If MSB_First_Flag Then
                            TheExec.Datalog.WriteComment "Output String [ MSB(L) ==> LSB(R) ]:"
                        Else
                            TheExec.Datalog.WriteComment "Output String [ LSB(L) ==> MSB(R) ]:"
                        End If
                    End If


                    For Each site In TheExec.sites
                        Call Create_DigSrc_Data(DigSrc_pin_PinList, DigSrc_DataWidth, CreateDigSrcDataSize, AssemblyEquation, digsrc_assignment, InDSPWave, site, , NumberPins, MSB_First_Flag)
                    Next site

                    ''20161121-Setup DigSrc by serial or parallel
                    If b_SrcTypeIsParallel Then
                        rundsp.BitWf2Arry InDSPWave, NumberPins, NoOfSamples, InDSPWave_Parallel
                        Call SetupDigSrcDspWave(Pat, DigSrc_pin_PinList, "Meas_Src_Parallel", DigSrc_Sample_Size, InDSPWave_Parallel)
                    Else
                        If b_StoreWholeDigSrc Then
                            Call StoreDataAllType(DigSrcWholeDictName, InDSPWave)
                        End If
                        Call SetupDigSrcDspWave(Pat, DigSrc_pin_PinList, sSrcSigName, DigSrc_Sample_Size, InDSPWave)
                    End If
                End If
                'If gl_Disable_HIP_debug_log = False Then TheExec.DataLog.WriteComment ("Src Pin =" & DigSrc_pin.Value)
                If gl_Disable_HIP_debug_log = False Then TheExec.Datalog.WriteComment ("======== Setup Dig Src Test End   ========")
            End If
        Next j
    Next i
    
    Exit Function
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "TrimCodeFreq_GeneralDigSrcSetting") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function BinaryData_Convert(InputString As String, keyword As String) As String
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
'Support BinaryToGray/BinaryToGray_Sign/BinaryToDec as string format -- 20221018 by Brian
'Ex. A= BinaryData_Convert(Input_Binary_Str,Algorithm)  [Algorithm : BinToGray/BinToGray_Sign/BinToGray_DEC/BinToGray_Sign_DEC/DEC]
'LSB -> MSB

Dim z As Long
Dim k As Long
Dim m_binarr_temp As String
Dim srcbit As Long
Dim swpgray As String
Dim splitbycondon() As String
Dim splitbycondon_Temp() As String
Dim SrcBitsgray As String
Dim DecValue As Double
Dim DecSign As Boolean
'If InStr(LCase(keyword), "BinToGray") Then
If LCase(keyword) = "bintogray" Then
    splitbycondon = Split(InputString, ",")
    For z = 0 To UBound(splitbycondon) Step 1
        m_binarr_temp = splitbycondon(z) ' m_binarr_temp = (0)00011010,(1)11001101...
        srcbit = Len(m_binarr_temp) - 1
        ReDim m_binarr(srcbit) As Long
        
        For k = 0 To srcbit Step 1
            m_binarr(srcbit - k) = mid(m_binarr_temp, k + 1, 1)
        Next k
        
        ReDim m_binarr_graycode(srcbit) As Long
        
        For k = 0 To UBound(m_binarr) Step 1
            If k = 0 Then
                m_binarr_graycode(k) = m_binarr(k)
            Else
                If m_binarr(k - 1) = m_binarr(k) Then
                    m_binarr_graycode(k) = 0
                Else
                    m_binarr_graycode(k) = 1
                End If
            End If
        Next k
           
        For k = 0 To srcbit Step 1
            If k = 0 Then
                swpgray = m_binarr_graycode(k)
            Else
                swpgray = m_binarr_graycode(k) & swpgray
            End If
        Next k
        
        splitbycondon(z) = swpgray
        swpgray = ""
        If z = 0 Then
            If InStr(LCase(keyword), "_dec") Then
                DecValue = Bin2Dec(StrReverse(splitbycondon(z)))
                BinaryData_Convert = CStr(DecValue)
            Else
                BinaryData_Convert = splitbycondon(z)
            End If
        Else
            If InStr(LCase(keyword), "_dec") Then
                DecValue = Bin2Dec(StrReverse(splitbycondon(z)))
                splitbycondon(z) = CStr(DecValue)
                BinaryData_Convert = BinaryData_Convert & "," & splitbycondon(z)
            Else
                BinaryData_Convert = BinaryData_Convert & "," & splitbycondon(z)
            End If
        End If
    Next z
    
'ElseIf InStr(LCase(keyword), "signedgray") Then
ElseIf LCase(keyword) = "bintogray_sign" Then
    splitbycondon = Split(InputString, ",")
    For z = 0 To UBound(splitbycondon) Step 1
        m_binarr_temp = splitbycondon(z) ' m_binarr_temp = (0)00011010,(1)11001101...
        srcbit = Len(m_binarr_temp) - 1
        ReDim m_binarr(srcbit) As Long

        For k = 0 To srcbit Step 1
            m_binarr(srcbit - k) = mid(m_binarr_temp, k + 1, 1)
        Next k

        ReDim m_binarr_graycode(srcbit) As Long
        For k = 1 To UBound(m_binarr) Step 1
            If k = 1 Then
                m_binarr_graycode(0) = m_binarr(0)
                m_binarr_graycode(k) = m_binarr(k)
            Else
                If m_binarr(k - 1) = m_binarr(k) Then
                    m_binarr_graycode(k) = 0
                Else
                    m_binarr_graycode(k) = 1
                End If
            End If
        Next k

        For k = 0 To srcbit Step 1
            If k = 0 Then
                swpgray = m_binarr_graycode(k)
            Else
                swpgray = m_binarr_graycode(k) & swpgray
            End If
        Next k

        splitbycondon(z) = swpgray
        swpgray = ""
        If z = 0 Then
            If InStr(LCase(keyword), "_dec") Then
                DecSign = False
                If right(splitbycondon(z), 1) = 1 Then DecSign = True
                splitbycondon(z) = mid(splitbycondon(z), 1, Len(splitbycondon(z)) - 1)
                DecValue = Bin2Dec(StrReverse(splitbycondon(z)))
                If DecSign = True Then
                    DecValue = DecValue * -1
                    If DecValue = -0 Then
                        DecValue = 0
                        TheExec.Datalog.WriteComment ("*******WARNING! got the value -0 from the src data, change the value to 0 !*******")
                    End If
                End If
                BinaryData_Convert = CStr(DecValue)
            Else
                BinaryData_Convert = splitbycondon(z)
            End If
        Else
            If InStr(LCase(keyword), "_dec") Then
                DecSign = False
                If right(splitbycondon(z), 1) = 1 Then DecSign = True
                splitbycondon(z) = mid(splitbycondon(z), 1, Len(splitbycondon(z)) - 1)
                DecValue = Bin2Dec(StrReverse(splitbycondon(z)))
                If DecSign = True Then
                    DecValue = DecValue * -1
                    If DecValue = -0 Then
                        DecValue = 0
                        TheExec.Datalog.WriteComment ("*******WARNING! got the value -0 from the src data, change the value to 0 !*******")
                    End If
                End If
                splitbycondon(z) = CStr(DecValue)
                BinaryData_Convert = BinaryData_Convert & "," & splitbycondon(z)
            Else
                BinaryData_Convert = BinaryData_Convert & "," & splitbycondon(z)
            End If
        End If
    Next z
'ElseIf InStr(LCase(keyword), "dec") Then
ElseIf LCase(keyword) = "dec" Then
    splitbycondon = Split(InputString, ",")
    For z = 0 To UBound(splitbycondon) Step 1
        If z = 0 Then
            DecValue = Bin2Dec(StrReverse(splitbycondon(z)))
            BinaryData_Convert = CStr(DecValue)
        Else
            DecValue = Bin2Dec(StrReverse(splitbycondon(z)))
            splitbycondon(z) = CStr(DecValue)
            BinaryData_Convert = BinaryData_Convert & "," & splitbycondon(z)
        End If
    Next z
End If
        
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "BinaryData_Convert") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function TnameConv_SweepDigsrc(Optional digsrc_assignment As String = "", Optional lnterpose_PrePat As String = "", Optional DigSrc_FlowForLoopIntegerName As String = "") As String
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
        ' Update New TName format for SweepDigSrc -- 20221018
        Dim i As Long
        Dim j As Long
        Dim k As Long
        Dim l_temp_srccode As Long
        Dim l_srccode_index As Long
        
        Dim s_digsrc_Ary() As String
        Dim s_instancedata_Ary() As String
        Dim s_instancedata_sweep_Ary() As String
        Dim s_instancedata_right_Ary() As String
        Dim s_instancedata_split_Ary() As String
        Dim s_instancedata_split_col_Ary() As String
        Dim s_instancedata_split_dbl_underscore_Ary() As String
        Dim s_temp As String
        Dim s_temp_replace As String
        Dim s_temp_srccode As String
        
        Dim s_col As String: s_col = ":"
        Dim s_stri As String: s_stri = "|"
        Dim s_semicol As String: s_semicol = ";"
        Dim s_sig_underscore As String: s_sig_underscore = "_"
        Dim s_dbl_underscore As String: s_dbl_underscore = "__"
        
        '''SWEEP CODE(UD5) & SWEEP VOLTAGE(UD8)
        '''e.g., DigSrc_FlowForLoopIntegerName = SrcCodeIndx;pcie0__dcoclk_div:2:0:1;pcie1__dcoclk_div:2:0:1|SrcCodeIndx1;pcie0__dcov2i_range_gray:4:0:1:BinToGray;pcie1__dcov2i_range_gray:4:0:1:BinToGray
        '''e.g., lnterpose_PrePat = Sweep_Name:SrcCodeIndx
        '''e.g., digsrc_assignment = MTR_TSENSE_Th000__TFE_RPTAT=1111;MTR_TSENSE_Th000__ADC_GAIN_CAL_CTRL=0000;MTR_TSENSE_Th001__TFE_RPTAT=1111
        If DigSrc_FlowForLoopIntegerName <> "" Then
            s_instancedata_Ary = Split(DigSrc_FlowForLoopIntegerName, s_stri)
            ReDim s_digsrc_Ary(UBound(s_instancedata_Ary))
            For i = 0 To UBound(s_instancedata_Ary)
                '''e.g., DigSrc_FlowForLoopIntegerName = SrcCodeIndx;pcie0__dcoclk_div:2:0:1;pcie1__dcoclk_div:2:0:1
                '''                                      SrcCodeIndx1;pcie0__dcov2i_range_gray:4:0:1:BinToGray;pcie1__dcgov2i_range_gray:4:0:1:BinToGray
                s_instancedata_split_Ary = Split(s_instancedata_Ary(i), s_semicol)
                If i = 0 Then
                    l_srccode_index = 0
                Else
                    l_srccode_index = l_srccode_index + UBound(s_instancedata_split_Ary)
                End If
                For j = 0 To UBound(s_instancedata_split_Ary)
                    If s_instancedata_split_Ary(j) Like "srccodeindx*" Then
                        If gl_FlowForLoop_DigSrc_SweepCode_Dec <> "" Then
                            s_temp_srccode = Split(gl_FlowForLoop_DigSrc_SweepCode_Dec, "&")(l_srccode_index)
                            l_temp_srccode = CLng(s_temp_srccode)
                        Else
                            s_temp_srccode = s_instancedata_split_Ary(j)
                            l_temp_srccode = TheExec.Flow.var(s_temp_srccode).value
                        End If
                    Else
                        s_instancedata_split_col_Ary = Split(s_instancedata_split_Ary(j), s_col)
                        If InStr(s_instancedata_split_col_Ary(0), s_dbl_underscore) <> 0 Then
                        ''''e.g., pcie0__dcov2i_range_gray, pcie1__dcov2i_range_gray
                            s_instancedata_split_dbl_underscore_Ary = Split(s_instancedata_split_col_Ary(0), s_dbl_underscore)
                            s_temp_replace = s_instancedata_split_dbl_underscore_Ary(1) ''''Take left hand-side, dcov2i_range_gray
                        Else
                            s_temp_replace = s_instancedata_split_col_Ary(0)
                        End If
                        s_temp_replace = Replace(s_temp_replace, s_sig_underscore, "-")
''                        s_temp_replace = Replace(s_temp_replace, "=", ":")
                         s_temp_replace = s_temp_replace & ":" & l_temp_srccode
                        If s_temp = "" Then
                            s_temp = s_temp_replace
                        Else
                            If s_temp = s_temp_replace Then
                                s_temp = s_temp
                            Else
                                s_temp = s_temp & "&" & s_temp_replace
                            End If
                            
                        End If
                    End If
                Next j
                
                s_digsrc_Ary(i) = s_temp
                s_temp = ""
            Next i
            TnameConv_SweepDigsrc = Join(s_digsrc_Ary, "&")
            
        Else
            If digsrc_assignment <> "" Then
                If InStr(digsrc_assignment, ";") <> 0 Then
                    s_instancedata_Ary = Split(digsrc_assignment, ";")
                    s_instancedata_sweep_Ary = Split(glb_s_sweepsrc_DigSrcAssignment, ";")
                    ''e.g., PL2B_A_ABSMIN_REG1__sel_ron=00;PL2B_B_ABSMIN_REG1__sel_ron=sweep1
                    For i = 0 To UBound(s_instancedata_Ary)
                        '''e.g., PL2B_A_ABSMIN_REG1__sel_ron=00  --> PL2BAABSMINREG1selron:00
                        If s_instancedata_sweep_Ary(i) Like "*sweep*" Then
                            If InStr(s_instancedata_Ary(i), s_dbl_underscore) <> 0 Then
                                s_instancedata_split_dbl_underscore_Ary = Split(s_instancedata_Ary(i), s_dbl_underscore)
                                s_temp_replace = s_instancedata_split_dbl_underscore_Ary(1) ''''Take left hand-side, sel_ron
                            Else
                                s_temp_replace = s_instancedata_Ary(i)
                            End If
                            
                            'Conver To Deceimal for SweepCode  -- 20221018
                            If InStr(UCase(Instance_Data.CUS_Str_DigSrcData), "DECLOG") <> 0 Then
                                s_temp_replace = Split(s_temp_replace, "=")(0) & "=" & BinaryData_Convert(CStr(Split(s_temp_replace, "=")(1)), "DEC")
                            End If
                            
                            s_temp_replace = Replace(s_temp_replace, s_sig_underscore, "-")
                            s_temp_replace = Replace(s_temp_replace, "=", ":")
                            If s_temp = "" Then
                                s_temp = s_temp_replace
                            Else
                                If s_temp = s_temp_replace Then
                                    s_temp = s_temp
                                Else
                                    s_temp = s_temp & "&" & s_temp_replace
                                End If
                            End If
                        End If
                    Next i
                    TnameConv_SweepDigsrc = s_temp
                Else
                    If glb_s_sweepsrc_DigSrcAssignment Like "*sweep*" Then
                        If InStr(digsrc_assignment, s_dbl_underscore) <> 0 Then
                            s_instancedata_split_dbl_underscore_Ary = Split(digsrc_assignment, s_dbl_underscore)
                            s_temp_replace = s_instancedata_split_dbl_underscore_Ary(1) ''''Take left hand-side, sel_ron
                        Else
                            s_temp_replace = digsrc_assignment
                        End If
                       
                        'Conver To Deceimal for SweepCode  -- 20221018
                        If InStr(UCase(Instance_Data.CUS_Str_DigSrcData), "DECLOG") <> 0 Then
                            s_temp_replace = Split(s_temp_replace, "=")(0) & "=" & BinaryData_Convert(CStr(Split(s_temp_replace, "=")(1)), "DEC")
                        End If
                        
                        s_temp = Replace(s_temp_replace, s_sig_underscore, "-")
                        s_temp = Replace(s_temp, "=", ":")
                    End If
                    
                    TnameConv_SweepDigsrc = s_temp
                    
                End If
            End If
        End If
        
    Exit Function
                                                                                                                                                                                                                                                               
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "TnameConv_SweepDigsrc") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

Public Function TnameConv_SweepVoltage(Optional lnterpose_PrePat As String = "") As String
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    Dim i As Long
    Dim j As Long
    Dim s_instancedata_Ary() As String
    Dim s_instancedata_split_Ary() As String
    Dim s_temp As String
    Dim s_temp_replace As String
    Dim s_Sweep_List_Voltage As String
    Dim s_temp_Ary() As String
'''SWEEP VOLTAGE(UD8)
'Update New TName format for SweepVoltage -- 20221018
    Dim l_sweep_voltage_pin_cnt As Long
    l_sweep_voltage_pin_cnt = 0

    If TheExec.DevChar.Setups.IsRunning = True Then
        TnameConv_SweepVoltage = TnameConv_SweepVoltage_DevChar
    Else

        If lnterpose_PrePat <> "" Then
        '''e.g., VDD_PCPU:V:0.4+[SrcCodeIndx]*0.2;VDD_ECPU:V:0.4+[SrcCodeIndx]*0.2;Sweep_Name:SrcCodeIndx
        '''e.g., VDD_PCPU:V:0.4+[srccodeindexv]*0.2;VDD_ECPU:V:0.4+[srccodeindexv]*0.2;Sweep_Name:srccodeindexv
        '''e.g., VDD_PCPU:V:0.4,0.6,0.8:[srcodeindexv]
            If InStr(lnterpose_PrePat, ";") <> 0 Then
                s_instancedata_Ary = Split(lnterpose_PrePat, ";")
                For i = 0 To UBound(s_instancedata_Ary)
                    If (s_instancedata_Ary(i) Like "*:v:*srccodeindx*") Or (s_instancedata_Ary(i) Like "*:v:*srccodeindexv*") Or (lnterpose_PrePat Like "vdd*:v:*sweepvoltage*") Then  'NestSweep
                    '''e.g., VDD_PCPU:V:0.4+[SrcCodeIndx]*0.2
                        s_instancedata_split_Ary = Split(s_instancedata_Ary(i), ":")
                        For j = 0 To UBound(s_instancedata_split_Ary)
                            If s_instancedata_split_Ary(j) Like "*srccodeindx*" Then
                                s_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "[srccodeindx]", "(srccodeindx)")  ''gg20221103
                                s_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "[srccodeindx]", CStr(TheExec.Flow.var("SrcCodeIndx").value))  ''gg20221103
                                's_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "[srccodeindx]", CStr(TheExec.Flow.var(gl_Sweep_Name).value))
                                If s_instancedata_split_Ary(j) = "1" Then
                                    s_instancedata_split_Ary(j) = "(1)"
                                End If
                                s_instancedata_split_Ary(j) = CStr(FormatNumber(Evaluate(s_instancedata_split_Ary(j)), 3))
                            ElseIf s_instancedata_split_Ary(j) Like "*srccodeindexv*" Then
                                s_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "[srccodeindexv]", "(srccodeindexv)")  ''gg20221103
                                s_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "(srccodeindexv)", CStr(TheExec.Flow.var("SRCCODEINDEXV").value))  ''gg20221103
                                's_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "[srccodeindexv]", CStr(TheExec.Flow.var(gl_Sweep_Name).value))
                                If s_instancedata_split_Ary(j) = "1" Then
                                    s_instancedata_split_Ary(j) = "(1)"
                                End If
                                s_instancedata_split_Ary(j) = CStr(FormatNumber(Evaluate(s_instancedata_split_Ary(j)), 3))
                            ElseIf s_instancedata_split_Ary(j) Like "*sweepvoltage*" Then ' NestSweep
                                s_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "[sweepvoltage]", "(sweepvoltage)")
                                s_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "sweepvoltage", CStr(gl_sweepVoltage_Value))								
                                If s_instancedata_split_Ary(j) = "1" Then
                                    s_instancedata_split_Ary(j) = "(1)"
                                End If
                                s_instancedata_split_Ary(j) = CStr(FormatNumber(Evaluate(s_instancedata_split_Ary(j)), 3))
                            End If
                        Next j
                        '''e.g., VDD_PCPU:V:0.4  --> V0p4-VDDPCPU
    ''                        s_temp_replace = UCase(s_instancedata_split_Ary(1)) & Replace(s_instancedata_split_Ary(2), ".", "p") & "-" & UCase(Replace(s_instancedata_split_Ary(0), "_", ""))
                        If UBound(s_instancedata_split_Ary) >= 3 Then
                            If s_instancedata_split_Ary(3) <> "" Then
                                If InStr(s_instancedata_split_Ary(2), ",") <> 0 Then
                                    s_temp_Ary = Split(s_instancedata_split_Ary(2), ",")
                                    If s_instancedata_split_Ary(3) > UBound(s_temp_Ary) Then
                                    ''If the srccodeindx value is bigger than number of list voltage, use the first value to force.
                                        s_Sweep_List_Voltage = s_temp_Ary(0)
                                    Else
                                        s_Sweep_List_Voltage = s_temp_Ary(s_instancedata_split_Ary(3))
                                    End If
                                Else
                                    ''Only one force consition to set up, No Sweep List Voltage Scenario
                                    s_Sweep_List_Voltage = s_instancedata_split_Ary(2)
                                End If
                            Else
                                ''No Sweep List Voltage Scenario
                            End If
                            If l_sweep_voltage_pin_cnt > 0 Then
                                s_temp_replace = UCase(s_instancedata_split_Ary(1)) & Replace(s_Sweep_List_Voltage, ".", "p") & "-" & "Multi"
                            Else
                                s_temp_replace = UCase(s_instancedata_split_Ary(1)) & Replace(s_Sweep_List_Voltage, ".", "p") & "-" & UCase(Replace(s_instancedata_split_Ary(0), "_", ""))
                            End If
                        Else
                            If l_sweep_voltage_pin_cnt > 0 Then
                                's_temp_replace = UCase(s_instancedata_split_Ary(1)) & Replace(s_instancedata_split_Ary(2), ".", "p") & "-" & "Multi"
                                s_temp_replace = UCase(s_instancedata_split_Ary(1)) & Replace(s_instancedata_split_Ary(2), ".", "p") & "-" & UCase(Replace(s_instancedata_split_Ary(0), "_", "")) & "-Multi"
                                s_temp = s_temp_replace
                                Exit For ' only for print 1st multi sweep pin -- 20220831
                            Else
                                s_temp_replace = UCase(s_instancedata_split_Ary(1)) & Replace(s_instancedata_split_Ary(2), ".", "p") & "-" & UCase(Replace(s_instancedata_split_Ary(0), "_", ""))
                            End If
''                            s_temp_replace = UCase(s_instancedata_split_Ary(1)) & Replace(s_instancedata_split_Ary(2), ".", "p") & "-" & "Multi"
                        End If

                        s_temp = s_temp_replace
''                        If s_temp = "" Then
''                            s_temp = s_temp_replace
''                        Else
''                            s_temp = s_temp & "&" & s_temp_replace
''                        End If

                        l_sweep_voltage_pin_cnt = l_sweep_voltage_pin_cnt + 1
                    End If
''                    Exit For
                Next i
               TnameConv_SweepVoltage = s_temp

            Else
                If (lnterpose_PrePat Like "vdd*:v:*srccodeindx*") Or (lnterpose_PrePat Like "vdd*:v:*srccodeindexv*") Or (lnterpose_PrePat Like "vdd*:v:*sweepvoltage*") Then  'NestSweep
                    s_instancedata_split_Ary = Split(lnterpose_PrePat, ":")
                    For j = 0 To UBound(s_instancedata_split_Ary)
                        If s_instancedata_split_Ary(j) Like "*srccodeindx*" Then
                            s_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "[srccodeindx]", "(srccodeindx)")  ''gg20221103
                            s_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "srccodeindx", CStr(TheExec.Flow.var("SrcCodeIndx").value))  ''gg20221103
                            's_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "srccodeindx", CStr(TheExec.Flow.var(gl_Sweep_Name).value))
                            If s_instancedata_split_Ary(j) = "1" Then
                                s_instancedata_split_Ary(j) = "(1)"
                            End If
                            s_instancedata_split_Ary(j) = CStr(FormatNumber(Evaluate(s_instancedata_split_Ary(j)), 3)) '''CStr(Evaluate(s_instancedata_split_Ary(j)))
                        ElseIf s_instancedata_split_Ary(j) Like "*srccodeindexv*" Then
                            s_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "[srccodeindexv]", "(srccodeindexv)")  ''gg20221103
                            s_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "srccodeindexv", CStr(TheExec.Flow.var("SRCCODEINDEXV").value))  ''gg20221103
                            's_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "srccodeindexv", CStr(TheExec.Flow.var(gl_Sweep_Name).value))
                            If s_instancedata_split_Ary(j) = "1" Then
                                s_instancedata_split_Ary(j) = "(1)"
                            End If
                            s_instancedata_split_Ary(j) = CStr(FormatNumber(Evaluate(s_instancedata_split_Ary(j)), 3)) '''CStr(Evaluate(s_instancedata_split_Ary(j)))
'                            Dim l_var As Variant
'                            l_var = s_instancedata_split_Ary(j)
                        ElseIf s_instancedata_split_Ary(j) Like "*sweepvoltage*" Then '20240403 NestSweep
                            s_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "[sweepvoltage]", "(sweepvoltage)")
                            s_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "sweepvoltage", CStr(gl_sweepVoltage_Value))
                            's_instancedata_split_Ary(j) = Replace(s_instancedata_split_Ary(j), "srccodeindexv", CStr(TheExec.Flow.var(gl_Sweep_Name).value))
                            If s_instancedata_split_Ary(j) = "1" Then
                                s_instancedata_split_Ary(j) = "(1)"
                            End If
                            s_instancedata_split_Ary(j) = CStr(FormatNumber(Evaluate(s_instancedata_split_Ary(j)), 3)) '''CStr(Evaluate(s_instancedata_split_Ary(j)))
                        End If
                    Next j
                    If UBound(s_instancedata_split_Ary) >= 3 Then
                        If s_instancedata_split_Ary(3) <> "" Then
                            If InStr(s_instancedata_split_Ary(2), ",") <> 0 Then
                                s_temp_Ary = Split(s_instancedata_split_Ary(2), ",")
                                If s_instancedata_split_Ary(3) > UBound(s_temp_Ary) Then
                                ''If the srccodeindx value is bigger than number of list voltage, use the first value to force.
                                    s_Sweep_List_Voltage = s_temp_Ary(0)
                                Else
                                    s_Sweep_List_Voltage = s_temp_Ary(s_instancedata_split_Ary(3))
                                End If
                            Else
                                ''Only one force consition to set up, No Sweep List Voltage Scenario
                                s_Sweep_List_Voltage = s_instancedata_split_Ary(2)
                            End If
                        Else
                            ''No Sweep List Voltage Scenario
                        End If
                        s_temp = UCase(s_instancedata_split_Ary(1)) & Replace(s_Sweep_List_Voltage, ".", "p") & "-" & UCase(Replace(s_instancedata_split_Ary(0), "_", ""))

                    Else
                        s_temp = UCase(s_instancedata_split_Ary(1)) & Replace(s_instancedata_split_Ary(2), ".", "p") & "-" & UCase(Replace(s_instancedata_split_Ary(0), "_", ""))

                    End If
                    TnameConv_SweepVoltage = s_temp
                End If
            End If
        End If
    End If
    If TnameConv_SweepVoltage = "" Then: TnameConv_SweepVoltage = "x" ''gg20221103

 Exit Function

errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "TnameConv_SweepVoltage") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function

