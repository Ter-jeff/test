                        '    Vdiff = TheHdw.DCVS.Pins(split(CUS_Str_MainProgram)(1)).Voltage.Value - CDbl(MeasI.Setup_ByTypeByPin.PPMU(i).ForceValue1) ''vddio12_grp!!!
                        'Else
