                'TheExec.Datalog.WriteComment ("TempCnt_PinGroup = " & TempCnt_PinGroup & ", TempCnt_Pin = " & TempCnt_Pin & ", TempCnt = " & TempCnt)
                With TheHdw.PPMU.Pins(PinArray(TempCnt))
