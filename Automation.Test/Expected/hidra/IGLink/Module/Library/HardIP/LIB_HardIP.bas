                            measureCurrent.Pins(var) = measureCurrent.Pins(var).Multiply(R_Path_PLD.Pins(var)).Abs.Negate.Add(Vdiff).Invert.Multiply(Vdiff).Multiply(measureCurrent.Pins(var))
                        Next var
                    Next i
