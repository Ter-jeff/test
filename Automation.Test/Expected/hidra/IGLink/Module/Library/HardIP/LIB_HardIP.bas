                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range Program setting, " & MeasI.Setup_ByTypeByPin.PPMU(i).pin & " =" & MeasI.Setup_ByTypeByPin.PPMU(i).Meas_Range)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I WaitTime, " & MeasI.Setup_ByTypeByPin.PPMU(i).pin & " =" & MeasI.WaitTime.PPMU)
