                        .Current = CDbl(MeasV.Setup_ByTypeByPin.UVI80(i).ForceValue1)
                        .Connect tlDCVIConnectDefault
                    End If
                    .Gate = True
                    '.Meter.mode = tlDCVIMeterVoltage    'T-Est TTR approve by Si -- 230502
                End With
                                
                If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
                    TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Volt_meas Force Current value, " & MeasV.Setup_ByTypeByPin.UVI80(i).pin & " =" & MeasV.Setup_ByTypeByPin.UVI80(i).ForceValue1)
