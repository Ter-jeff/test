'''            '=========================================180410 added by Oscar
'''            TheExec.Datalog.WriteComment "Src Bits = " & DigSrc_Sample_Size
'''            TheExec.Datalog.WriteComment "SrcPin = " & DigSrc_pin.value
'''            TheExec.Datalog.WriteComment "Output String [ LSB(L) ==> MSB(R) ]:"
'''        End If
'''
