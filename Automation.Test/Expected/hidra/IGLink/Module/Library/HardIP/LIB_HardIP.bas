Public Function ProcessPLDCalculation_Complexity(ByVal CalcEquationPLD As String, ByRef RTN_PLD As PinListData, ByRef CalcEquation_PLD As CALC_EQUATION_PLD)  ', ByRef CalcEquationPLD As CALC_EQUATION_PLD
    'Post Calc function support Arithmetic for CalcV/CalcI/CalcF -- 20230628 Neil
On Error GoTo errHandler 'Add ErrHandler 2023/05/29
    Dim i As Long
    Dim bStringCheck As Boolean
    Dim tempStr_Equation As String
    Dim tempStr_CalcElementArr() As String
    Dim tempSiteStr_Equation As New SiteVariant

    Dim DicVal As New PinListData
    Dim finalResult As New PinListData
    Dim D_FinalResult As Double
    Dim pin_idx As Long
    Dim tempSiteStr_Equation_Ary() As New SiteVariant
    Dim tempPLD_Dict_Parsing As String              'Processing dictionary by format : Pinx(Dictionary)
    Dim PLD_Dict_Ary() As String
    Dim SplitByKey() As String
    Dim PLD_RTN_Name As String                      'Store Return PLD PinName
    Dim LeadPin_Flag As Boolean                     'True: Print 1st pin only / False : Print all pin name connect by "&"
    Dim Get_Data_Flag As Long: Get_Data_Flag = 0    '0: Pinx(PLD_Dict)[Default] /1:(PLD_Dict /2: PLD_Dict)
    Dim Str_CalcFormula As String                   'Use for Calculate formula
    Dim Str_DC_Spec_Name As String
    Dim PLD_PinCount_Flag As Boolean: PLD_PinCount_Flag = False
    Dim PLD_PinCount As Variant
    Dim Current_TestItem_Fail_Flag As String
    Dim round_flag As Boolean: round_flag = False
    Dim INT_Flag As Boolean: INT_Flag = False
    Dim site As Variant 'Carter, 20240304
    Dim Previous_PinCnt As Long
    Dim Current_PinCnt As Long
    LeadPin_Flag = True
    tempStr_Equation = UCase(CalcEquationPLD)
    tempStr_Equation = UCase(RegExReplaceString(tempStr_Equation, "[\+\-\*\/\^]", "@", False))
    If InStr(tempStr_Equation, "ROUND(") Then
        tempStr_Equation = Replace(tempStr_Equation, "ROUND(", "(")
        round_flag = True
    ElseIf InStr(tempStr_Equation, "INT(") Then
        tempStr_Equation = Replace(tempStr_Equation, "INT(", "(")
        INT_Flag = True
    Else
        round_flag = False
        INT_Flag = False
    End If
    
    PLD_Dict_Ary = Split(tempStr_Equation, "@")
    If UBound(PLD_Dict_Ary) > 1 Then
	    For i = 0 To UBound(PLD_Dict_Ary)
	        If IsNumeric(RegExReplaceString(PLD_Dict_Ary(i), "\(?\)?", "", False)) = False _
	            And InStr(UCase(PLD_Dict_Ary(i)), DC_Spec_Var) = 0 Then
            
	            tempPLD_Dict_Parsing = UCase(RegExReplaceString(PLD_Dict_Ary(i), "\)?", "", False))
	            SplitByKey = Split(tempPLD_Dict_Parsing, "(")
	            If UBound(SplitByKey) = 0 Then
	                If SplitByKey(0) <> "" Then
	                    DicVal = GetStoreDataAllType(SplitByKey(0))
	                    Get_Data_Flag = 2
	                Else
	                    Get_Data_Flag = 0
	                    'Do nothing
	                End If
	            Else
	                If SplitByKey(UBound(SplitByKey) - 1) <> "" And SplitByKey(UBound(SplitByKey)) <> "" Then
	                    DicVal = GetStoreDataAllType(SplitByKey(UBound(SplitByKey)))
	                    Get_Data_Flag = 0
	                        Current_PinCnt = 1
	                ElseIf SplitByKey(UBound(SplitByKey) - 1) = "" And SplitByKey(UBound(SplitByKey)) <> "" Then
	                    DicVal = GetStoreDataAllType(SplitByKey(UBound(SplitByKey)))
	                    Get_Data_Flag = 1   '1:(PLD_Dict
	                        Current_PinCnt = DicVal.Pins.Count
	                ElseIf SplitByKey(UBound(SplitByKey) - 1) <> "" Then
	                    DicVal = GetStoreDataAllType(SplitByKey(UBound(SplitByKey) - 1))
	                    Get_Data_Flag = 2   '2: PLD_Dict)
	                        Current_PinCnt = DicVal.Pins.Count
	                ElseIf SplitByKey(0) <> "" And SplitByKey(1) = "" Then
	                    DicVal = GetStoreDataAllType(SplitByKey(UBound(SplitByKey) - 1))
	                    Get_Data_Flag = 2
	                        Current_PinCnt = DicVal.Pins.Count
	                Else
	                    Get_Data_Flag = 0
	                    'Do nothing
	                End If
	            End If

	            If Get_Data_Flag = 0 Then
	                ReDim Preserve tempSiteStr_Equation_Ary(0)
	                For Each site In TheExec.sites
	                    If tempSiteStr_Equation_Ary(0) = "" Then
	                        tempSiteStr_Equation_Ary(0) = UCase(CalcEquationPLD)
	                    End If
                    
	                    If left(PLD_Dict_Ary(i), 1) = "(" Then
	                        PLD_Dict_Ary(i) = Replace(PLD_Dict_Ary(i), "(", vbNullString, 1, 1)
	                    End If
                                
	                    If UBound(Split(PLD_Dict_Ary(i), ")")) > 1 Then
	                        PLD_Dict_Ary(i) = mid(PLD_Dict_Ary(i), 1, Len(PLD_Dict_Ary(i)) - 1)
	                    End If
	                    tempSiteStr_Equation_Ary(0) = Replace(UCase(tempSiteStr_Equation_Ary(0)), UCase(PLD_Dict_Ary(i)), CStr(DicVal.Pins(SplitByKey(UBound(SplitByKey) - 1)).value))
	                Next site
                
	                '=== Use for specify pin calcuate === 20230928
	                If LeadPin_Flag = True Or PLD_RTN_Name = "" Then
	                    PLD_RTN_Name = SplitByKey(UBound(SplitByKey) - 1)
	                Else
	                    PLD_RTN_Name = PLD_RTN_Name & "&" & SplitByKey(UBound(SplitByKey) - 1)
	                End If
	            Else
	                ReDim Preserve tempSiteStr_Equation_Ary(DicVal.Pins.Count - 1)
	                For pin_idx = 0 To DicVal.Pins.Count - 1
	                    For Each site In TheExec.sites
	                        If tempSiteStr_Equation_Ary(pin_idx) = "" Then
	                            tempSiteStr_Equation_Ary(pin_idx) = UCase(CalcEquationPLD)
	                        End If

	                        If Get_Data_Flag = 1 Then
	                            'Parsing dictionary there is not specified pin name. Ex. (PLD_Dict)/2
	                            tempSiteStr_Equation_Ary(pin_idx) = Replace(UCase(tempSiteStr_Equation_Ary(pin_idx)), UCase(SplitByKey(UBound(SplitByKey))), CStr(DicVal.Pins.item(pin_idx).value)) 'nn_test_0613
	                        ElseIf Get_Data_Flag = 2 Then
	                            'Parsing dictionary there is not specified pin name. Ex. (PLD_Dict)/2
	                            tempSiteStr_Equation_Ary(pin_idx) = Replace(UCase(tempSiteStr_Equation_Ary(pin_idx)), UCase(SplitByKey(0)), CStr(DicVal.Pins.item(pin_idx).value)) 'nn_test_0613
	                        Else
	                            'Do nothing
	                        End If
	                    Next site
	                Next pin_idx
	            End If
	        End If
	        tempPLD_Dict_Parsing = vbNullString
	        If PLD_PinCount_Flag = True Then
	                If Previous_PinCnt <> Current_PinCnt Then
	                TheExec.Datalog.WriteComment "Error : The Pin Number of PinListData is not match, please check it out."
	                PLD_PinCount_Flag = False
	                Current_TestItem_Fail_Flag = Application.Worksheets(TheExec.Flow.Raw.SheetInRun).range("V" & CStr(TheExec.Flow.Raw.GetCurrentLineNumber + 5)).value
	                For Each site In TheExec.sites
	                    'Bin Out @Gating_Rule_Fail_VBT
	'                    TheExec.sites.item(site).SortNumber = 9972
	'                    TheExec.sites.item(site).BinNumber = 15
	                    TheExec.sites.item(site).FlagState(Current_TestItem_Fail_Flag) = logicTrue 'Trigger test item Fail Flag
	                Next site
	            End If
	        Else
	            '[20231107][All] Prevent Numeric to set flag
	                        '[20231115][All][Jim] To prevent abnormal judgement, add filter special keyword to do check.
	                        If IsNumeric(RegExReplaceString(PLD_Dict_Ary(i), "\(?\)?", "", False)) = False Then ''prevent Numeric to set flag
                    Previous_PinCnt = Current_PinCnt
	                PLD_PinCount_Flag = True
	            End If
	        End If
	    Next i
    
	    '=== Process DC Spec Value ===
	    For i = 0 To UBound(PLD_Dict_Ary)
	        If InStr(UCase(PLD_Dict_Ary(i)), DC_Spec_Var) <> 0 Then
	            Str_CalcFormula = EvaluateForDCSpec(RegExReplaceString(PLD_Dict_Ary(i), "\(?\)?", "", False))
	            Str_DC_Spec_Name = RegExReplaceString(PLD_Dict_Ary(i), "\(?\)?", "", False)
	            If DicVal.Pins.Count = 0 Then
	                ReDim Preserve tempSiteStr_Equation_Ary(0)
	                For Each site In TheExec.sites
	                    If tempSiteStr_Equation_Ary(0) = "" Then
	                        tempSiteStr_Equation_Ary(0) = UCase(CalcEquationPLD)
	                        tempSiteStr_Equation_Ary(0) = Replace(UCase(tempSiteStr_Equation_Ary(0)), UCase(Str_DC_Spec_Name), CStr(Str_CalcFormula))
	                    Else
	                        tempSiteStr_Equation_Ary(0) = Replace(UCase(tempSiteStr_Equation_Ary(0)), UCase(Str_DC_Spec_Name), CStr(Str_CalcFormula))
	                    End If
	                Next site
	            Else
	                ReDim Preserve tempSiteStr_Equation_Ary(DicVal.Pins.Count - 1)
	                For pin_idx = 0 To DicVal.Pins.Count - 1
	                    For Each site In TheExec.sites
	                        If tempSiteStr_Equation_Ary(pin_idx) = "" Then
	                            tempSiteStr_Equation_Ary(pin_idx) = UCase(CalcEquationPLD)
	                            tempSiteStr_Equation_Ary(pin_idx) = Replace(UCase(tempSiteStr_Equation_Ary(pin_idx)), UCase(Str_DC_Spec_Name), CStr(Str_CalcFormula))
	                        Else
	                            tempSiteStr_Equation_Ary(pin_idx) = Replace(UCase(tempSiteStr_Equation_Ary(pin_idx)), UCase(Str_DC_Spec_Name), CStr(Str_CalcFormula))
	                        End If
	                    Next site
	                Next pin_idx
	            End If
	        End If
	    Next i
    
	    LeadPin_Flag = True
	    Dim First_ActivateSite As Long
	    For Each site In TheExec.sites
	        First_ActivateSite = site
	        Exit For
	    Next site

	    For i = 0 To UBound(tempSiteStr_Equation_Ary) 'Loop (DicVal.Pins.Count - 1) times

	        bStringCheck = RegExCheckString(Str_CalcFormula, "\w+\s?[\/]\s?[0]|\([0]\+[0]\)", False)

	        If bStringCheck Then
	            TheExec.Datalog.WriteComment "The Equation: " & Str_CalcFormula & ", format is wrong. It cannot be divided the value zero."
	        Else
	            For Each site In TheExec.sites
	                Str_CalcFormula = CStr(tempSiteStr_Equation_Ary(i))
	'                bStringCheck = RegExCheckString(Str_CalcFormula, "\w+\s?[\/]\s?[0]|\([0]\+[0]\)", False)
            
	                If InStr(Str_CalcFormula, "/") Then
	                    Dim Str_CalcFormula_temp() As String
	                    Str_CalcFormula_temp = Split(Str_CalcFormula, "/")
	                    If Str_CalcFormula_temp(1) = "0" Then
	                       Str_CalcFormula_temp(1) = "0.0000000001"
	                       Call Print_Error_Message(Error_Info, "LIB_HardIP", "ProcessPLDCalculation_Complexity", "The Equation: " & Str_CalcFormula & ", please check the value for" & "/")
	                       Str_CalcFormula = Join(Str_CalcFormula_temp, "/")
	                    End If
	                End If
                
	                If round_flag = True Then
	                    Str_CalcFormula = Replace(Str_CalcFormula, "ROUND(", "(")
	                    D_FinalResult = Evaluate(Str_CalcFormula)
	                    D_FinalResult = Int(D_FinalResult + 0.5)
	                Else
	                    D_FinalResult = Evaluate(Str_CalcFormula)
	                End If

	                If DicVal.Pins.Count > 1 Then
	                    If LeadPin_Flag = False Then
	                        'Print all pin information
	                        If UCase(PLD_RTN_Name) <> "" Then
	                            If InStr(UCase(PLD_RTN_Name), UCase(DicVal.Pins.item(i))) = 0 Then
	                                'Exclude specify pin condition -- 20230928
	                                If Get_Data_Flag <> 0 Then PLD_RTN_Name = PLD_RTN_Name & "&" & UCase(DicVal.Pins.item(i))
	                            End If
	                        Else
	                            'Exclude specify pin condition -- 20230928
	                            If Get_Data_Flag <> 0 Then PLD_RTN_Name = UCase(DicVal.Pins.item(i))
	                        End If
	                    Else
	                        'Print 1st pin information
	                        'Exclude specify pin condition -- 20230928
	                        If Get_Data_Flag <> 0 Then PLD_RTN_Name = UCase(DicVal.Pins.item(i))
	                    End If
                    
	                    If site = First_ActivateSite Then RTN_PLD.AddPin (PLD_RTN_Name)
	                    RTN_PLD.Pins(PLD_RTN_Name).value = D_FinalResult
	                    Str_CalcFormula = vbNullString
	                ElseIf DicVal.Pins.Count = 1 Then
	                    PLD_RTN_Name = UCase(DicVal.Pins.item(0))
	                    If site = First_ActivateSite Then RTN_PLD.AddPin (PLD_RTN_Name)
	                    RTN_PLD.Pins(PLD_RTN_Name).value = D_FinalResult
	                    Str_CalcFormula = vbNullString
	                End If
	            Next site
	        End If
	    Next i
    Else
        Call ProcessStringForCalType(CalcEquationPLD, CalcEquation_PLD)
        Call StandardCalcuation(CalcEquation_PLD, RTN_PLD)
    End If


    Exit Function
errHandler:
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "ProcessPLDCalculation_Complexity")
    If AbortTest Then Exit Function Else Resume Next
End Function

'[20231107][All][Neil] New sweep DigSrc method : sweep multi variable register code in single loop
Public Function ProcessSweepString_SingleLoop(assignment As String, customerstring As String, ByRef sweepsrcarray() As String, ByRef loopmax As Long) As Long
    On Error GoTo errHandler:

    Dim i As Long
    Dim j As Long
    Dim k As Long
    
    Dim SplitByColon() As String  '":"
    Dim SplitByComma() As String  '","
    Dim SplitByEqual() As String  '"="
    Dim SplitBySemicolon() As String '";"
    
    loopmax = 1 ' Initial loop max count (Default=1)
    
    SplitByColon = Split(customerstring, ":")
    SplitBySemicolon = Split(SplitByColon(1), ";")
    
    For i = 0 To UBound(SplitBySemicolon)
        '=== Check Index size ======
        'Sweepsrc_1D src code size must be the same
                SplitByEqual = Split(SplitBySemicolon(UBound(SplitBySemicolon) - i), "=")
        SplitByComma = Split(SplitByEqual(1), ",")
        '=== Initial SrcAry Size =====
        If i = 0 Then
            '== Record SrcCode Index size at 1st run ==
            ReDim sweepsrcarray(UBound(SplitByComma))  'Re-allocate arrray size
            '== Setup and Replace sweep name to src code index data
            For j = 0 To UBound(sweepsrcarray)
                sweepsrcarray(j) = Replace(assignment, SplitByEqual(0), SplitByComma(j))
            Next j
            loopmax = UBound(sweepsrcarray) + 1
        Else
            If UBound(SplitByComma) <> UBound(sweepsrcarray) Then
                TheExec.Datalog.WriteComment "Error: (sweepsrc1D): Please make sure all of source code index is alignment!!"
                loopmax = 1
                Exit Function
            Else
                '== Setup and Replace sweep name to src code index data
                For j = 0 To UBound(sweepsrcarray)
                    sweepsrcarray(j) = Replace(sweepsrcarray(j), SplitByEqual(0), SplitByComma(j))
                Next j
                loopmax = UBound(sweepsrcarray) + 1
            End If
        End If
    Next i
    Exit Function
errHandler:
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "ProcessSweepString_SingleLoop")
    If AbortTest Then Exit Function Else Resume Next
End Function

'[20231107][All][Neil] Duty Cycle Test Methodology on Digital and DCVI instrument
Public Function HardIP_MeasureDuty()
    'Use for measure Duty cycle on IO/DCVI instrument
        On Error GoTo errHandler:
        
    Dim MeasDuty As MeasF_Type
    Dim Rtn_MeasureResult As New PinListData
    Dim pin As New PinList
    Dim vsite As Variant
    Dim Temp_val As Double
    ' Initialize time measurement data capture.
    Dim Init_Pins_PLD As New PinListData
    Dim ReadBack_DutyResult As New PinListData
    Dim TestNameInput As String
    Dim p As Long
    'Use for Measure DutyCycle by DCTime(DCVI)
    Dim pld1 As New PinListData
    Dim pld2 As New PinListData
    Dim DSPWF_DATALIST As New DSPWave
    Dim p_ary() As String, p_cnt As Long, i As Long
    
    Dim DSPWF_CapRawData As New DSPWave
    Dim SL_SamplePoint As New SiteLong
    Dim DSPWF_DutyCycleResult As New DSPWave                'Calculate and Store DutyCycle via fetch one cycle data of CAP memory
    Dim DSPWF_FrequencyResult As New DSPWave                'Calculate and Store Frequency via fetch one cycle data of CAP memory
    DSPWF_DutyCycleResult.CreateConstant 0, 1, DspDouble
    DSPWF_FrequencyResult.CreateConstant 0, 1, DspDouble
    Dim Fetch_FirstCycleRawData_Flag As Boolean
    Fetch_FirstCycleRawData_Flag = False                    'True : Fetch first cycle data from CAP memory,  False : Fetch the last cycle data from CAP memory
    
    'CapMem Sample rate :781.25Hz - 1MHz
    Dim Cap_SR As Double                                    '1MHz  [ Note : SampleRate must to over 8/3 times of Output_Freq ]
    Dim Cap_SS As Double                                    'Sample Size = 1024p
    Dim Cap_Vth As Double
    Dim DutyCycle_Input_Str() As String                     'Parsing Duty cycle setup input parameter
    If InStr(UCase(Instance_Data.CUS_Str_MainProgram), "DUTYCYCLE:") <> 0 Then
        DutyCycle_Input_Str = Split(Instance_Data.CUS_Str_MainProgram, ":")
        If UBound(DutyCycle_Input_Str) = 3 Then
            Cap_Vth = CDbl(DutyCycle_Input_Str(1))
            Cap_SR = CDbl(DutyCycle_Input_Str(2))
            Cap_SS = CDbl(DutyCycle_Input_Str(3))
        Else
            Cap_Vth = 0.5
            Cap_SR = 1000000#        '1MHz  [ Note : SampleRate must to over 8/3 times of Output_Freq ]
            Cap_SS = 511             'Sample Size = 511 [ DCTime:1-511/CAPMEM:512K]
        End If
    Else
        Cap_Vth = 0.5
        Cap_SR = 1000000#             '1MHz  [ Note : SampleRate must to over 8/3 times of Output_Freq ]
        Cap_SS = 511                  'Sample Size = 511 [ DCTime:1-511/CAPMEM:512K]
    End If
    
    MeasDuty = TestConditionSeqData(Instance_Data.TestSeqNum).MeasDuty(Instance_Data.TestSeqSweepNum)
    Rtn_MeasureResult.AddPin (MeasDuty.Pins)
        
    If GetInstrument(CStr(Split(MeasDuty.Pins, ",")(0)), 0) = "HSD-U" Or GetInstrument(CStr(Split(MeasDuty.Pins, ",")(0)), 0) = "HSDP" Then
        If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
            TheExec.Datalog.WriteComment (glb_TestInstance & " =====> DutyCycle Pin setting = " & MeasDuty.Pins)
        End If
        
        pin.value = MeasDuty.Pins
        
        With TheHdw.Digital.Jitter
            .TimeoutEnable = True
            .TimeOut = 5.5
            Init_Pins_PLD = .SingleDSPWaves
            .start  ' Start the walking strobe capture measurement.
            .Wait   ' Wait for the jitter capture to complete
        End With
    
        If TheExec.TesterMode = testModeOnline Then
            Call rundsp.DSP_Measure_Jitter(Init_Pins_PLD, ReadBack_DutyResult)
            Rtn_MeasureResult = ReadBack_DutyResult.Pins.item(pin)
        Else
            Temp_val = Round(Rnd, 6)
            For Each vsite In TheExec.sites
                Rtn_MeasureResult.Pins(pin).value(vsite) = Temp_val
            Next vsite
        End If
    ElseIf GetInstrument(CStr(Split(MeasDuty.Pins, ",")(0)), 0) = "DC-07" Then
        'Support use UVI80 measure duty cycle[DCTime and Capture memory]
        If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
            TheExec.Datalog.WriteComment (glb_TestInstance & " =====> DutyCycle Pin setting = " & MeasDuty.Pins)
        End If
        
        If InStr(UCase(MeasDuty.Pins), "_DT") <> 0 Then
            'Do While TheHdw.DCVI.Pins(Split(MeasDuty.Pins, "_DT")(0)).Capture.IsCaptureDone = False         ' Wait if another capture is running
            'Loop
            
            'Filter "_DT" for DCVI mode control
            TheHdw.DCVI.Pins(Split(MeasDuty.Pins, "_DT")(0)).Disconnect     'Disconnect DCVI channel
  
            '===== Mease Duty by DCTime(UVI80) =====
            For Each vsite In TheExec.sites
                With TheHdw.DCTime.Pins(MeasDuty.Pins)
                    .Connect
                    .mode = tlDCTimeModeStamper
                    .Interleave = tlDCTimeInterleaveOn
                    .Measurement.dutycycle.start.SetInput tlDCTimeStartInputOnTrigger
                End With
    
                With TheHdw.DCTime.Pins(MeasDuty.Pins).Measurement.dutycycle
                    .SetVoltageRange 7, tlDCTimeImpedanceHiZ
                    .Threshold = Cap_Vth
                    .sampleSize = Cap_SS
                    .Slope = tlSlopePositive
                    .Hysteresis = tlDCTimeHysteresisOn
                End With
    
                ' Trigger the DCTime
                TheHdw.DCTime.Pins(MeasDuty.Pins).TimeStamps.Trigger ("my_capture")
                ' Retrieve Stamps/Samples
                TheHdw.DCTime.Pins(MeasDuty.Pins).TimeStamps("my_capture").GetWaves pld1, pld2
                ' Calc Duty cycle
                Rtn_MeasureResult = TheHdw.DCTime.Pins(MeasDuty.Pins).Measurement.dutycycle.CalculatedResults(pld1, pld2)
                For p = 0 To Rtn_MeasureResult.Pins.Count - 1
                    DSPWF_DATALIST = Rtn_MeasureResult.Pins(p)
                    Rtn_MeasureResult.Pins(p).value = DSPWF_DATALIST.CalcMean
                Next p
                TheHdw.DCTime.Pins(MeasDuty.Pins).Disconnect
            Next vsite
        Else

            Do While TheHdw.DCVI.Pins(MeasDuty.Pins).Capture.IsCaptureDone = False         ' Wait if another capture is running
            Loop
            '===== Mease Duty by DCVI =====
            With TheHdw.DCVI.Pins(MeasDuty.Pins)
                .Gate = False
                .mode = tlDCVIModeHighImpedance
                .Voltage = pc_Def_VFI_UVI80_VoltCalmp
                'BleederResistor = tlDCVIBleederResistorOff
                .Current = 0
                .Connect tlDCVIConnectHighSense
                .Gate = True
            End With
        
            TheHdw.DCVI.Pins(MeasDuty.Pins).Capture.Signals.Add "Capture_signal"                ' Create a SIGNAL to set up instrument
            With TheHdw.DCVI.Pins(MeasDuty.Pins).Capture.Signals.item("Capture_signal")         ' Define the signal used for the capture
                .mode = tlDCVIMeterVoltage
                .range = pc_Def_VFI_UVI80_VoltageRange
                .SampleRate = Cap_SR                        'CapMem Sample rate :781.25Hz - 1MHz (8/3 rate)
                .sampleSize = Cap_SS                        'SampleSize : 512K
                .LoadSettings                               'Setup the hardware by loading the signal
                .Trigger
            End With
            Do While TheHdw.DCVI.Pins(MeasDuty.Pins).Capture.IsCaptureDone = False         ' Wait if another capture is running
            Loop
            ' Get the captured samples from the instrument
            If TheExec.TesterMode = testModeOffline Then
                Dim Simulate_Voltage As Double: Simulate_Voltage = 1#                 ' 1V
                Dim Simulate_Vth As Double: Simulate_Vth = Cap_Vth                    ' For Square_Wave
                Dim Simulate_Output_Freq As Double: Simulate_Output_Freq = 10000#     ' 10KHz
                Dim SineWaveform_Flag As Boolean: SineWaveform_Flag = True            ' True: SineWave, False : SquareWave
                Dim Simulate_WaveData() As Double
                ReDim Simulate_WaveData(Cap_SS - 1) As Double
                Dim Simulate_Data_Idx As Long
                
                If SineWaveform_Flag = True Then
                    '====== Sine Wave =======
                    For Simulate_Data_Idx = 0 To UBound(Simulate_WaveData)
                        Simulate_WaveData(Simulate_Data_Idx) = Simulate_Voltage * Sin(2 * pi * Simulate_Output_Freq / Cap_SR * Simulate_Data_Idx)
                    Next
                Else
                    '====== Square  Wave =======
                    For Simulate_Data_Idx = 0 To UBound(Simulate_WaveData)
                        If (Simulate_Voltage * Sin(2 * pi * Simulate_Output_Freq / Cap_SR * Simulate_Data_Idx)) >= Simulate_Vth Then
                            Simulate_WaveData(Simulate_Data_Idx) = Simulate_Voltage     'VOH
                        Else
                            Simulate_WaveData(Simulate_Data_Idx) = -Simulate_Voltage    'VOL
                        End If
                    Next
                End If
                'Generate Simulate Capture waveform
                DSPWF_CapRawData.SampleRate = Cap_SR
                DSPWF_CapRawData.data = Simulate_WaveData
            Else
                DSPWF_CapRawData = TheHdw.DCVI.Pins(MeasDuty.Pins).Capture.Signals.item("Capture_signal").DSPWave
            End If
        
            ' Calculate Frequency/DutyCycle via DSP
            Call rundsp.DSP_CALC_FREQ_DUTY_FROM_SPECTRUM(DSPWF_CapRawData, Cap_SR, Cap_SS, Fetch_FirstCycleRawData_Flag, 3, DSPWF_FrequencyResult, DSPWF_DutyCycleResult)
            
            'Return DutyCycle result
            For Each vsite In TheExec.sites
                Rtn_MeasureResult.Pins(MeasDuty.Pins).value(vsite) = DSPWF_DutyCycleResult
            Next vsite
            
            'After measurment
            TheHdw.DCVI.Pins(MeasDuty.Pins).Gate = False
            TheHdw.DCVI.Pins(MeasDuty.Pins).Disconnect
        End If
    Else
        Call Print_Error_Message(Warning_Info, "LIB_HardIP", "Pin=[" & MeasDuty.Pins & "], Instrument type did not support Measure Duty!!")
        Exit Function
    End If

    '-- Print out datalog --
    For p = 0 To Rtn_MeasureResult.Pins.Count - 1
        If EnableDigitalTestLimitTTR = True Then
            TestNameInput = Report_TName_From_Instance("D", "X", , CInt(Instance_Data.TestSeqNum), p)
        Else
            TestNameInput = Report_TName_From_Instance("D", Rtn_MeasureResult.Pins(p), , CInt(Instance_Data.TestSeqNum), p)
        End If
        TheExec.Flow.TestLimit resultVal:=Rtn_MeasureResult.Pins(p), scaletype:=scalePercent, Tname:=TestNameInput, ForceResults:=tlForceFlow
    Next p
                
Exit Function
errHandler:
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_MeasureDuty")
    If AbortTest Then Exit Function Else Resume Next
End Function

Private Function ProcessAssignment_Fuse(RegAssignArr() As Variant, StartCol As Long, MaxRow As Long, maxcol As Long, ConnectValStr As String, ConnectRegStr As String, TypeName As String, Optional SkipCheckCol As Boolean = False)
' Edited by Dylan 2019/12/04
On Error GoTo errHandler:
'Reg_Assignment: A=1000;B=0010;C=1111 ("=" is connectValStr, ";" is connectRegStr)
'Reg_Equation: A+B+C+A ("" is connectValStr,"+" is connectRegStr)
'Cus_DigCap: DSSC_out;4:A;4:B ("" is connectValStr,";" is connectRegStr)
'Cus_DigSrc:

If StartCol = maxcol Then Exit Function 'No Data inside

Dim i As Long
Dim j As Long
Dim k As Long

Dim TestNumber As Long
Dim RegisterNumber As Long

Dim Valid_ColNumber As Long
Dim tempStrArr() As String
Dim ArgumentArr() As String
Dim M_catnameStr As String
Dim DictArr As String
Dim TempCol As Long

Dim BlankRegAssignInfo As RegAssignInfo
RegAssignInfo = BlankRegAssignInfo

RegAssignInfo.TypeName = TypeName

    For i = 2 To MaxRow
    
        If (RegAssignArr(i, StartCol + 1) = "") Then Exit For
        
            Valid_ColNumber = 0
            For k = StartCol + 1 To maxcol
            
                If i = 2 Then
                    
                    ReDim Preserve tempStrArr(Valid_ColNumber) As String
                    tempStrArr(Valid_ColNumber) = vbNullString
                    TempCol = k
                    tempStrArr(Valid_ColNumber) = RegAssignArr(i, TempCol)
                    tempStrArr(Valid_ColNumber) = Replace(tempStrArr(Valid_ColNumber), """", vbNullString) ' For Execl Bug 20200227
                    Valid_ColNumber = Valid_ColNumber + 1
                    ArgumentArr = tempStrArr
                    
                ElseIf RegAssignArr(i, k) <> "" Or (TypeName = "calc_eqn" And RegAssignArr(2, k) <> "") Then
                
                    ReDim Preserve tempStrArr(Valid_ColNumber) As String
                    tempStrArr(Valid_ColNumber) = vbNullString
                    TempCol = k
                    If SkipCheckCol = True Then TempCol = k + 1
                    
                    If RegAssignArr(i, TempCol) <> "" Then
                        tempStrArr(Valid_ColNumber) = RegAssignArr(i, TempCol)
                        tempStrArr(Valid_ColNumber) = Replace(tempStrArr(Valid_ColNumber), """", vbNullString) ' For Execl Bug 20200227
             
                        
                    End If
                    Valid_ColNumber = Valid_ColNumber + 1
                    
                Else
                    Exit For
                End If
                

            Next k
            
            If i <> 2 Then
            If RegAssignArr(i, StartCol) <> "" Then
                RegisterNumber = 0
                ReDim Preserve RegAssignInfo.ByTest(TestNumber) As ByTest
                ReDim Preserve RegAssignInfo.ByTest(TestNumber).RegAssign(RegisterNumber) As RegAssign
                
                RegAssignInfo.ByTest(TestNumber).TestName = RegAssignArr(i, StartCol)
                
                ReDim Preserve RegAssignInfo.ByTest(TestNumber).RtnByMode(0) As String
                ReDim Preserve RegAssignInfo.ByTest(TestNumber).RtnByMode(1) As String
                RegAssignInfo.ByTest(TestNumber).RtnByMode(0) = tempStrArr(0)
                RegAssignInfo.ByTest(TestNumber).RtnByMode(1) = tempStrArr(1)
                TestNumber = TestNumber + 1
                RegisterNumber = RegisterNumber + 1
            Else
                ReDim Preserve RegAssignInfo.ByTest(TestNumber - 1).RegAssign(RegisterNumber) As RegAssign
                RegAssignInfo.ByTest(TestNumber - 1).RegAssign(RegisterNumber).RegName = RegAssignArr(i, StartCol + 1)
        
                RegAssignInfo.ByTest(TestNumber - 1).RtnByMode(0) = RegAssignInfo.ByTest(TestNumber - 1).RtnByMode(0) & ConnectRegStr & tempStrArr(0)
                RegAssignInfo.ByTest(TestNumber - 1).RtnByMode(1) = RegAssignInfo.ByTest(TestNumber - 1).RtnByMode(1) & ConnectRegStr & tempStrArr(1)

                RegisterNumber = RegisterNumber + 1
            End If
            End If
    Next i
    
    Call StoredRegAssign_Fuse(ArgumentArr)
        
Exit Function
errHandler:
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "ProcessAssignment_Fuse")
    If AbortTest Then Exit Function Else Resume Next
End Function

Public Function StoredRegAssign_Fuse(ArgumentArr() As String)   ' Edited by Brian 2024/01/17

On Error GoTo errHandler:
Dim i As Long
Dim j As Long

For i = 0 To UBound(RegAssignInfo.ByTest(i).RtnByMode)


        If RegDict.Exists(LCase(ArgumentArr(i) & "_" & RegAssignInfo.ByTest(0).TestName)) Then
            TheExec.ErrorLogMessage "Duplicate Assign on" & RegAssignInfo.ByTest(0).TestName
        Else
            RegDict.Add LCase(ArgumentArr(i) & "_" & RegAssignInfo.ByTest(0).TestName), RegAssignInfo.ByTest(0).RtnByMode(i)
        End If

Next i

Exit Function
errHandler:
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "StoredRegAssign_Fuse")
    If AbortTest Then Exit Function Else Resume Next
End Function

