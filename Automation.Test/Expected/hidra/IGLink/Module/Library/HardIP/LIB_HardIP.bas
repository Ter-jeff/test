            TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range Program setting, " & MeasI.Pins.UVS256HP & " =" & MeasI.Setup_ByType.UVS256HP.Meas_Range)
            TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I WaitTime, " & MeasI.Pins.UVS256HP & " =" & MeasI.WaitTime.UVS256HP)
        End If
    Else
        Dim pin() As String
        Dim PinCnt As Long
        Dim temp_Current_Range As New Dictionary
        For i = 0 To UBound(MeasI.Setup_ByTypeByPin.UVS256HP)
            TheExec.DataManager.DecomposePinList MeasI.Setup_ByTypeByPin.UVS256HP(i).pin, pin(), PinCnt
            If PinCnt = 1 Then
                If temp_Current_Range.Exists(pin(0)) Then
                    temp_Current_Range.item(pin(0)) = temp_Current_Range.item(pin(0)) + CDbl(MeasI.Setup_ByTypeByPin.UVS256HP(i).Meas_Range)
                Else
                    temp_Current_Range.Add pin(0), MeasI.Setup_ByTypeByPin.UVS256HP(i).Meas_Range
                    temp_Current_Range.item(pin(0)) = CDbl(MeasI.Setup_ByTypeByPin.UVS256HP(i).Meas_Range)
                End If
            End If
        Next i
        For i = 0 To UBound(MeasI.Setup_ByTypeByPin.UVS256HP)
            TheExec.DataManager.DecomposePinList MeasI.Setup_ByTypeByPin.UVS256HP(i).pin, pin(), PinCnt
            If PinCnt = 1 Then
                If temp_Current_Range.Exists(pin(0)) Then
                    MeasI.Setup_ByTypeByPin.UVS256HP(i).Meas_Range = temp_Current_Range.item(pin(0))
                End If
            End If
        Next i
        For i = 0 To UBound(MeasI.Setup_ByTypeByPin.UVS256HP)
            With TheHdw.DCVS.Pins(MeasI.Setup_ByTypeByPin.UVS256HP(i).pin)
                
                If .Gate = False Then
                    .Disconnect tlDCVSConnectDefault
                    '.Meter.mode = tlDCVSMeterCurrent   'T-Est TTR approve by Si -- 230502
                    .mode = tlDCVSModeVoltage
                    .SetCurrentRanges pc_Def_UVS256HP_Init_MeasCurrRange, pc_Def_UVS256HP_Init_MeasCurrRange
					If TheExec.Flow.enableWord("HardIP_Autorange") = True And InStr(UCase(Instance_Data.CUS_Str_DigSrcData), "BYP_CURR_AUTORANGE") = 0 Then
					Else					
						If MeasI.Setup_ByType.UVS256HP.Meas_Range <> "0" Then .SetCurrentRanges CDbl(MeasI.Setup_ByTypeByPin.UVS256HP(i).Meas_Range), CDbl(MeasI.Setup_ByTypeByPin.UVS256HP(i).Meas_Range)
					End If
                    .Voltage.value = 0#
                    .Connect tlDCVSConnectDefault
                    .Gate = True
                    .Voltage.value = MeasI.Setup_ByTypeByPin.UVS256HP(i).ForceValue1
                    If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
                        TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Force Voltage, " & MeasI.Setup_ByTypeByPin.UVS256HP(i).pin & " =" & Format(TheHdw.DCVS.Pins(SplitInputCondition(MeasI.Setup_ByTypeByPin.UVS256HP(i).pin, ",", 0)).Voltage.value, "0.000"))
                    End If
                Else
					If TheExec.Flow.enableWord("HardIP_Autorange") = True And InStr(UCase(Instance_Data.CUS_Str_DigSrcData), "BYP_CURR_AUTORANGE") = 0 Then
					Else
						'.Meter.mode = tlDCVSMeterCurrent   'T-Est TTR approve by Si -- 230502
						If MeasI.Setup_ByTypeByPin.UVS256HP(i).Meas_Range <> "0" Then .SetCurrentRanges CDbl(MeasI.Setup_ByTypeByPin.UVS256HP(i).Meas_Range), CDbl(MeasI.Setup_ByTypeByPin.UVS256HP(i).Meas_Range)
                    End If
                End If

            End With
            If glb_Disable_CurrRangeSetting_Print = False And gl_Disable_HIP_debug_log = False Then
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range setting, " & MeasI.Setup_ByTypeByPin.UVS256HP(i).pin & " =" & TheHdw.DCVS.Pins(MeasI.Setup_ByTypeByPin.UVS256HP(i).pin).Meter.CurrentRange.value)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I range Program setting, " & MeasI.Setup_ByTypeByPin.UVS256HP(i).pin & " =" & MeasI.Setup_ByTypeByPin.UVS256HP(i).Meas_Range)
                TheExec.Datalog.WriteComment (glb_TestInstance & " =====> Curr_meas Meter I WaitTime, " & MeasI.Setup_ByTypeByPin.UVS256HP(i).pin & " =" & MeasI.WaitTime.UVS256HP)
            End If
        Next i
    End If
    TheHdw.DCVS.Pins(MeasI.Pins.UVS256HP).Meter.mode = tlDCVSMeterCurrent   'T-Est TTR approve by Si -- 230502    			move before auto range 20240531
    ' HardIP BySite Autorange
    If TheExec.Flow.enableWord("HardIP_Autorange") = True And InStr(UCase(Instance_Data.CUS_Str_DigSrcData), "BYP_CURR_AUTORANGE") = 0 Then 'Align auto range enable word with all of DCVS -- 20221219
        TheExec.Datalog.WriteComment "========UVS256HP Autorange Start========"
        Call DCVS_MeasureCurrent_AutoRange(MeasI.Pins.UVS256HP, True, MeasI.Pins.UVS256HP, 10, MeasI.Pins.UVS256HP)             'Update search sample size from 2 to 10 -- 20221219
        TheExec.Datalog.WriteComment "========UVS256HP Autorange Done========"
'        Dim uvs256_waittime As Double: uvs256_waittime = CDbl(MeasI.WaitTime.UVS256)
'        ReDim StoreSourceFoldLimit(UBound(MeasI.SaveCondition)) As Double
'        For i = 0 To UBound(MeasI.SaveCondition)
'            StoreSourceFoldLimit(i) = CDbl(MeasI.SaveCondition(i).SourceFlodLimit)
'        Next
'        Call HardIP_UVS256_autorange(MeasI.Pins.UVS256, StoreSourceFoldLimit, uvs256_waittime)
'        MeasI.WaitTime.UVS256 = CStr(uvs256_waittime)
    End If
    TheHdw.Wait CDbl(MeasI.WaitTime.UVS256HP)
    'measureCurrent = TheHdw.DCVS.Pins(MeasI.Pins.UVS256HP).Meter.Read(tlStrobe, pc_Def_UVS256HP_ReadPoint)
    
    If TheExec.Flow.enableWord("CurrentProfile") = False And TheExec.Flow.enableWord("VoltageProfile") = False And Profile_byflow = False Then
        measureCurrent = TheHdw.DCVS.Pins(MeasI.Pins.UVS256HP).Meter.Read(tlStrobe, pc_Def_UVS256HP_ReadPoint)
    Else
        Dim p As Variant
        Dim Pin_Cnt As Long
        Dim Pins() As String
        Dim Dummy_Value As New SiteDouble: Dummy_Value = 0.0001
        For Each p In Split(MeasI.Pins.UVS256HP, ",")
            TheExec.DataManager.DecomposePinList p, Pins, Pin_Cnt
            For i = 0 To Pin_Cnt - 1
                measureCurrent.AddPin Pins(i)
                measureCurrent.Pins(Pins(i)) = Dummy_Value
            Next i
        Next p
    End If
    
    '''--------->Save the interpose PrePat and interpose PreMeas force condition---------
    Dim num_pins As Long
    Dim instr_pins() As String
    Dim DCVS_HW_Value As String
    Call TheExec.DataManager.DecomposePinList(MeasI.Pins.UVS256HP, instr_pins(), num_pins)
    For i = 0 To num_pins - 1
    If TheExec.DataManager.ChannelType(instr_pins(i)) <> "N/C" Then
        DCVS_HW_Value = CStr(FormatNumber(TheHdw.DCVS.Pins(instr_pins(i)).Voltage.value, 3))
        If MeasI.ForceValueDic_HWCom.Exists(UCase(instr_pins(i))) Then
            MeasI.ForceValueDic_HWCom(UCase(instr_pins(i))) = DCVS_HW_Value
        Else
            MeasI.ForceValueDic_HWCom.Add UCase(instr_pins(i)), DCVS_HW_Value
        End If
    End If
    Next i
    '''--------->Save the interpose PrePat and interpose PreMeas force condition---------
    
    If gl_Disable_HIP_debug_log = False Then Call ForceVal_Compare(MeasI, MeasI.Pins.UVS256HP, "I", "DCVS") ''Carter, 20190624
    
    Call HardIP_DCVS_MI_StoreAndRestoreCondition(MeasI, UVS256HP, False)
Exit Function 'Add ErrHandler 2023/05/29
errHandler: 'Add ErrHandler 2023/05/29
    Call Print_Error_Message(Error_Info, "LIB_HardIP", "HardIP_SetupAndMeasureCurrent_UVS256HP") 'Add ErrHandler 2023/05/29
    If AbortTest Then Exit Function Else Resume Next 'Add ErrHandler 2023/05/29
End Function
