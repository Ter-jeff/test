<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="DiffPairConfig"
    targetNamespace="http://tempuri.org/DiffPairConfig.xsd"
    elementFormDefault="qualified"
    xmlns="http://tempuri.org/DiffPairConfig.xsd"
    xmlns:mstns="http://tempuri.org/DiffPairConfig.xsd"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
>

  <xs:element name="DiffItem">
    <xs:complexType>
      <xs:attribute name ="Pos" type="xs:string"/>
      <xs:attribute name="Neg" type="xs:string"/>
    </xs:complexType>
  </xs:element>
    
  <xs:element name ="DiffPairRules">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref ="DiffItem" maxOccurs="unbounded">
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name ="DiffPairPins">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="DiffItem" maxOccurs="unbounded">
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
  
  <xs:element name ="DiffPairConfig">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref ="DiffPairRules"/>
        <xs:element ref ="DiffPairPins"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
