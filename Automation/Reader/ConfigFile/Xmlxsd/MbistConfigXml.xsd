<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="MbistConfigXml"
    targetNamespace="http://tempuri.org/MbistConfigXml.xsd"
    elementFormDefault="qualified"
    xmlns="http://tempuri.org/MbistConfigXml.xsd"
    xmlns:mstns="http://tempuri.org/MbistConfigXml.xsd"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
>


  <xs:element name ="NamingBlock">
    <xs:complexType >
      <xs:sequence>
        <xs:element name="NamingItem" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name ="name" type="xs:string" use ="required"/>
            <xs:attribute name ="position" type="xs:string" use ="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name ="name" type="xs:string" use ="required"/>
    </xs:complexType>
  </xs:element>


  <xs:element name ="NamingRule">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref ="NamingBlock" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name ="Conditions">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Value" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name ="key" type="xs:string"/>
            <xs:attribute name ="position" type ="xs:string"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name ="name"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="RepaireFlag">
    <xs:complexType>
      <xs:sequence>
        <xs:element name ="FlagSettingBlock" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref ="Conditions" maxOccurs="unbounded">
              </xs:element>
            </xs:sequence>
            <xs:attribute name="name" type ="xs:string"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name ="name" type ="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name ="SpecialFlagSetting">
    <xs:complexType>
      <xs:sequence>
        <xs:element name ="Payload" type ="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
  <xs:element name ="MbistConfigXmlContent">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref ="NamingRule"/>
        <xs:element ref ="RepaireFlag"/>
        <xs:element ref ="SpecialFlagSetting"/>
        </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
