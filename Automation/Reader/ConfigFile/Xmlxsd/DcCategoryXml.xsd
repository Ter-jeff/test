<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="DcCategoryXml"
    targetNamespace="http://tempuri.org/DcCategoryXml.xsd"
    elementFormDefault="qualified"
    xmlns="http://tempuri.org/DcCategoryXml.xsd"
    xmlns:mstns="http://tempuri.org/DcCategoryXml.xsd"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
>

  <xs:element name ="SelectList">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="SelectListItem" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="name" type="xs:string"/>
              <xs:attribute name="data" type="xs:string"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="ProjectList">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ProjectItem" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="project" type="xs:string"/>
            <xs:attribute name ="data" type="xs:string"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
    
  <xs:element name ="DCCategorySetting">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref ="SelectList"/>
          <xs:element ref ="ProjectList"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
