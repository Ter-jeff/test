<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <ResultsDirectory>TestResults</ResultsDirectory>
  </RunConfiguration>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByAttribute>ExcludeFromCodeCoverage</ExcludeByAttribute>
          <!-- Add this line to exclude all auto-generated files -->
          <ExcludeByFile>**/System.Text.RegularExpressions.Generator/**/*.cs,**/*.g.cs</ExcludeByFile>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*TagDiff.Core.*</ModulePath>
              </Include>
            </ModulePaths>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
